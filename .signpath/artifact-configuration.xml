<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the editor preview (slug: editor-preview).
  Paste into the SignPath project once the Foundation application is approved.

  The artifact is the GitHub Actions artifact uploaded by .github/workflows/release.yml: a zip whose root is the
  staged editor folder. Three files in it are ours: Hyperion.Editor.exe (single-file publish), hyperion.dll
  (everything native linked in) and Hyperion.NET.Scripting.dll (loaded from disk by the engine). Everything else
  is already signed by Microsoft or Avalonia. See Documentation/CodeSigning.md.

  Parameter: version (passed by the workflow, e.g. 0.5.1). The signed files must carry ProductName
  "Hyperion Engine" and ProductVersion equal to it.

  Unverified until the first test-signing request: that files not matched below are ignored.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set product-name="Hyperion Engine" product-version="${version}">
      <include path="Hyperion.Editor.exe" />
      <include path="hyperion.dll" />
      <include path="Hyperion.NET.Scripting.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
