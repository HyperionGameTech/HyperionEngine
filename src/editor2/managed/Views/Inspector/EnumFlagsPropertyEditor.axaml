<UserControl
    x:Class="Hyperion.Editor.Views.Inspector.EnumFlagsPropertyEditor"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:DataType="vm:FlagsPropertyViewModel"
    mc:Ignorable="d">
    <ItemsControl ItemsSource="{Binding EnumFlagEntries}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <CheckBox
                    Margin="0,2,0,2"
                    Content="{Binding Name}"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
