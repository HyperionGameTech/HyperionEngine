<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
             x:Class="Hyperion.Editor.Views.Inspector.EnumPropertyEditor"
             x:DataType="vm:InspectorPropertyViewModel"
             mc:Ignorable="d">
        <ComboBox x:Name="EnumCombo"
                          ItemsSource="{Binding EnumValues}"
                          SelectedValue="{Binding SelectedEnumValue, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Value}"
                          VerticalAlignment="Center"
                          MinWidth="140"
                          HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                        <DataTemplate>
                                <TextBlock Text="{Binding Key}"/>
                        </DataTemplate>
                </ComboBox.ItemTemplate>
        </ComboBox>
</UserControl>
