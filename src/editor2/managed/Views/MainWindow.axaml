<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ribbon="clr-namespace:Ribbon.Avalonia;assembly=Ribbon.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        xmlns:local="clr-namespace:Hyperion.Editor"
        xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
        x:Class="Hyperion.Editor.MainWindow" Title="Hyperion Editor"
        x:DataType="vm:MainWindowViewModel">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <DockPanel Background="{DynamicResource Brush.Background}">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
            <MenuItem Header="_Open..."/>
            <Separator/>
            <MenuItem Header="_Exit"/>
            </MenuItem>
                <MenuItem Header="_Edit">
                <MenuItem Header="Copy"/>
                <MenuItem Header="Paste"/>
            </MenuItem>
        </Menu>
        <Border Classes="panel-header" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="accent" Content="New"/>
                    <Button Classes="accent" Content="Open"/>
                    <Button Classes="accent" Content="Save"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Classes="accent" Content="Play"/>
                    <Button Classes="accent" Content="Pause"/>
                    <Button Classes="accent" Content="Stop"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid RowDefinitions="Auto, Auto, *, Auto">
            <!-- Ribbon 
            <ribbon:Ribbon Grid.Row="1">
                <ribbon:RibbonTab Header="Home">
                    <ribbon:RibbonTab.Groups>
                        <ribbon:RibbonGroupBox Header="Scene">
                            <ribbon:RibbonButton Content="New" />
                            <ribbon:RibbonButton Content="Open" />
                            <ribbon:RibbonButton Content="Save" />
                        </ribbon:RibbonGroupBox>
                        <ribbon:RibbonGroupBox Header="Edit">
                            <ribbon:RibbonButton Content="Undo" />
                            <ribbon:RibbonButton Content="Redo" />
                        </ribbon:RibbonGroupBox>
                    </ribbon:RibbonTab.Groups>
                </ribbon:RibbonTab>
                <ribbon:RibbonTab Header="View">
                    <ribbon:RibbonTab.Groups>
                        <ribbon:RibbonGroupBox Header="Windows">
                            <ribbon:RibbonButton Content="Hierarchy" />
                            <ribbon:RibbonButton Content="Inspector" />
                            <ribbon:RibbonButton Content="Content Browser" />
                        </ribbon:RibbonGroupBox>
                    </ribbon:RibbonTab.Groups>
                </ribbon:RibbonTab>
            </ribbon:Ribbon> -->

            <!-- Main Content Area -->
            <Grid Grid.Row="2" ColumnDefinitions="280, 2, *">
            
                <!-- Left Panel: Scene Hierarchy + Inspector -->
                <Grid Grid.Column="0" RowDefinitions="*, 2, *">
                    <!-- Scene Hierarchy -->
                    <Grid Grid.Row="0" RowDefinitions="Auto, *">
                        <Border Classes="panel-header">
                            <TextBlock Classes="header" Text="Hierarchy"/>
                        </Border>
                        <TreeView Grid.Row="1" ItemsSource="{Binding SceneHierarchy.RootNodes}" SelectedItem="{Binding SceneHierarchy.SelectedNode}">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Name}"/>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>

                    <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

                    <!-- Inspector -->
                    <Grid Grid.Row="2" RowDefinitions="Auto, *">
                        <Border Classes="panel-header">
                            <TextBlock Classes="header" Text="Inspector"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Inspector.Properties}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InspectorPropertyViewModel">
                                        <Grid ColumnDefinitions="*, *" Margin="6,2">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <ContentControl Grid.Column="1" Content="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                <!-- Center Panel: Viewport & Content Browser -->
                <Grid Grid.Column="2" RowDefinitions="*, 2, 240">
                    <Border Grid.Row="0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <Grid>
                            <local:EditorViewportControl Name="EditorViewportControl" 
                                HorizontalAlignment="Stretch" 
                                VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

                    <!-- Bottom Panel: Content Browser / Console -->
                    <TabControl Grid.Row="2">
                        <TabItem Header="Content Browser">
                            <Grid ColumnDefinitions="220, *">
                                <TreeView Grid.Column="0">
                                </TreeView>
                                <ListBox Grid.Column="1">
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Console">
                            <ListBox>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Grid>

            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="3" Classes="status-bar">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Ready" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="FPS: 60" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="VRAM: 1.2 GB" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>