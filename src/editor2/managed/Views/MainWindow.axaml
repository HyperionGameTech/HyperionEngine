<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ribbon="clr-namespace:Ribbon.Avalonia;assembly=Ribbon.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        xmlns:local="clr-namespace:Hyperion.Editor"
        xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
        x:Class="Hyperion.Editor.MainWindow" Title="Hyperion Editor"
        x:DataType="vm:MainWindowViewModel">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>
    
    <DockPanel Background="{DynamicResource Brush.Background}">
        <!-- Fallback in-window menu for non-macOS platforms -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." Command="{Binding NewProject}"/>
                <MenuItem Header="_Open Project..." Command="{Binding OpenProject}"/>
                <MenuItem Header="_Save Project" Command="{Binding SaveProject}"/>
                <MenuItem Header="Save Project _As..."/>
                <Separator/>
                <MenuItem Header="_Exit" Command="{Binding Exit}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding Undo}"/>
                <MenuItem Header="_Redo" Command="{Binding Redo}"/>
                <Separator/>
                <MenuItem Header="_Copy" Command="{Binding Copy}"/>
                <MenuItem Header="_Paste" Command="{Binding Paste}"/>
                <Separator/>
                <MenuItem Header="Select _All"/>
                <MenuItem Header="Select All in Viewport"/>
                <MenuItem Header="Select None"/>
            </MenuItem>
        </Menu>
        
        <Border Classes="panel-header" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="accent" Content="Save"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Classes="accent" Content="Play"/>
                    <Button Classes="accent" Content="Pause"/>
                    <Button Classes="accent" Content="Stop"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid RowDefinitions="Auto, Auto, *, Auto">
            <!-- Main Content Area -->
            <Grid Grid.Row="2" ColumnDefinitions="280, 2, *">
            
                <!-- Left Panel: Scene Hierarchy + Inspector -->
                <Grid Grid.Column="0" RowDefinitions="*, 2, *">
                    <!-- Scene Hierarchy -->
                    <Grid Grid.Row="0" RowDefinitions="Auto, *">
                        <Border Classes="panel-header">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Classes="header" Text="Hierarchy" VerticalAlignment="Center" />
                                <Button Classes="accent" Content="Add" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="8,2">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Node" IsEnabled="False" FontSize="12" Foreground="#808080" Padding="8,4" Margin="0,2" HorizontalAlignment="Center" />
                                            <MenuItem Header="Entity" Command="{Binding AddEntity}"/>
                                            <MenuItem Header="Group" Command="{Binding AddEmptyNode}"/>
                                            <MenuItem Header="Camera" Command="{Binding AddCamera}"/>
                                            <Separator/>
                                            <MenuItem Header="Light" IsEnabled="False" FontSize="12" Foreground="#808080" Padding="8,4" Margin="0,2" HorizontalAlignment="Center"/>
                                            <MenuItem Header="Directional Light" Command="{Binding AddDirectionalLight}"/>
                                            <MenuItem Header="Point Light" Command="{Binding AddPointLight}"/>
                                            <MenuItem Header="Spot Light" Command="{Binding AddSpotLight}"/>
                                            <MenuItem Header="Rectangular Area Light" Command="{Binding AddAreaRectLight}"/>
                                            <Separator/>
                                            <MenuItem Header="Baking" IsEnabled="False" FontSize="12" Foreground="#808080" Padding="8,4" Margin="0,2" HorizontalAlignment="Center"/>
                                            <MenuItem Header="Reflection Probe" Command="{Binding AddReflectionProbe}"/>
                                            <MenuItem Header="Lightmap Volume" Command="{Binding AddLightmapVolume}"/>
                                            <Separator/>
                                            <MenuItem Header="FX" IsEnabled="False" FontSize="12" Foreground="#808080" Padding="8,4" Margin="0,2" HorizontalAlignment="Center"/>
                                            <MenuItem Header="Particle Volume" Command="{Binding AddParticleVolume}"/>
                                            <MenuItem Header="Fog Volume" Command="{Binding AddFogVolume}"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                        <TreeView Grid.Row="1" ItemsSource="{Binding SceneHierarchy.RootNodes}" SelectedItem="{Binding SceneHierarchy.SelectedNode}">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding DisplayName}" FontStyle="{Binding NameFontStyle}"/>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>

                    <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

                    <!-- Inspector -->
                    <Grid Grid.Row="2" RowDefinitions="Auto, *">
                        <Border Classes="panel-header">
                            <TextBlock Classes="header" Text="Inspector"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Inspector.Properties}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InspectorPropertyViewModel">
                                        <Grid ColumnDefinitions="Auto, *" Margin="6,2">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                <!-- Center Panel: Viewport & Content Browser -->
                <Grid Grid.Column="2" RowDefinitions="*, 2, 240">
                    <Border Grid.Row="0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <Grid>
                            <local:EditorViewportControl Name="EditorViewportControl" 
                                HorizontalAlignment="Stretch" 
                                VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

                    <!-- Bottom Panel: Content Browser / Console -->
                    <TabControl Grid.Row="2">
                        <TabItem Header="Content Browser">
                            <Grid ColumnDefinitions="220, *">
                                <TreeView Grid.Column="0">
                                </TreeView>
                                <ListBox Grid.Column="1">
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Console">
                            <local:ConsoleView />
                        </TabItem>
                    </TabControl>
                </Grid>

            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="3" Classes="status-bar">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Ready" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="FPS: 60" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="VRAM: 1.2 GB" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>