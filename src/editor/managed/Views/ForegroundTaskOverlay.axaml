<UserControl
    x:Class="Hyperion.Editor.Views.ForegroundTaskOverlay"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:ForegroundTaskViewModel"
    mc:Ignorable="d">

    <Grid IsVisible="{Binding IsVisible}" Opacity="{Binding Opacity}">
        <!-- overlay -->
        <!-- <Grid.Background>
            <SolidColorBrush Color="#88000000" />
        </Grid.Background> -->

        <Grid.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
            </Transitions>
        </Grid.Transitions>
        <StackPanel
            Panel.ZIndex="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="16,16,16,32"
            Spacing="12">
            <Border
                Width="360"
                Padding="16"
                Background="{DynamicResource Brush.PanelAlt}"
                BorderBrush="{DynamicResource Brush.BorderLight}"
                BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 10 30 #55000000">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Brush.Text}"
                            Text="{Binding Title}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <ProgressBar
                            Height="6"
                            Maximum="1.0"
                            Minimum="0"
                            Value="{Binding Progress}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            Text="{Binding Progress, StringFormat=Progress: {0:P0}}" />
                    </StackPanel>

                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"
                        Padding="12,6" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
