// Color
impl Color {
    extern float GetRed(Color self);
    extern void SetRed(Color self, float red);
    extern float GetGreen(Color self);
    extern void SetGreen(Color self, float green);
    extern float GetBlue(Color self);
    extern void SetBlue(Color self, float blue);
    extern float GetAlpha(Color self);
    extern void SetAlpha(Color self, float alpha);
    property float Red { get = Color_GetRed; set = Color_SetRed; }
    property float Green { get = Color_GetGreen; set = Color_SetGreen; }
    property float Blue { get = Color_GetBlue; set = Color_SetBlue; }
    property float Alpha { get = Color_GetAlpha; set = Color_SetAlpha; }
}
