    extern World GetWorld(UIObject self);
    extern void GetAABB(UIObject self, return BoundingBox outReturn);
    extern void GetAABBClamped(UIObject self, return BoundingBox outReturn);
    property bool IsPositionAbsolute { get = UIObject_IsPositionAbsolute; set = UIObject_SetIsPositionAbsolute; }
    property int Depth { get = UIObject_GetDepth; set = UIObject_SetDepth; }
    property bool AcceptsFocus { get = UIObject_AcceptsFocus; set = UIObject_SetAcceptsFocus; }
    property bool AffectsParentSize { get = UIObject_AffectsParentSize; set = UIObject_SetAffectsParentSize; }
    property uint BorderRadius { get = UIObject_GetBorderRadius; set = UIObject_SetBorderRadius; }
    property string Text { get = UIObject_GetText; set = UIObject_SetText; }
    property float TextSize { get = UIObject_GetTextSize; set = UIObject_SetTextSize; }
    property bool IsVisible { get = UIObject_IsVisible; set = UIObject_SetIsVisible; }
    property bool IsEnabled { get = UIObject_IsEnabled; set = UIObject_SetIsEnabled; }
}

