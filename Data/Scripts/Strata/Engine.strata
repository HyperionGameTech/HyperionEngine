    ORTHOGRAPHIC = 2
};
enum CameraFlags : uint
{
    None = 0x0,
    MatchWindowSize = 0x1,
    HasStreamingVolume = 0x2
};
enum FirstPersonCameraControllerMode : uint
{
    MOUSE_LOCKED = 0,
    MOUSE_FREE = 1
};
enum AnimationLoopMode : byte
{
    ONCE = 0,
    REPEAT
};
enum AnimationPlaybackStatus : byte
{
    STOPPED = 0,
    PAUSED,
    PLAYING
};
enum ScriptComponentFlags : uint
{
    NONE = 0x0,
    INITIALIZED = 0x1,
    RELOADING = 0x2,
    INITIALIZATION_STARTED = 0x4,
    ACTIVATED = 0x8
};
enum VisibilityStateFlags : uint
{
    NONE = 0x0,
    ALWAYS_VISIBLE = 0x1,
    INVALIDATED = 0x2
};
enum ScriptCompileStatus : byte
{
    Uninitialized = 0x0,
    Compiled = 0x1,
    Dirty = 0x2,
    Processing = 0x4,
    Errored = 0x8
};
enum ScriptLanguage : byte
{
    Invalid = UINT8_MAX,
    Native = 0,
    HypScript = 1,
    CSharp = 2,
    Strata = 3
};
enum StreamingCellState : uint
{
    INVALID = ~0u,
    UNLOADED = 0,
    UNLOADING,
    WAITING,
    LOADING,
    LOADED,
    MAX
};
enum StreamingVolumeShape : uint
{
    SPHERE = 0,
    BOX,
    MAX,
    INVALID = ~0u
};
enum WindowFlags : uint
{
    NONE = 0x0,
    HEADLESS = 0x1,
    NO_GFX = 0x2,
    HIGH_DPI = 0x4,
    EVENTS_POLLING = 0x8
};
enum UIListViewOrientation : byte
{
    VERTICAL = 0,
    HORIZONTAL
};
enum UIMenuBarDropDirection : uint
{
    DOWN,
    UP
};
enum UIObjectUpdateSizeFlags : uint
{
    NONE = 0x0,
    MAX_SIZE = 0x1,
    INNER_SIZE = 0x2,
    OUTER_SIZE = 0x4,
    DEFAULT = ((MAX_SIZE | INNER_SIZE) | OUTER_SIZE)
};
enum UIObjectAlignment : uint
{
    TOP_LEFT = 0,
    TOP_RIGHT = 1,
    CENTER = 2,
    BOTTOM_LEFT = 3,
    BOTTOM_RIGHT = 4
};
enum UIObjectBorderFlags : uint
{
    NONE = 0x0,
    TOP = 0x1,
    LEFT = 0x2,
    BOTTOM = 0x4,
    RIGHT = 0x8,
    ALL = (((TOP | LEFT) | BOTTOM) | RIGHT)
};
enum UIObjectUpdateType : uint
{
    NONE = 0x0,
    UPDATE_SIZE = 0x1,
    UPDATE_POSITION = 0x2,
    UPDATE_MATERIAL = 0x4,
    UPDATE_MESH_DATA = 0x8,
    UPDATE_COMPUTED_VISIBILITY = 0x10,
    UPDATE_CLAMPED_SIZE = 0x20,
    UPDATE_CUSTOM = 0x40,
    UPDATE_ALL = UINT16_MAX,
    UPDATE_CHILDREN_SIZE = (UPDATE_SIZE << 16),
    UPDATE_CHILDREN_POSITION = (UPDATE_POSITION << 16),
    UPDATE_CHILDREN_MATERIAL = (UPDATE_MATERIAL << 16),
    UPDATE_CHILDREN_MESH_DATA = (UPDATE_MESH_DATA << 16),
    UPDATE_CHILDREN_COMPUTED_VISIBILITY = (UPDATE_COMPUTED_VISIBILITY << 16),
    UPDATE_CHILDREN_CLAMPED_SIZE = (UPDATE_CLAMPED_SIZE << 16),
    UPDATE_CHILDREN_CUSTOM = (UPDATE_CUSTOM << 16),
    UPDATE_CHILDREN_ALL = (UPDATE_ALL << 16)
};
enum UIObjectFocusState : uint
{
    NONE = 0x0,
    HOVER = 0x1,
    PRESSED = 0x2,
    TOGGLED = 0x4,
    FOCUSED = 0x8
};
enum ScrollAxis : byte
{
    SA_NONE = 0x0,
    SA_HORIZONTAL = 0x1,
    SA_VERTICAL = 0x2,
    SA_ALL = (SA_HORIZONTAL | SA_VERTICAL)
};
