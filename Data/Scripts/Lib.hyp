extern struct Mat4f
    Determinant() -> float
    Transpose() -> Mat4f
    Inverse() -> Mat4f
    Orthonormalize() -> Mat4f
    Orthonormalized() -> Mat4f
    GetYaw() -> float
    GetPitch() -> float
    GetRoll() -> float
    operator*(other : Mat4f) -> Mat4f
    ExtractTranslation() -> Vec3f
    ExtractScale() -> Vec3f
    ExtractRotation() -> Quat4f
    GetColumn(index : uint32) -> Vec4f
    operator==(other : Mat4f) -> bool
    operator!=(other : Mat4f) -> bool
    static Zeros() -> Mat4f
    static Ones() -> Mat4f
    static Identity() -> Mat4f
end
extern struct Transform
    Translation : Vec3f
    Scale : Vec3f
    Rotation : Quat4f
    GetMatrix() -> Mat4f
    operator*(other : Transform) -> Transform
    operator==(other : Transform) -> bool
    operator!=(other : Transform) -> bool
end
extern struct Mat3f
    Determinant() -> float
    Transpose() -> Mat3f
    Inverse() -> Mat3f
    operator*(other : Mat3f) -> Mat3f
    operator==(other : Mat3f) -> bool
    operator!=(other : Mat3f) -> bool
    static Zeros() -> Mat3f
    static Ones() -> Mat3f
    static Identity() -> Mat3f
end
