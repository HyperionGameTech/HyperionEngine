import Lib::{Logger,LogChannel,LogLevel, EngineDriver};

Logger := Logger.MakeScriptLogger();
Channel := new LogChannel();

Fps : double = 0.0;
Accum : double = 0.0;
Counter : int = 0;

export func Update(DeltaTime : float)
{
    Accum += DeltaTime;
    Counter++;
    if (Accum >= 1.0)
    {
        Fps = (Counter as double) / Accum;
        Accum = 0.0;
        Counter = 0;
    }

    Logger.LogScript(Channel, LogLevel.Info, "fps: " + string(Fps)); //string(EngineDriver.GetInstance().GetDefaultWorld().GetGameState().GameTime));
};