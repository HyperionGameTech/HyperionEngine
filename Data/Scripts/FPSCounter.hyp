import Lib.{Logger,LogChannel,LogLevel, EngineDriver, Reflection, Debugger}

Logger := Logger.MakeScriptLogger()
Channel := new LogChannel()

f := 123.456

testfunc := (x : float)
    return func (y : float)
        x *= 2.0
        return x + y
    end
end


closure := testfunc(f)
Logger.LogScript(Channel, LogLevel.Info, "closure(10.0) = " + string(closure(10.0)))
Logger.LogScript(Channel, LogLevel.Info, "closure(10.0) = " + string(closure(10.0)))

// Debugger.Breakpoint()

Fps := 0.0
Accum := 0.0
Counter := 0

export Update := (DeltaTime : float)
    Accum += DeltaTime
    Counter++
    if (Accum >= 1.0)
        Fps = (Counter as double) / Accum
        Accum = 0.0
        Counter = 0

        Logger.LogScript(Channel, LogLevel.Info, "Frames per second: " + string(Fps))
    end
end
