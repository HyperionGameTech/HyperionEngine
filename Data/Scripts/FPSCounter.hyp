import Lib.{Logger,LogChannel,LogLevel, EngineDriver, Reflection, Debugger}

Logger := Logger.MakeScriptLogger()
Channel := new LogChannel()

f := 123.456

testfunc := (x : float)
    return func (y : float)
        x *= 2.0
        return x + y
    end
end


closure := testfunc(f)
Logger.LogScript(Channel, LogLevel.Info, "closure(10.0) = " + string(closure(10.0)))
Logger.LogScript(Channel, LogLevel.Info, "closure(10.0) = " + string(closure(10.0)))

// Debugger.Breakpoint()

Fps := 0.0
Accum := 0.0
Counter := 0

enum TestEnum
    Foo = 0,
    Bar,
    Baz,
    Fufufu
end

// Why does it break when using Baz or Fufufu
/// trace =
/// =====
/// [ERROR] unhandled exception in thread -1: Member with hash code 8922145923145611064 not found on type: `Hyperion::ClassRef`trace =
/// =====
eValue := TestEnum.Foo;

Logger.LogScript(Channel, LogLevel.Info, "eValue is " + string(eValue))

switch eValue
    case 0:
        Logger.LogScript(Channel, LogLevel.Info, "eValue is Foo")
        break
    case 1:
        Logger.LogScript(Channel, LogLevel.Info, "eValue is Bar")
        break
    default:
        Logger.LogScript(Channel, LogLevel.Info, "Default case")
        break
end

export Update := (DeltaTime : float)
    Accum += DeltaTime
    Counter++
    if (Accum >= 1.0)
        Fps = (Counter as double) / Accum
        Accum = 0.0
        Counter = 0

        Logger.LogScript(Channel, LogLevel.Info, "FPS: " + string(Fps))
    end
end
