extension class string {
    operator+(other: string) -> string {
        return "blah test"
    }
}

// Function definitions and expressions

// Simple function with explicit types
add := (a: int32, b: int32) -> int32 {
    return a + b
}

// Function with implicit return type
multiply := (x: float, y: float) {
    return x * y
}

// Function with default parameters
greet := (name: string = "World", prefix: string = "Hello") -> string {
    return prefix + ", " + name + "!"
}

// Lambda function (function expression)
square := (n: int32) { return n * n }

// Higher-order function
applyToArray := (arr: Array<int32>, func: (int32) -> int32) -> Array<int32> {
    result : Array<int32> = []
    for (i := 0; i < arr.Length(); i++) {
        result.Add(func(arr[i]))
    }
    return result
}

// Using the functions
sum := add(5, 3)
product := multiply(2.5, 4.0)
greeting := greet("Hyperion")
defaultGreeting := greet()

numbers : Array<int32> = [1, 2, 3, 4]
squared := applyToArray(numbers, square)

export x := sum
