// Control flow structures

// If-else statements
checkNumber := (n: int32) -> string {
    if (n > 0) {
        return "Positive"
    } else if (n < 0) {
        return "Negative"
    } else {
        return "Zero"
    }
}

// For loops
sumNumbers := (max: int32) -> int32 {
    total := 0
    for (i := 1; i <= max; i++) {
        total += i
    }
    return total
}

// For loop with array
processArray := (arr: Array<int32>) {
    for (i := 0; i < arr.Length(); i++) {
        if (arr[i] % 2 == 0) {
            arr[i] = arr[i] * 2  // Double even numbers
        } else {
            arr[i] = arr[i] + 1  // Increment odd numbers
        }
    }
}

// While loop
factorial := (n: int32) -> int32 {
    if (n <= 1) {
        return 1
    }
    
    result := 1
    current := n
    while (current > 1) {
        result *= current
        current--
    }
    return result
}

// Nested loops
multiplicationTable := (size: int32) {
    for (i := 1; i <= size; i++) {
        row := ""
        for (j := 1; j <= size; j++) {
            product := i * j
            row += product + "\t"
        }
        // In a real implementation, this would print the row
    }
}

// Using the functions
numbers : Array<int32> = [1, 2, 3, 4, 5, 6]
processArray(numbers)

result1 := checkNumber(-5)
result2 := sumNumbers(10)
result3 := factorial(5)

export result := result2
