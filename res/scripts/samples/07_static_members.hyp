// Static members and class-level functionality

class MathUtils {
    static PI: float = 3.14159
    static E: float = 2.71828
    
    // Static methods
    static max(a: float, b: float) -> float {
        if (a > b) {
            return a
        }
        return b
    }
    
    static min(a: float, b: float) -> float {
        if (a < b) {
            return a
        }
        return b
    }
    
    static clamp(value: float, minVal: float, maxVal: float) -> float {
        return min(max(value, minVal), maxVal)
    }
    
    static degToRad(degrees: float) -> float {
        return degrees * (PI / 180.0)
    }
}

class Counter {
    static totalInstances: int32 = 0
    
    value: int32 = 0
    id: int32
    
    Counter() {
        Counter.totalInstances++
        id = Counter.totalInstances
        return self
    }
    
    increment() {
        value++
    }
    
    decrement() {
        value--
    }
    
    static getTotalInstances() -> int32 {
        return totalInstances
    }
    
    static resetCounter() {
        totalInstances = 0
    }
}

// Using static members
maxValue := MathUtils.max(10.5, 7.2)
minValue := MathUtils.min(10.5, 7.2)
clampedValue := MathUtils.clamp(150.0, 0.0, 100.0)
radians := MathUtils.degToRad(90.0)

// Using static variables
piValue := MathUtils.PI
eValue := MathUtils.E

// Creating instances to test static counter
counter1 := new Counter()
counter2 := new Counter()
counter3 := new Counter()

counter1.increment()
counter2.increment()
counter2.increment()

totalCounters := Counter.getTotalInstances()

export result := totalCounters
