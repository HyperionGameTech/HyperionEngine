// Advanced array operations and data structures

// Array manipulation functions
findMax := (arr: Array<int32>) -> int32 {
    if (arr.Length() == 0) {
        return 0
    }
    
    maxVal := arr[0]
    for (i := 1; i < arr.Length(); i++) {
        if (arr[i] > maxVal) {
            maxVal = arr[i]
        }
    }
    return maxVal
}

filter := (arr: Array<int32>, predicate: (int32) -> bool) -> Array<int32> {
    result : Array<int32> = []
    for (i := 0; i < arr.Length(); i++) {
        if (predicate(arr[i])) {
            result.Add(arr[i])
        }
    }
    return result
}

map := (arr: Array<int32>, transform: (int32) -> int32) -> Array<int32> {
    result : Array<int32> = []
    for (i := 0; i < arr.Length(); i++) {
        result.Add(transform(arr[i]))
    }
    return result
}

reduce := (arr: Array<int32>, accumulator: (int32, int32) -> int32, initial: int32) -> int32 {
    result := initial
    for (i := 0; i < arr.Length(); i++) {
        result = accumulator(result, arr[i])
    }
    return result
}

// Predicate functions
isEven := (n: int32) -> bool {
    return n % 2 == 0
}

isPositive := (n: int32) -> bool {
    return n > 0
}

// Transform functions
double := (n: int32) -> int32 {
    return n * 2
}

square := (n: int32) -> int32 {
    return n * n
}

// Accumulator functions
add := (a: int32, b: int32) -> int32 {
    return a + b
}

multiply := (a: int32, b: int32) -> int32 {
    return a * b
}

// Using array operations
numbers : Array<int32> = [1, -2, 3, -4, 5, 6, -7, 8]

maxNumber := findMax(numbers)
evenNumbers := filter(numbers, isEven)
positiveNumbers := filter(numbers, isPositive)
doubledNumbers := map(numbers, double)
squaredNumbers := map(numbers, square)
sum := reduce(numbers, add, 0)
product := reduce(positiveNumbers, multiply, 1)

// Chaining operations
processedNumbers := map(filter(numbers, isPositive), square)

// Multi-dimensional arrays
matrix : Array<Array<int32>> = [
    [1, 2, 3],
    [4, 5, 6], 
    [7, 8, 9]
]

// Access matrix elements
centerElement := matrix[1][1]
matrix[0][0] = 10

export result := sum
