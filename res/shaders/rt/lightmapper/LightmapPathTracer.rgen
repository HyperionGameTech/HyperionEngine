layout(location = 0) rayPayloadEXT RayPayload payload;

HYP_DESCRIPTOR_BUFFER(LightmapPathTracer, HitsBuffer, standard = scalar) buffer HitsBuffer
{
    vec4 hits[];
};

HYP_DESCRIPTOR_BUFFER(LightmapPathTracer, Lights) uniform Lights
{
    Light lights[MAX_LIGHTS];
};

struct LightmapRay
{
    vec3 origin;
    vec3 direction;
};

HYP_DESCRIPTOR_BUFFER(LightmapPathTracer, RaysBuffer, standard = scalar) readonly buffer RaysBuffer
{
    vec4 ray_data[];
};

HYP_DESCRIPTOR_BUFFER(LightmapPathTracer, RayTracingConstants) uniform RayTracingCBuffer
{
    RayTracingConstants rayTracingConstants;
};

#ifdef MODE_IRRADIANCE

#define RAY_OFFSET 0.005
#define NUM_BOUNCES 8
#define NUM_SAMPLES 1
#elif defined(MODE_FULL)
#define RAY_OFFSET 0.005
#define NUM_BOUNCES 8
#define NUM_SAMPLES 1
#else
#define RAY_OFFSET 0.01
#define NUM_BOUNCES 1
#define NUM_SAMPLES 1
#endif

// Firefly mitigation helpers (MODE_FULL)
#ifdef MODE_FULL
#define MAX_SAMPLE_LUMINANCE 20.0
#define MAX_THROUGHPUT_LUMINANCE 10.0
#define ROUGHNESS_FLOOR 0.05

vec3 ClampLuminance(in vec3 c, float max_lum)
{
    float lum = Luminance(c);
    if (lum > max_lum)
    {
        return c * (max_lum / max(lum, 1e-6));
    }
    return c;
}
#endif

// This function is used to debug the albedo color by tracing a ray onto the surface
// and returning the albedo color at that point.
vec3 DebugTest_Albedo(in vec3 position, in vec3 normal)
{
    // Save payload state
    vec4 saved_throughput = payload.throughput;
    vec4 saved_emissive = payload.emissive;
    float saved_distance = payload.distance;
    vec3 saved_normal = payload.normal;
    vec3 saved_bary = payload.barycentric_coords;

    // Set up ray to hit the surface from a small offset
    vec3 origin = position + normal * 0.001;
    vec3 direction = -normal;

    // Reset payload for this trace
    payload.distance = -1.0;
    payload.throughput = vec4(0.0);
    payload.emissive = vec4(0.0);
    payload.normal = vec3(0.0);

    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0, origin, 0.0, direction, 1.0, 0);

    vec3 albedo = vec3(0.0);
    if (payload.distance >= 0.0)
    {
        albedo = payload.throughput.rgb;
    }

    // Restore payload
    payload.throughput = saved_throughput;
    payload.emissive = saved_emissive;
    payload.distance = saved_distance;
    payload.normal = saved_normal;
    payload.barycentric_coords = saved_bary;

    return albedo;
}

float CheckInShadow(vec3 position, vec3 normal, vec3 lightDir)
{
    vec3 origin = position + normal * 0.01;
    vec3 direction = lightDir;

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
        0xff, origin, 0.0001, direction, 1000.0);

    rayQueryProceedEXT(rq);

    return float(rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT);
}

// Distance-limited version for finite lights (e.g., point/spot)
float CheckInShadowDistance(vec3 position, vec3 normal, vec3 lightDir, float maxDist)
{
    vec3 origin = position + normal * 0.01;
    vec3 direction = lightDir;

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
        0xff, origin, 0.0001, direction, max(0.0, maxDist));

    rayQueryProceedEXT(rq);

    return float(rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT);
}

vec3 radiance = vec3(0.0);
vec3 beta = vec3(1.0);

void main()
{
    const uint ray_index = gl_LaunchIDEXT.x;

    LightmapRay ray;
    ray.origin = ray_data[ray_index * 2].xyz;
    ray.direction = ray_data[ray_index * 2 + 1].xyz;

    const uint flags = gl_RayFlagsOpaqueEXT;
    const uint mask = 0xff;
    const float tmin = 0.01;
    const float tmax = 1000.0;

    const vec3 N0 = normalize(ray.direction);

    vec3 tangent;
    vec3 bitangent;

    uint ray_seed = InitRandomSeed(((rayTracingConstants.ray_offset + ray_index) * 2), ((rayTracingConstants.ray_offset + ray_index) * 2) + 1);

#ifdef MODE_IRRADIANCE
    vec4 accumRadiance = vec4(0.0);

    for (uint sample_index = 0; sample_index < NUM_SAMPLES; sample_index++)
    {
        vec2 rnd = vec2(RandomFloat(ray_seed), RandomFloat(ray_seed));

        vec3 direction = SampleCosineDir(rnd, N0);
        direction = normalize(direction);

        vec3 origin = ray.origin + N0 * RAY_OFFSET;

        vec3 radiance = vec3(0.0);
        vec3 beta = vec3(1.0);

        for (int bounceIndex = 0; bounceIndex < NUM_BOUNCES; ++bounceIndex)
        {
            // perform scene trace using global payload
            payload.distance = -1.0;
            payload.throughput = vec4(1.0);
            payload.emissive = vec4(0.0);
            payload.normal = vec3(0.0);

            traceRayEXT(tlas, flags, mask, 0, 0, 0, origin, tmin, direction, tmax, 0);

            if (payload.distance < 0.0)
            {
                // miss -> sample environment probe if present
                if (current_env_probe.texture_index != ~0u)
                {
                    vec3 env = EnvProbeSample(sampler_linear, envProbesTexture, current_env_probe.texture_index, direction, 0.0).rgb;
                    radiance += beta * env;
                }
                break;
            }

            vec3 albedo = clamp(payload.throughput.rgb, vec3(0.0), vec3(1.0));
            float metalness = payload.throughput.a;

            vec3 hitPos = origin + direction * payload.distance;
            vec3 N = normalize(payload.normal);

            // emissive
            if (length(payload.emissive.rgb) > 0.0)
            {
                radiance += beta * payload.emissive.rgb;
            }

            beta *= albedo * (1.0 - metalness) * HYP_FMATH_ONE_OVER_PI;

            for (uint light_index = 0; light_index < rayTracingConstants.num_bound_lights; light_index++)
            {
                const Light light = lights[light_index];
                vec3 light_color = light.color.rgb * light.position_intensity.w;

                if (light.type == HYP_LIGHT_TYPE_DIRECTIONAL)
                {
                    vec3 light_direction = normalize(light.position_intensity.xyz);
                    vec3 L = light_direction;

                    // shadow check
                    float shadow = 1.0 - CheckInShadow(hitPos, N, L);

                    float NdotL = max(dot(N, L), 0.0);
                    radiance += beta * NdotL * shadow * light_color;
                }
                else if (light.type == HYP_LIGHT_TYPE_POINT)
                {
                    vec3 L = normalize(light.position_intensity.xyz - hitPos);
                    float d = length(light.position_intensity.xyz - hitPos);
                    float attenuation = 1.0 / (d * d);

                    float NdotL = max(dot(N, L), 0.0);
                    radiance += beta * NdotL * light_color * attenuation;
                }
                else
                {
                    /// ... TODO
                }
            }

            if (bounceIndex >= 3)
            {
                float p = clamp(max(max(beta.r, beta.g), beta.b), 0.05, 0.99);
                if (RandomFloat(ray_seed) > p)
                {
                    break;
                }
                beta /= vec3(p);
            }

            rnd = vec2(RandomFloat(ray_seed), RandomFloat(ray_seed));

            direction = normalize(SampleCosineDir(rnd, N));
            origin = hitPos + N * RAY_OFFSET;
        } // end bounces

        accumRadiance.rgb += radiance;
    } // end samples

    vec3 finalColor = accumRadiance.rgb / float(NUM_SAMPLES);
#elif defined(MODE_RADIANCE)
    // direct shading

    const vec3 N = N0;

    vec3 radiance = vec3(0.0);

    for (uint light_index = 0; light_index < rayTracingConstants.num_bound_lights; light_index++)
    {
        if (lights[light_index].type == HYP_LIGHT_TYPE_DIRECTIONAL)
        {
            vec3 light_direction = normalize(lights[light_index].position_intensity.xyz);
            vec3 L = light_direction;

            // shadow check
            float shadow = 1.0 - CheckInShadow(ray.origin, N, L);

            float NdotL = max(dot(N, L), 0.0);
            radiance += lights[light_index].color.rgb * lights[light_index].position_intensity.w * NdotL * shadow;
        }
        else if (lights[light_index].type == HYP_LIGHT_TYPE_POINT)
        {
            vec3 L = normalize(lights[light_index].position_intensity.xyz - ray.origin);
            float d = length(lights[light_index].position_intensity.xyz - ray.origin);
            float attenuation = 1.0 / (d * d);

            float NdotL = max(dot(N, L), 0.0);
            radiance += lights[light_index].color.rgb * lights[light_index].position_intensity.w * NdotL * attenuation;
        }
        else
        {
            /// ... TODO
        }
    }

    vec3 finalColor = radiance;
#elif defined(MODE_FULL)
    // full path tracing with diffuse/specular bounces
    vec4 accumRadiance = vec4(0.0);

    for (uint sample_index = 0; sample_index < NUM_SAMPLES; sample_index++)
    {
        vec2 rnd0 = vec2(RandomFloat(ray_seed), RandomFloat(ray_seed));

        // Use incoming view ray for the first segment (viewport tracing)
        vec3 direction = N0;
        vec3 origin = ray.origin + N0 * RAY_OFFSET;

        vec3 Li = vec3(0.0);
        vec3 beta = vec3(1.0);

        for (int bounceIndex = 0; bounceIndex < NUM_BOUNCES; ++bounceIndex)
        {
            // prepare payload and trace
            payload.distance = -1.0;
            payload.throughput = vec4(1.0);
            payload.emissive = vec4(0.0);
            payload.normal = vec3(0.0);

            traceRayEXT(tlas, flags, mask, 0, 0, 0, origin, tmin, direction, tmax, 0);

            // environment if miss
            if (payload.distance < 0.0)
            {
                if (current_env_probe.texture_index != ~0u)
                {
                    vec3 env = EnvProbeSample(sampler_linear, envProbesTexture, current_env_probe.texture_index, direction, 0.0).rgb;
                    Li += beta * env;
                }
                break;
            }

            // hit data
            vec3 hitPos = origin + direction * payload.distance;
            vec3 N = normalize(payload.normal);
            vec3 baseColor = clamp(payload.throughput.rgb, vec3(0.0), vec3(1.0));
            float metalness = clamp(payload.throughput.a, 0.0, 1.0);
            float roughness = clamp(payload.roughness, ROUGHNESS_FLOOR, 1.0);

            // emissive contribution
            if (any(greaterThan(payload.emissive.rgb, vec3(0.0))))
            {
                Li += beta * payload.emissive.rgb;
            }

            // Direct lighting (next event estimation): Lambertian + GGX specular
            vec3 diffuseColor = baseColor * (1.0 - metalness);
            vec3 V = normalize(-direction);
            float NdotV = max(dot(N, V), 0.0);
            vec3 F0 = mix(vec3(0.04), baseColor, metalness);
            if (dot(diffuseColor, diffuseColor) > 0.0)
            {
                for (uint light_index = 0; light_index < rayTracingConstants.num_bound_lights; light_index++)
                {
                    const Light light = lights[light_index];

                    if (light.type == HYP_LIGHT_TYPE_DIRECTIONAL)
                    {
                        vec3 L = normalize(light.position_intensity.xyz);
                        float visibility = 1.0 - CheckInShadow(hitPos, N, L);
                        float NdotL = max(dot(N, L), 0.0);
                        if (NdotL > 0.0 && visibility > 0.0)
                        {
                            vec3 light_color = light.color.rgb * light.position_intensity.w;
                            // Diffuse
                            vec3 Lo_d = diffuseColor * (NdotL * HYP_FMATH_ONE_OVER_PI);
                            // Specular GGX
                            vec3 H = normalize(V + L);
                            float NdotH = max(dot(N, H), 0.0);
                            float HdotV = max(dot(H, V), 0.0);
                            float D = DistributionGGX(NdotH, roughness);
                            float G = G_Smith(NdotV, NdotL, roughness);
                            vec3 F = F_Schlick(F0, HdotV);
                            vec3 Lo_s = (D * G) * F / max(4.0 * NdotL * NdotV, 1e-6);
                            Li += beta * (Lo_d + Lo_s * NdotL) * light_color * visibility;
                        }
                    }
                    else if (light.type == HYP_LIGHT_TYPE_POINT)
                    {
                        vec3 toLight = light.position_intensity.xyz - hitPos;
                        float d2 = max(dot(toLight, toLight), 1e-6);
                        float d = sqrt(d2);
                        vec3 L = toLight / d;
                        float visibility = 1.0 - CheckInShadowDistance(hitPos, N, L, max(0.0, d - RAY_OFFSET));
                        float NdotL = max(dot(N, L), 0.0);
                        if (NdotL > 0.0 && visibility > 0.0)
                        {
                            vec3 light_color = light.color.rgb * light.position_intensity.w;
                            float attenuation = 1.0 / d2;
                            // Diffuse
                            vec3 Lo_d = diffuseColor * (NdotL * HYP_FMATH_ONE_OVER_PI);
                            // Specular GGX
                            vec3 H = normalize(V + L);
                            float NdotH = max(dot(N, H), 0.0);
                            float HdotV = max(dot(H, V), 0.0);
                            float D = DistributionGGX(NdotH, roughness);
                            float G = G_Smith(NdotV, NdotL, roughness);
                            vec3 F = F_Schlick(F0, HdotV);
                            vec3 Lo_s = (D * G) * F / max(4.0 * NdotL * NdotV, 1e-6);
                            Li += beta * (Lo_d + Lo_s * NdotL) * light_color * attenuation * visibility;
                        }
                    }
                    else
                    {
                        // TODO: area/spotlights
                    }
                }
            }

            // Russian roulette
            if (bounceIndex >= 3)
            {
                float p = clamp(max(max(beta.r, beta.g), beta.b), 0.05, 0.99);
                if (RandomFloat(ray_seed) > p)
                {
                    break;
                }
                beta /= vec3(p);
            }

            // Sample next direction: mixture of diffuse (cosine) and GGX specular
            float Fv = max(max(F_Schlick(F0, NdotV).r, F_Schlick(F0, NdotV).g), F_Schlick(F0, NdotV).b);
            float specProb = clamp(mix(0.2, 1.0, metalness) * Fv, 0.02, 0.98);
            float diffProb = 1.0 - specProb;

            vec2 rnd = vec2(RandomFloat(ray_seed), RandomFloat(ray_seed));
            float choose = RandomFloat(ray_seed);
            vec3 wi;

            if (choose < specProb)
            {
                // Specular GGX sample
                vec3 H = SampleGGX(rnd, roughness, N);
                wi = normalize(reflect(-V, H));
                float NdotL = max(dot(N, wi), 0.0);
                if (NdotL <= 0.0)
                {
                    break;
                }
                float NdotH = max(dot(N, H), 0.0);
                float HdotV = max(dot(H, V), 0.0);
                float G = G_Smith(NdotV, NdotL, roughness);
                vec3 F = F_Schlick(F0, HdotV);
                float pdf_spec = max(GGX_PDF(NdotH, HdotV, roughness), 1e-6);
                vec3 weight = (F * G) * (HdotV / max(NdotV * NdotH, 1e-6));
                beta *= weight / specProb;
            }
            else
            {
                // Diffuse cosine-weighted sample
                wi = normalize(SampleCosineDir(rnd, N));
                beta *= diffuseColor / max(diffProb, 1e-6);
            }

            origin = hitPos + N * RAY_OFFSET;
            direction = wi;
        }

        accumRadiance.rgb += Li;
    }

    vec3 finalColor = accumRadiance.rgb / float(NUM_SAMPLES);

#else
    vec3 finalColor = vec3(0.0);
#endif

    hits[ray_index] = vec4(finalColor, 1.0);
}
