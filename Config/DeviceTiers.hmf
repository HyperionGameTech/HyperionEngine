TierProfile "DeviceTiers" {
    Rules = [
        TierRule "Glimmer.High" {
            AtMost = { DeviceGrade = High }
            Set = {
                "Rendering.Glimmer.Probes.NearField.Cascades" = 3
                "Rendering.Glimmer.Probes.RaysPerFrame" = 32768
                "Rendering.Glimmer.Probes.PoolBlocks" = 768
            }
        }
        TierRule "Glimmer.Medium" {
            AtMost = { DeviceGrade = Medium }
            Set = {
                "Rendering.Glimmer.Probes.NearField.Cascades" = 2
                "Rendering.Glimmer.Probes.RaysPerFrame" = 16384
                "Rendering.Glimmer.Probes.PoolBlocks" = 192
                "Rendering.Glimmer.Spans.Radius" = 192
                "Rendering.Glimmer.Probes.Enabled" = false
                
                "Rendering.Glimmer.Bricks.Reflections" = false
            }
        }
        TierRule "Glimmer.BrickPool" {
            AtMost = { DeviceGrade = Ultra }
            Set = {
                "Rendering.Glimmer.Bricks.InitialPoolMB" = 256
            }
        }
        TierRule "Glimmer.BrickPool.Medium" {
            AtMost = { DeviceGrade = Medium }
            Set = {
                "Rendering.Glimmer.Bricks.PoolBudgetMB" = 128
                "Rendering.Glimmer.Bricks.InitialPoolMB" = 128
            }
        }
        TierRule "Glimmer.BrickPool.Web" {
            When = { DevicePlatform = Web }
            Set = {
                "Rendering.Glimmer.Bricks.PoolBudgetMB" = 128
                "Rendering.Glimmer.Bricks.InitialPoolMB" = 96
            }
        }
        TierRule "Glimmer.Web" {
            When = { DevicePlatform = Web }
            Set = {
                "Rendering.Glimmer.Probes.Enabled" = false
                "Rendering.Glimmer.Bricks.Reflections" = false
            }
        }
        TierRule "Glimmer.LaptopUltraCap" {
            When = { DeviceType = Laptop, DeviceGrade = Ultra }
            Set = {
                "Rendering.Glimmer.Probes.RaysPerFrame" = 32768
            }
        }

        TierRule "VolumetricFog.Medium" {
            AtMost = { DeviceGrade = Medium }
            Set = {
                "Rendering.VolumetricFog.GridPixelSize" = 16
                "Rendering.VolumetricFog.GridSlices" = 64
                "Rendering.VolumetricFog.MultiScatterOctaves" = 2
            }
        }
        TierRule "VolumetricFog.Web" {
            When = { DevicePlatform = Web }
            Set = {
                "Rendering.VolumetricFog.GridPixelSize" = 16
                "Rendering.VolumetricFog.GridSlices" = 64
                "Rendering.VolumetricFog.MultiScatterOctaves" = 2
            }
        }

        TierRule "Mobile" {
            When = { DeviceType = Mobile }
            Set = {
                "Rendering.Glimmer.Enabled" = false
                "Rendering.SSR" = false
                "Rendering.GTAO" = false
                "Rendering.Clouds" = false
                "Rendering.FogVolumes" = false
                "Rendering.VolumetricFog" = false
                "Rendering.Shadows.CSMMaxDistance" = 200
                "Rendering.Shadows.CSMMaxStaleFrames" = 16
                "Rendering.Shadows.Enabled" = false
                "Rendering.Bloom" = false
                "Rendering.DepthPrepass" = false
                "Rendering.IndirectRendering" = false
                "Rendering.ParallelRendering" = false
                "Rendering.SkyVisibility.Enabled" = false
                "Rendering.MeshLod.GlobalBias" = 1
                "Rendering.Mobile.RenderScale" = 0.5
            }
        }

        TierRule "LaptopLow" {
            When = { DeviceType = Laptop }
            AtMost = { DeviceGrade = Low }
            Set = {
                "Editor.SkipRenderingWhenIdle" = -1

                "Rendering.LimitFrameRateWhenIdle" = true
                "Rendering.LimitFrameRateOnBatteryPower" = true
            }
        }
    ]
}
