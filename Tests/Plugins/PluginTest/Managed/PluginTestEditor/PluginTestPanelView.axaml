<UserControl
    x:Class="Hyperion.PluginTest.Editor.PluginTestPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Hyperion.PluginTest.Editor;assembly=Hyperion.Editor"
    x:DataType="vm:PluginTestPanelViewModel">
    <StackPanel Margin="12" Spacing="6">
        <TextBlock Classes="section-label" Text="Enabled Plugins" />
        <TextBlock Text="{Binding EnabledPlugins}" />
        <TextBlock Classes="section-label" Text="PluginTestSystem Ticks" />
        <TextBlock Text="{Binding TotalTicks}" />
    </StackPanel>
</UserControl>
