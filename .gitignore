
*.DS_Store
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

cmake-build-debug/**/*
cmake-build-release/**/*

# Visual C++ cache files
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!*.[Cc]ache/

# CMake generated files
CMakeFiles/**/*

# VS Code
.vscode/**/*

# JetBrains Rider
**/.idea/**/*

.cache/**/*

**/*.pyc

*/.vs/**/*

*/out/**/*

# java heap dump files
*.hprof

local.properties

# download bin or compile it, and place here manually (since it's not a direct dependency of the engine, but only used for debugging)
# and the file is quite large.
External/ThirdParty/Binaries/Android/**/libVkLayer_khronos_validation.so

Source/PlatformSpecific/Android/app/.cxx/**/*
Source/PlatformSpecific/Android/app/**/jniLibs/**/*
Source/PlatformSpecific/Android/app/**/assets/**/*

Source/Generated/**/*

Packages/SampleGame/**/*

Data/Models/Testbed/**/*
Data/Models/Sponza/**/*
Data/Models/NewSponza/**/*
Data/Models/lostempire/**/*
Data/Models/SponzaGltf/**/*

Binaries/**/*

Build/**/*

Projects/**/*

