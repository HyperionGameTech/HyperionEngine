1 VERSIONINFO
FILEVERSION @HYP_VERSION_MAJOR@,@HYP_VERSION_MINOR@,@HYP_VERSION_PATCH@,0
PRODUCTVERSION @HYP_VERSION_MAJOR@,@HYP_VERSION_MINOR@,@HYP_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Hyperion Engine"
            VALUE "FileVersion", "@HYP_VERSION_MAJOR@.@HYP_VERSION_MINOR@.@HYP_VERSION_PATCH@"
            VALUE "InternalName", "hyperion"
            VALUE "OriginalFilename", "hyperion.dll"
            VALUE "ProductName", "Hyperion Engine"
            VALUE "ProductVersion", "@HYP_VERSION_MAJOR@.@HYP_VERSION_MINOR@.@HYP_VERSION_PATCH@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
