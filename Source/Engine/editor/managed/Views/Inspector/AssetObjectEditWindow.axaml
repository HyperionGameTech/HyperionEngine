<Window
    x:Class="Hyperion.Editor.Views.Inspector.AssetObjectEditWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inspector="clr-namespace:Hyperion.Editor.Views.Inspector;assembly=Hyperion.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    Width="420"
    MaxHeight="640"
    SizeToContent="Height"
    x:DataType="vm:ComponentSubObjectViewModel"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <DockPanel>
        <Border
            DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0"
            Padding="12,8">
            <Button
                HorizontalAlignment="Right"
                Padding="20,6"
                Click="OnClose"
                Content="Close" />
        </Border>

        <ScrollViewer Padding="4,0">
            <StackPanel Margin="0,12,0,8" Spacing="0">
                <TextBlock
                    x:Name="PART_Heading"
                    Margin="8,0,8,2"
                    FontSize="14"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="PART_SubHeading"
                    Margin="8,0,8,10"
                    FontSize="11"
                    Opacity="0.55"
                    TextTrimming="CharacterEllipsis" />

                <inspector:InspectorPropertyItemsControl
                    IsVisible="{Binding HasProperties}"
                    ItemsSource="{Binding Properties}" />

                <TextBlock
                    IsVisible="{Binding !HasProperties}"
                    Margin="8,4"
                    Opacity="0.5"
                    Text="No editable properties." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>