rule RERUN_CMAKE
  command = "C:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe" --regenerate-during-build -SC:\Users\andre\hyperion-engine\Source -BC:\Users\andre\hyperion-engine\Source\out\build\x64-release
  description = Re-running CMake...
