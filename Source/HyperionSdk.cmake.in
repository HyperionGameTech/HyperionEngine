set(HYPERION_SDK_VERSION "@HYP_VERSION_MAJOR@.@HYP_VERSION_MINOR@.@HYP_VERSION_PATCH@")
set(HYPERION_SDK_COMPILER "@HYP_SDK_COMPILER@")
set(HYPERION_SDK_THIRD_PARTY_DIRS "@HYP_SDK_THIRD_PARTY_SUBDIRS@")
set(HYPERION_SDK_RUNTIME_LIBRARIES "")
set(HYPERION_SDK_SHADER_COMPILER_LIBRARIES "@HYP_SDK_SHADER_COMPILER_LIBRARIES@")

# a shipping SDK (Sdk/Shipping of an editor install) holds the static HYP_SHIPPING engine, which is linked into the game's executable
set(HYPERION_SDK_SHIPPING @HYP_SDK_SHIPPING@)
set(HYPERION_SDK_LINK_OPTIONS "@HYP_SDK_LINK_OPTIONS@")

set(HYPERION_PACKAGE OFF CACHE BOOL "Build for a specific package")

# Package Game links the shipping engine; the editor's SDK has the editor's engine, which isn't meant to be redistributed
if(HYPERION_PACKAGE AND NOT HYPERION_SDK_SHIPPING)
  message(FATAL_ERROR "HYPERION_PACKAGE needs a shipping SDK (Sdk/Shipping of an editor install), but ${CMAKE_CURRENT_LIST_DIR} is the editor's SDK")
endif()

# the game module is loaded by the game's executable and the editor, or built into the executable along with a static engine
if(HYPERION_SDK_SHIPPING)
  set(HYPERION_GAME_MODULE_TYPE OBJECT)
else()
  set(HYPERION_GAME_MODULE_TYPE SHARED)
endif()

# runtime layout, link flags and script linking for the platform the engine was built for
include("${CMAKE_CURRENT_LIST_DIR}/HyperionSdkPlatform.cmake")

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../RuntimeLibraries.txt")
  file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../RuntimeLibraries.txt" HYPERION_SDK_RUNTIME_LIBRARIES)
endif()

# only present next to an engine build tree; a packaged SDK uses the layout below
include("${CMAKE_CURRENT_LIST_DIR}/HyperionSdkDevPaths.cmake" OPTIONAL)

if(NOT DEFINED HYPERION_SDK_INCLUDE_DIRS)
  get_filename_component(HYPERION_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

  if(HYPERION_SDK_SHIPPING)
    # Sdk/Shipping holds the libraries, and shares the headers and tools of the Sdk folder it's in
    get_filename_component(HYPERION_SDK_SHARED_ROOT "${HYPERION_SDK_ROOT}/.." ABSOLUTE)
    get_filename_component(HYPERION_SDK_BASE_DIR "${HYPERION_SDK_SHARED_ROOT}/.." ABSOLUTE)
    set(HYPERION_SDK_RUNTIME_DIR "${HYPERION_SDK_ROOT}/Bin")
    set(HYPERION_SDK_CONFIG_DIR "${HYPERION_SDK_BASE_DIR}/Config")

    # file names in Lib, or system libraries and flags
    file(STRINGS "${HYPERION_SDK_ROOT}/StaticLibraries.txt" static_libraries)

    set(HYPERION_SDK_LIBRARIES "")

    foreach(static_library ${static_libraries})
      if(EXISTS "${HYPERION_SDK_ROOT}/Lib/${static_library}")
        list(APPEND HYPERION_SDK_LIBRARIES "${HYPERION_SDK_ROOT}/Lib/${static_library}")
      else()
        list(APPEND HYPERION_SDK_LIBRARIES "${static_library}")
      endif()
    endforeach()
  else()
    set(HYPERION_SDK_SHARED_ROOT "${HYPERION_SDK_ROOT}")
    get_filename_component(HYPERION_SDK_RUNTIME_DIR "${HYPERION_SDK_ROOT}/.." ABSOLUTE)
    hyperion_sdk_packaged_libraries("${HYPERION_SDK_ROOT}" "${HYPERION_SDK_RUNTIME_DIR}" HYPERION_SDK_LIBRARIES)
    set(HYPERION_SDK_BASE_DIR "${HYPERION_SDK_RUNTIME_DIR}")
  endif()

  set(HYPERION_SDK_INCLUDE_DIRS
      "${HYPERION_SDK_SHARED_ROOT}/Include/Generated"
      "${HYPERION_SDK_SHARED_ROOT}/Include"
      "${HYPERION_SDK_SHARED_ROOT}/Include/Engine")

  foreach(third_party_dir ${HYPERION_SDK_THIRD_PARTY_DIRS})
    list(APPEND HYPERION_SDK_INCLUDE_DIRS "${HYPERION_SDK_SHARED_ROOT}/ThirdParty/${third_party_dir}")
  endforeach()

  set(HYPERION_SDK_PCH "${HYPERION_SDK_SHARED_ROOT}/Include/Engine/HyperionPch.hpp")
  if(CMAKE_HOST_WIN32)
    set(HYPERION_SDK_CODEGEN "${HYPERION_SDK_SHARED_ROOT}/Bin/hyperion-codegen.exe")
  else()
    set(HYPERION_SDK_CODEGEN "${HYPERION_SDK_SHARED_ROOT}/Bin/hyperion-codegen")
  endif()
  set(HYPERION_SDK_ENGINE_TYPES "${HYPERION_SDK_SHARED_ROOT}/Include/Generated/EngineTypes.json")
endif()

if(NOT DEFINED HYPERION_SDK_CONFIG_DIR)
  set(HYPERION_SDK_CONFIG_DIR "${HYPERION_SDK_RUNTIME_DIR}/Config")
endif()

if(NOT TARGET Hyperion::Engine)
  add_library(Hyperion::Engine INTERFACE IMPORTED)

  set(engine_libraries ${HYPERION_SDK_LIBRARIES})

  # GNU-style linkers search an archive only once, in order, and the engine's archives reference each other
  if(HYPERION_SDK_SHIPPING AND NOT MSVC AND NOT APPLE)
    set(engine_libraries -Wl,--start-group ${engine_libraries} -Wl,--end-group)
  endif()

  target_include_directories(Hyperion::Engine INTERFACE ${HYPERION_SDK_INCLUDE_DIRS})
  target_link_libraries(Hyperion::Engine INTERFACE ${engine_libraries})

  if(HYPERION_SDK_LINK_OPTIONS)
    target_link_options(Hyperion::Engine INTERFACE ${HYPERION_SDK_LINK_OPTIONS})
  endif()

  target_compile_features(Hyperion::Engine INTERFACE cxx_std_20)
  target_compile_options(Hyperion::Engine INTERFACE @HYP_SDK_COMPILE_OPTIONS@)

  target_compile_definitions(Hyperion::Engine INTERFACE
@HYP_SDK_COMPILE_DEFINITIONS@  )
endif()

function(hyperion_copy_runtime target content_dir)
  set(runtime_files "")

  if(HYPERION_SDK_SHIPPING)
    hyperion_sdk_dependency_tool(dependency_platform dependency_tool dependency_tool_command)

    if(dependency_tool)
      add_custom_command(TARGET ${target} POST_BUILD
          COMMAND ${CMAKE_COMMAND}
              "-DEXECUTABLE=$<TARGET_FILE:${target}>"
              "-DRUNTIME_DIR=${HYPERION_SDK_RUNTIME_DIR}"
              "-DPLATFORM=${dependency_platform}"
              "-DTOOL=${dependency_tool}"
              "-DTOOL_COMMAND=${dependency_tool_command}"
              -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/HyperionCopyRuntimeDependencies.cmake"
          VERBATIM)
    else()
      message(WARNING "No dumpbin, objdump or otool found, so no libraries are copied beside ${target}")
    endif()
  elseif(HYPERION_SDK_RUNTIME_LIBRARIES)
    # the editor's engine compiles shaders at runtime
    set(runtime_libraries ${HYPERION_SDK_RUNTIME_LIBRARIES} ${HYPERION_SDK_SHADER_COMPILER_LIBRARIES})

    foreach(runtime_library ${runtime_libraries})
      list(APPEND runtime_files "${HYPERION_SDK_RUNTIME_DIR}/${runtime_library}")
    endforeach()
  else()
    file(GLOB runtime_files "${HYPERION_SDK_RUNTIME_DIR}/${HYPERION_SDK_RUNTIME_LIBRARY_PATTERN}")
  endif()

  file(GLOB config_files "${HYPERION_SDK_CONFIG_DIR}/*")
  list(FILTER config_files EXCLUDE REGEX "GlobalConfig\\.json$")

  if(runtime_files)
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different ${runtime_files} "$<TARGET_FILE_DIR:${target}>")
  endif()

  if(config_files)
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:${target}>/Config"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different ${config_files} "$<TARGET_FILE_DIR:${target}>/Config")
  endif()

  get_target_property(output_dir ${target} RUNTIME_OUTPUT_DIRECTORY)
  set(global_config "${output_dir}/Config/GlobalConfig.json")

  if(NOT EXISTS "${global_config}")
    file(WRITE "${global_config}"
"{
  \"App\": {
    \"Name\": \"${target}\",
    \"Args\": \"--basedir=\\\"${HYPERION_SDK_BASE_DIR}\\\" --contentdir=${content_dir} --cooked=false --singleplayer\"
  }
}
")
  endif()
endfunction()

# Writes <target>.EngineVersion.txt beside the game module once it's up to date, which the editor checks before loading the module.
# Copied on every build, not only when the module links, so building restores a stamp that was lost or written by another SDK
function(hyperion_stamp_engine_version target)
  set(stamp "${CMAKE_CURRENT_BINARY_DIR}/${target}.EngineVersion.txt")

  file(CONFIGURE OUTPUT "${stamp}" CONTENT "${HYPERION_SDK_VERSION}\n")

  add_custom_target(${target}EngineVersion ALL
      COMMAND ${CMAKE_COMMAND} -E copy_if_different "${stamp}" "$<TARGET_FILE_DIR:${target}>"
      VERBATIM)
  add_dependencies(${target}EngineVersion ${target})
endfunction()

# Runs CodeGen over the game's headers before it compiles (their reflection goes in <build>/Generated, included as <Foo.generated.inl>),
# and builds <target>.Bindings.dll beside the game from the C# it writes, so scripts can use the game's classes.
# The game's function-local statics (its class registrations) stay in the game, not shared with an earlier build of it: the editor
# loads each build into the same process, and default-visibility statics are unified across dlopen'd modules. Only HYP_EXPORT symbols stay visible.
function(hyperion_game_codegen target source_dir)
  get_target_property(module_type ${target} TYPE)

  if(HYPERION_SDK_SHIPPING AND NOT module_type STREQUAL "OBJECT_LIBRARY")
    message(FATAL_ERROR "A shipping SDK links the game module into the game's executable, so ${target} has to be declared with "
        "add_library(${target} \${HYPERION_GAME_MODULE_TYPE} ...) in ${CMAKE_CURRENT_SOURCE_DIR}/CMakeLists.txt (it is ${module_type})")
  endif()

  set_target_properties(${target} PROPERTIES CXX_VISIBILITY_PRESET hidden)

  # only a module the editor loads needs it
  if(NOT HYPERION_SDK_SHIPPING)
    hyperion_stamp_engine_version(${target})
  endif()

  set(generated_dir "${CMAKE_CURRENT_BINARY_DIR}/Generated")
  set(generated_sources "${generated_dir}/GeneratedSources.cpp")

  file(GLOB_RECURSE game_headers CONFIGURE_DEPENDS "${source_dir}/*.hpp" "${source_dir}/*.h")

  file(GLOB generated_files CONFIGURE_DEPENDS "${generated_dir}/*.generated.inl" "${generated_dir}/*.generated.cpp")

  add_custom_command(OUTPUT "${generated_sources}"
      BYPRODUCTS ${generated_files}
      COMMAND "${HYPERION_SDK_CODEGEN}" --Mode=Game
          "--WorkingDirectory=${source_dir}"
          "--SourceDirectory=${source_dir}"
          "--CXXOutputDirectory=${generated_dir}"
          "--CSharpOutputDirectory=${generated_dir}/CSharp"
          "--EngineTypes=${HYPERION_SDK_ENGINE_TYPES}"
      DEPENDS ${game_headers} "${HYPERION_SDK_CODEGEN}" "${HYPERION_SDK_ENGINE_TYPES}"
      COMMENT "Running Hyperion CodeGen for ${target}"
      VERBATIM)

  add_custom_target(${target}CodeGen DEPENDS "${generated_sources}")
  add_dependencies(${target} ${target}CodeGen)

  target_sources(${target} PRIVATE "${generated_sources}")
  target_include_directories(${target} BEFORE PRIVATE "${generated_dir}")

  # a package links the scripts with NativeAOT, which compiles the generated C# itself
  if(HYPERION_PACKAGE OR HYPERION_SDK_SHIPPING)
    return()
  endif()

  find_program(HYPERION_DOTNET dotnet)

  if(NOT HYPERION_DOTNET)
    message(WARNING "dotnet was not found, so C# scripts can't use ${target}'s classes")
    return()
  endif()

  get_target_property(bindings_output_dir ${target} RUNTIME_OUTPUT_DIRECTORY)

  if(NOT bindings_output_dir)
    set(bindings_output_dir "${CMAKE_CURRENT_BINARY_DIR}")
  endif()

  set(bindings_name "${target}.Bindings")
  set(bindings_project "${CMAKE_CURRENT_BINARY_DIR}/Bindings/${bindings_name}.csproj")
  set(bindings_assembly "${bindings_output_dir}/${bindings_name}.dll")
  set(managed_sdk_dir "${HYPERION_SDK_BASE_DIR}/Source/Engine/DotNET/Sdk")

  file(CONFIGURE OUTPUT "${bindings_project}" CONTENT [==[<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>${bindings_name}</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <HyperionBinDir>${HYPERION_SDK_RUNTIME_DIR}/</HyperionBinDir>
    <HyperionBaseDir>${HYPERION_SDK_BASE_DIR}/</HyperionBaseDir>
    <HyperionCopyEngineRuntime>false</HyperionCopyEngineRuntime>
    <OutputPath>${bindings_output_dir}/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="${generated_dir}/CSharp/**/*.cs" />
  </ItemGroup>

  <Import Project="${managed_sdk_dir}/Hyperion.Game.props" />

  <ItemGroup>
    <Reference Update="Hyperion.NET.Shared;Hyperion.NET.Interop;Hyperion.NET.Runtime" Private="false" />
  </ItemGroup>
</Project>
]==])

  # touched so a build that changed no C# still leaves it newer than the CodeGen run
  add_custom_command(OUTPUT "${bindings_assembly}"
      COMMAND "${CMAKE_COMMAND}" -E env --unset=MSBuildSdksPath
          "${HYPERION_DOTNET}" build "${bindings_project}" --configuration Release --nologo --disable-build-servers -verbosity:minimal
      COMMAND "${CMAKE_COMMAND}" -E touch "${bindings_assembly}"
      DEPENDS "${generated_sources}" "${bindings_project}"
      COMMENT "Building ${bindings_name}.dll"
      VERBATIM)

  add_custom_target(${target}Bindings DEPENDS "${bindings_assembly}")
  add_dependencies(${target}Bindings ${target}CodeGen)
  add_dependencies(${target} ${target}Bindings)
endfunction()

set(HYPERION_SCRIPTS_LINK_INPUTS "" CACHE FILEPATH "Link inputs of the game's NativeAOT scripts library, written by Package Game")

function(hyperion_link_scripts target)
  if(NOT HYPERION_SCRIPTS_LINK_INPUTS)
    return()
  endif()

  file(STRINGS "${HYPERION_SCRIPTS_LINK_INPUTS}" scripts_link_inputs)

  hyperion_platform_link_scripts(${target} "${scripts_link_inputs}")
  target_compile_definitions(${target} PRIVATE HYP_GAME_SCRIPTS=1)
endfunction()
