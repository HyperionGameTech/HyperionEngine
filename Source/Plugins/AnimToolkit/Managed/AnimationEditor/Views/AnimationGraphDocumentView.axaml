<UserControl
    x:Class="Hyperion.Editor.Views.AnimationGraphDocumentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hyperion.Editor.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Hyperion.Editor.ViewModels"
    x:DataType="vm:AnimationGraphDocumentViewModel"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Border.parameter-row">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.parameter-row.selected">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border
            Grid.Row="0"
            Padding="6,3"
            Background="{DynamicResource Brush.PanelAlt}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        Padding="6,1"
                        Classes="gizmo"
                        Command="{Binding CloseStateMachineCommand}"
                        Content="Graph" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        IsVisible="{Binding IsInStateMachine}"
                        Text="&gt;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsInStateMachine}"
                        Text="{Binding StateMachineTitle}" />
                    <Border
                        Margin="8,0,0,0"
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.WarningSubtle}"
                        CornerRadius="3"
                        IsVisible="{Binding IsReadOnly}">
                        <TextBlock FontSize="11" Text="{Binding ReadOnlyLabel}" />
                    </Border>
                    <Button
                        Padding="8,1"
                        Command="{Binding CopyToProjectCommand}"
                        Content="Copy to Project"
                        IsVisible="{Binding CanCopyToProject}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="4">
                    <StackPanel
                        IsVisible="{Binding HasPreviewControls}"
                        Orientation="Horizontal"
                        Spacing="4">
                        <ComboBox
                            MinWidth="120"
                            ItemsSource="{Binding PreviewChoices}"
                            SelectedIndex="{Binding SelectedPreviewIndex}"
                            ToolTip.Tip="Preview on" />
                        <Button
                            Width="24"
                            Height="24"
                            Classes="gizmo"
                            Command="{Binding TogglePlayCommand}"
                            ToolTip.Tip="Play/Pause">
                            <controls:Codicon Kind="{Binding PlayIcon}" Size="14" />
                        </Button>
                        <Button
                            Width="24"
                            Height="24"
                            Classes="gizmo"
                            Command="{Binding RestartCommand}"
                            ToolTip.Tip="Restart">
                            <controls:Codicon Kind="DebugRestart" Size="14" />
                        </Button>
                    </StackPanel>
                    <Border
                        Width="1"
                        Margin="4,2"
                        Background="{DynamicResource Brush.Border}" />
                    <Button
                        Padding="6,1"
                        Command="{Binding AddNodeCommand}"
                        IsEnabled="{Binding IsEditable}"
                        ToolTip.Tip="Add node (Space)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <controls:Codicon Kind="Add" Size="14" />
                            <TextBlock VerticalAlignment="Center" Text="Node" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="24"
                        Height="24"
                        Classes="gizmo"
                        Command="{Binding ArrangeCommand}"
                        IsEnabled="{Binding IsEditable}"
                        ToolTip.Tip="Arrange">
                        <controls:Codicon Kind="ListTree" Size="14" />
                    </Button>
                    <Button
                        Width="24"
                        Height="24"
                        Classes="gizmo"
                        Command="{Binding FrameCommand}"
                        ToolTip.Tip="Frame (F)">
                        <controls:Codicon Kind="ScreenFull" Size="14" />
                    </Button>
                    <StackPanel
                        IsVisible="{Binding HasApplyControls}"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Border
                            Width="1"
                            Margin="4,2"
                            Background="{DynamicResource Brush.Border}" />
                        <Button
                            Padding="10,1"
                            Command="{Binding RevertEditModeCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                            Content="Revert" />
                        <Button
                            Padding="10,1"
                            Classes="Primary"
                            Command="{Binding ApplyEditModeCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                            Content="Apply" />
                    </StackPanel>
                    <Button
                        Width="24"
                        Height="24"
                        Classes="gizmo"
                        Command="{Binding ExitEditModeCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                        IsVisible="{Binding !IsDebugging}"
                        ToolTip.Tip="Close">
                        <controls:Codicon Kind="Close" Size="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="200,*">
            <Border
                Grid.Column="0"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
                <DockPanel Margin="6">
                    <TextBlock
                        Margin="0,0,0,4"
                        Classes="section-label"
                        DockPanel.Dock="Top"
                        Text="Parameters" />
                    <Grid
                        Margin="0,0,0,6"
                        ColumnDefinitions="*,74,Auto"
                        DockPanel.Dock="Top"
                        IsEnabled="{Binding IsEditable}">
                        <TextBox
                            Grid.Column="0"
                            Text="{Binding NewParameterName}"
                            Watermark="Name" />
                        <ComboBox
                            Grid.Column="1"
                            Margin="4,0"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ParameterTypes}"
                            SelectedIndex="{Binding NewParameterType}" />
                        <Button
                            Grid.Column="2"
                            Width="24"
                            Height="24"
                            Classes="gizmo"
                            Command="{Binding AddParameterCommand}"
                            ToolTip.Tip="Add parameter">
                            <controls:Codicon Kind="Add" Size="14" />
                        </Button>
                    </Grid>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AnimationGraphParameterViewModel">
                                    <Border Classes="parameter-row" Classes.selected="{Binding IsSelected}">
                                        <Grid Margin="0,1" ColumnDefinitions="*,Auto">
                                            <Button
                                                Grid.Column="0"
                                                Padding="2,0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding SelectCommand}"
                                                ToolTip.Tip="{Binding TypeLabel}">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </Button>
                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="2">
                                                <NumericUpDown
                                                    Width="70"
                                                    FormatString="0.###"
                                                    Increment="0.1"
                                                    IsVisible="{Binding IsFloat}"
                                                    ShowButtonSpinner="False"
                                                    Value="{Binding X}" />
                                                <CheckBox IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBool}" />
                                                <Button
                                                    Padding="8,1"
                                                    Command="{Binding FireCommand}"
                                                    Content="Fire"
                                                    IsVisible="{Binding IsTrigger}" />
                                                <NumericUpDown
                                                    Width="44"
                                                    FormatString="0.##"
                                                    Increment="0.1"
                                                    IsVisible="{Binding IsVector2}"
                                                    ShowButtonSpinner="False"
                                                    Value="{Binding X}" />
                                                <NumericUpDown
                                                    Width="44"
                                                    FormatString="0.##"
                                                    Increment="0.1"
                                                    IsVisible="{Binding IsVector2}"
                                                    ShowButtonSpinner="False"
                                                    Value="{Binding Y}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                <controls:AnimationGraphCanvas Grid.Column="0" />
                <Border
                    Grid.Column="1"
                    Width="240"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1,0,0,0"
                    IsVisible="{Binding IsBlendSelected}">
                    <controls:AnimationBlendSpaceControl />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
