<UserControl
    x:Class="Hyperion.Editor.Views.Inspector.AnimationPreviewEditor"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hyperion.Editor.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Hyperion.Editor.ViewModels"
    x:DataType="vm:AnimationPreviewViewModel"
    mc:Ignorable="d">
    <StackPanel Margin="0,2,0,4" Spacing="4">
        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasClip}">
            <Button
                Grid.Column="0"
                Width="26"
                Height="26"
                Classes="gizmo"
                Command="{Binding TogglePlayCommand}"
                ToolTip.Tip="Play/Pause">
                <controls:Codicon Kind="{Binding PlayIcon}" Size="14" />
            </Button>
            <Slider
                Grid.Column="1"
                Margin="8,0"
                VerticalAlignment="Center"
                Maximum="{Binding Length}"
                Minimum="0"
                Value="{Binding Time, Mode=TwoWay}" />
            <TextBlock
                Grid.Column="2"
                MinWidth="72"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Brush.TextMuted}"
                Text="{Binding TimeText}"
                TextAlignment="Right" />
        </Grid>
        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="6">
            <Button
                Padding="10,2"
                Command="{Binding EditCommand}"
                Content="Edit Clip"
                IsVisible="{Binding HasClip}" />
            <Button
                Padding="10,2"
                Command="{Binding OpenGraphCommand}"
                Content="Open Graph"
                IsVisible="{Binding HasGraph}" />
        </StackPanel>
    </StackPanel>
</UserControl>
