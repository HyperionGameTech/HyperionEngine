cmake_minimum_required(VERSION 3.20)
cmake_policy(SET CMP0091 NEW)

project(@NAME@ CXX)

set(HYPERION_SDK_DIR "" CACHE PATH "Sdk folder of a Hyperion editor install")

if(NOT EXISTS "${HYPERION_SDK_DIR}/CMake/HyperionSdk.cmake")
  message(FATAL_ERROR "Set HYPERION_SDK_DIR to the Sdk folder of a Hyperion editor install")
endif()

include("${HYPERION_SDK_DIR}/CMake/HyperionSdk.cmake")

set(GAME_OUTPUT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../Binaries/${CMAKE_SYSTEM_NAME}")
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${GAME_OUTPUT_DIR}")
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${GAME_OUTPUT_DIR}")

file(GLOB_RECURSE GAME_SOURCES CONFIGURE_DEPENDS "Game/*.cpp" "Game/*.hpp")

add_library(@NAME@Game SHARED ${GAME_SOURCES})
target_include_directories(@NAME@Game PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
target_link_libraries(@NAME@Game PRIVATE Hyperion::Engine)
target_precompile_headers(@NAME@Game PRIVATE "${HYPERION_SDK_PCH}")

add_executable(@NAME@ Launcher/main.cpp)
target_link_libraries(@NAME@ PRIVATE Hyperion::Engine @NAME@Game)

hyperion_copy_runtime(@NAME@ "../../")
