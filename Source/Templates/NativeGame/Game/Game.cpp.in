#include <Game/@CLASS@.hpp>

#include <Framework/EngineGlobals.hpp>

#include <UI/UISubsystem.hpp>
#include <UI/UIStage.hpp>
#include <UI/UIPanel.hpp>
#include <UI/UIText.hpp>

#include <Core/Logging/Logger.hpp>

#include <Core/Reflection/ClassUtils.hpp>
#include <Core/Reflection/ClassRegistry.hpp>

namespace Hyperion {

ENGINE_API HYP_DECLARE_LOG_CHANNEL(Game);

@CLASS@::@CLASS@()
    : Game()
{
}

@CLASS@::~@CLASS@()
{
}

void @CLASS@::BeforeConnectingToServer()
{
    Game::BeforeConnectingToServer();

    const char* hostAddress = NetGlobals::GetHostAddress();

    ShowStatus(hostAddress != nullptr && *hostAddress != '\0'
        ? HYP_FORMAT("Connecting to {}...", hostAddress)
        : String("Not connected. Start the game with --host=<address> to join a server."));

    m_connectionState.OnStateChanged.RemoveAllDetached();
    m_connectionState.OnStateChanged.Bind(
        [this](ServerConnectionState::State state)
        {
            if (state == ServerConnectionState::Failed)
            {
                ShowStatus(m_connectionState.lastResult.HasError()
                    ? String("Failed to connect: ") + m_connectionState.lastResult.GetError().GetMessage()
                    : String("Failed to connect"));
            }
        })
        .Detach();
}

void @CLASS@::BeforeContentLoaded()
{
    Game::BeforeContentLoaded();

    ShowStatus("Loading...");
}

void @CLASS@::AfterContentLoaded()
{
    Game::AfterContentLoaded();

    if (m_syncState.state == ContentSyncState::Failed)
    {
        ShowStatus(HYP_FORMAT("Could not load world '{}'", GetStartupWorldName()));

        return;
    }

    HideStatus();
}

void @CLASS@::ShowStatus(const String& text)
{
    if (!m_uiSubsystem.IsValid())
    {
        return;
    }

    HideStatus();

    UIStage& stage = *m_uiSubsystem->GetUIStage();

    Handle<UIPanel> background = stage.CreateUIObject<UIPanel>(NAME("StatusScreen"), Vec2i::Zero(), UIObjectSize { { 100, UIObjectSize::PERCENT }, { 100, UIObjectSize::PERCENT } });
    background->SetBackgroundColor(Color(0.1f, 0.1f, 0.1f, 1.0f));
    stage.AddChildUIObject(background);

    Handle<UIText> statusText = background->CreateUIObject<UIText>(Vec2i::Zero(), UIObjectSize { { 0, UIObjectSize::AUTO }, { 80, UIObjectSize::PIXEL } });
    statusText->SetText(text);
    statusText->SetTextSize(24.0f);
    statusText->SetTextColor(Color::White());
    statusText->SetOriginAlignment(UIObjectAlignment::CENTER);
    statusText->SetParentAlignment(UIObjectAlignment::CENTER);
    background->AddChildUIObject(statusText);
}

void @CLASS@::HideStatus()
{
    if (!m_uiSubsystem.IsValid())
    {
        return;
    }

    UIStage& stage = *m_uiSubsystem->GetUIStage();

    if (Handle<UIObject> background = stage.FindChildUIObject("StatusScreen"_sh); background.IsValid())
    {
        stage.RemoveChildUIObject(background);
    }
}

void @CLASS@::OnLaunch()
{
    Game::OnLaunch();

    HYP_LOG(Game, Info, "@CLASS@ launched");

    StartSimulating();
}

void @CLASS@::OnUpdate(float delta)
{
    Game::OnUpdate(delta);
}

bool @CLASS@::OnInputEvent(const Event& event)
{
    return Game::OnInputEvent(event);
}

#pragma region Reflection

const Class* g_cls@CLASS@ = nullptr;

const Class* @CLASS@::StaticClass()
{
    return g_cls@CLASS@;
}

// clang-format off

HYP_BEGIN_CLASS(@CLASS@, -1, 0, NAME("Game"))
HYP_END_CLASS

// clang-format on

HYP_REGISTER_STATIC_CLASS(@CLASS@);

#pragma endregion Reflection

} // namespace Hyperion

extern "C"
{

HYP_EXPORT const char* HypGameModule_GetGameClassName()
{
    return "@CLASS@";
}

HYP_EXPORT void HypGameModule_GetEngineVersion(Hyperion::uint32* outMajor, Hyperion::uint32* outMinor, Hyperion::uint32* outPatch)
{
    *outMajor = HYP_VERSION_MAJOR;
    *outMinor = HYP_VERSION_MINOR;
    *outPatch = HYP_VERSION_PATCH;
}

}
