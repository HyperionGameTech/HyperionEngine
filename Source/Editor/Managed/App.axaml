<Application
    x:Class="Hyperion.Editor.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:panels="clr-namespace:Hyperion.Editor.Views.Panels;assembly=Hyperion.Editor"
    xmlns:dac="using:Dock.Avalonia.Controls"
    xmlns:ds="using:Dock.Avalonia.Themes.Simple"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    Name="Hyperion Editor"
    RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <DataTemplate DataType="vm:NewPhysicsShapePanelViewModel">
            <panels:NewPhysicsShapePanelView />
        </DataTemplate>
        <DataTemplate DataType="vm:NewScriptPanelViewModel">
            <panels:NewScriptPanelView />
        </DataTemplate>
        <DataTemplate DataType="vm:AddNewScenePanelViewModel">
            <panels:AddNewScenePanelView />
        </DataTemplate>
        <DataTemplate DataType="vm:AddNewSwatchPanelViewModel">
            <panels:AddNewSwatchPanelView />
        </DataTemplate>
        <DataTemplate DataType="vm:AddNewLayerPanelViewModel">
            <panels:AddNewLayerPanelView />
        </DataTemplate>
        <DataTemplate DataType="vm:NewWeaponPanelViewModel">
            <panels:NewWeaponPanelView />
        </DataTemplate>
        <DataTemplate DataType="vm:AddNormalizedCubeSpherePanelViewModel">
            <panels:AddNormalizedCubeSpherePanelView />
        </DataTemplate>
        <DataTemplate DataType="vm:AssetObjectEditPanelViewModel">
            <panels:AssetObjectEditPanelView />
        </DataTemplate>
        <DataTemplate DataType="vm:TerrainSculptPanelViewModel">
            <panels:TerrainSculptPanelView />
        </DataTemplate>
        <DataTemplate DataType="vm:TerrainPaintPanelViewModel">
            <panels:TerrainPaintPanelView />
        </DataTemplate>
        <DataTemplate DataType="vm:DecalPainterPanelViewModel">
            <panels:DecalPainterPanelView />
        </DataTemplate>
        <DataTemplate DataType="vm:NetworkSettingsPanelViewModel">
            <panels:NetworkSettingsPanelView />
        </DataTemplate>
        <DataTemplate DataType="vm:SaveAsPrefabPanelViewModel">
            <panels:SaveAsPrefabPanelView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Color.Background">#FF020304</Color>
            <Color x:Key="Color.Panel">#FF060709</Color>
            <Color x:Key="Color.PanelAlt">#FF0A0B0D</Color>
            <Color x:Key="Color.PanelRaised">#FF0E0F12</Color>
            <Color x:Key="Color.Border">#FF121416</Color>
            <Color x:Key="Color.BorderLight">#FF1A1C1F</Color>
            <Color x:Key="Color.Accent">#FF3D7EFF</Color>
            <Color x:Key="Color.AccentHover">#FF5C93FF</Color>
            <Color x:Key="Color.AccentMuted">#FF2E5FC2</Color>
            <Color x:Key="Color.AccentSubtle">#143D7EFF</Color>
            <Color x:Key="Color.AccentSelection">#3D3D7EFF</Color>
            <Color x:Key="Color.Primary">#FF3D7EFF</Color>
            <Color x:Key="Color.PrimaryHover">#FF5C93FF</Color>
            <Color x:Key="Color.PrimaryMuted">#FF2E5FC2</Color>
            <Color x:Key="Color.Play">#FF16A34A</Color>
            <Color x:Key="Color.PlayHover">#FF22C55E</Color>
            <Color x:Key="Color.PlayMuted">#FF15803D</Color>
            <Color x:Key="Color.Text">#FFD0D3D9</Color>
            <Color x:Key="Color.TextMuted">#FF72777E</Color>
            <Color x:Key="Color.TextFaint">#FF4A4E54</Color>
            <Color x:Key="Color.Warning">#FFE3A84D</Color>
            <Color x:Key="Color.Danger">#FFE0555C</Color>
            <Color x:Key="Color.MenuHover">#FF141618</Color>
            <Color x:Key="Color.HoverBorder">#FF282C32</Color>
            <Color x:Key="Color.InputBackground">#FF08090B</Color>
            <Color x:Key="Color.InputBorder">#FF141618</Color>

            <!--  Brushes  -->
            <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
            <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
            <SolidColorBrush x:Key="Brush.PanelAlt" Color="{StaticResource Color.PanelAlt}" />
            <SolidColorBrush x:Key="Brush.PanelRaised" Color="{StaticResource Color.PanelRaised}" />
            <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
            <SolidColorBrush x:Key="Brush.BorderLight" Color="{StaticResource Color.BorderLight}" />
            <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
            <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
            <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}" />
            <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{StaticResource Color.AccentSubtle}" />
            <SolidColorBrush x:Key="Brush.AccentSelection" Color="{StaticResource Color.AccentSelection}" />
            <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
            <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
            <SolidColorBrush x:Key="Brush.PrimaryMuted" Color="{StaticResource Color.PrimaryMuted}" />
            <SolidColorBrush x:Key="Brush.Play" Color="{StaticResource Color.Play}" />
            <SolidColorBrush x:Key="Brush.PlayHover" Color="{StaticResource Color.PlayHover}" />
            <SolidColorBrush x:Key="Brush.PlayMuted" Color="{StaticResource Color.PlayMuted}" />
            <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
            <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
            <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}" />
            <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextMuted}" />
            <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
            <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
            <SolidColorBrush x:Key="Brush.MenuHover" Color="{StaticResource Color.MenuHover}" />
            <SolidColorBrush x:Key="Brush.HoverBorder" Color="{StaticResource Color.HoverBorder}" />
            <SolidColorBrush x:Key="Brush.InputBackground" Color="{StaticResource Color.InputBackground}" />
            <SolidColorBrush x:Key="Brush.InputBorder" Color="{StaticResource Color.InputBorder}" />

            <!--  Dock (Dock.Avalonia) palette overrides - map the dock chrome onto the editor theme  -->
            <SolidColorBrush x:Key="DockThemeBackgroundBrush" Color="#FF020304" />
            <SolidColorBrush x:Key="DockThemeBackgroundLowBrush" Color="#FF060709" />
            <SolidColorBrush x:Key="DockThemeBackgroundMidBrush" Color="#FF0A0B0D" />
            <SolidColorBrush x:Key="DockThemeBackgroundHighBrush" Color="#FF141618" />
            <SolidColorBrush x:Key="DockThemeControlBackgroundBrush" Color="#FF0E0F12" />
            <SolidColorBrush x:Key="DockThemeBorderLowBrush" Color="#FF121416" />
            <SolidColorBrush x:Key="DockThemeBorderMidBrush" Color="#FF1A1C1F" />
            <SolidColorBrush x:Key="DockThemeBorderHighBrush" Color="#FF282C32" />
            <SolidColorBrush x:Key="DockThemeAccentBrush" Color="#FF3D7EFF" />
            <SolidColorBrush x:Key="DockThemeForegroundBrush" Color="#FFD0D3D9" />
            <SolidColorBrush x:Key="DockThemeForegroundLowBrush" Color="#FF72777E" />
            <SolidColorBrush x:Key="DockToolChromeIconBrush" Color="#FF72777E" />
            <SolidColorBrush x:Key="DockApplicationAccentBrushLow" Color="#143D7EFF" />
            <SolidColorBrush x:Key="DockApplicationAccentBrushMed" Color="#FF5C93FF" />
            <SolidColorBrush x:Key="DockApplicationAccentBrushHigh" Color="#FF3D7EFF" />
            <SolidColorBrush x:Key="DockApplicationAccentBrushIndicator" Color="#FF3D7EFF" />
            <SolidColorBrush x:Key="DockApplicationAccentForegroundBrush" Color="#FFD0D3D9" />

            <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#FF020304" />
            <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#FF060709" />
            <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#FF060709" />
            <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#FF0A0B0D" />
            <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#FF0A0B0D" />
            <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#00000000" />
            <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#FF121416" />
            <SolidColorBrush x:Key="DockBorderStrongBrush" Color="#FF1A1C1F" />
            <SolidColorBrush x:Key="DockSeparatorBrush" Color="#FF121416" />
            <SolidColorBrush x:Key="DockSplitterIdleBrush" Color="#FF121416" />
            <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="#FF282C32" />
            <SolidColorBrush x:Key="DockSplitterDragBrush" Color="#FF3D7EFF" />
            <SolidColorBrush x:Key="DockTabBackgroundBrush" Color="#00000000" />
            <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="#FF141618" />
            <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#FF0A0B0D" />
            <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#FF3D7EFF" />
            <SolidColorBrush x:Key="DockTabForegroundBrush" Color="#FF72777E" />
            <SolidColorBrush x:Key="DockTabSelectedForegroundBrush" Color="#FFD0D3D9" />
            <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#FFD0D3D9" />
            <SolidColorBrush x:Key="DockTabCloseHoverBackgroundBrush" Color="#FF282C32" />
            <SolidColorBrush x:Key="DockTargetIndicatorBrush" Color="#FF3D7EFF" />
            <SolidColorBrush x:Key="DockChromeButtonForegroundBrush" Color="#FF72777E" />
            <SolidColorBrush x:Key="DockChromeButtonHoverBackgroundBrush" Color="#FF141618" />
            <SolidColorBrush x:Key="DockChromeButtonPressedBackgroundBrush" Color="#FF282C32" />
            <SolidColorBrush x:Key="DockChromeButtonDangerHoverBrush" Color="#FFE0555C" />
            <sys:Double x:Key="DockCornerRadiusSmall">4</sys:Double>

            <!--  Metrics  -->
            <Thickness x:Key="Thickness.ControlPadding">7,5</Thickness>
            <Thickness x:Key="Thickness.HeaderPadding">7,5</Thickness>
            <Thickness x:Key="Thickness.HeaderPaddingSmall">5,5</Thickness>
            <Thickness x:Key="Thickness.TabPadding">7,5</Thickness>
            <Thickness x:Key="Thickness.Border">1</Thickness>
            <CornerRadius x:Key="Radius.Small">4</CornerRadius>
            <CornerRadius x:Key="Radius.Medium">6</CornerRadius>
            <CornerRadius x:Key="Radius.Large">10</CornerRadius>

            <FontFamily x:Key="Font.Base">Segoe UI Variable, Segoe UI, Helvetica, Arial, sans-serif</FontFamily>
            <FontFamily x:Key="Font.Mono">Cascadia Mono, Menlo, Monaco, SFMono-Regular, Consolas, Courier New, monospace</FontFamily>

            <!--  Empty theme used to blank out dock chrome buttons we don't want (maximize)  -->
            <ControlTheme x:Key="DockEmptyButtonTheme" TargetType="Button">
                <Setter Property="Width" Value="0" />
                <Setter Property="Height" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Panel Width="0" Height="0" />
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!--  Dock chrome buttons (close / pin / menu) restyled to match the editor  -->
            <ControlTheme x:Key="DockCloseButtonTheme" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{StaticResource Brush.MenuHover}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                </Style>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Path
                                Data="M0,0 L8,8 M8,0 L0,8"
                                Stroke="{TemplateBinding Foreground}"
                                StrokeThickness="1.2"
                                Stretch="Uniform"
                                Width="8" Height="8"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="DockPinButtonTheme" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{StaticResource Brush.MenuHover}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                </Style>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Path
                                Data="M8,1 C6.3,1 5,2.3 5,4 C5,5.1 5.6,6 6.5,6.5 L6.5,9 L4,10.75 L4,11.5 L12,11.5 L12,10.75 L9.5,9 L9.5,6.5 C10.4,6 11,5.1 11,4 C11,2.3 9.7,1 8,1 Z M7,12.5 L9,12.5 L9,14.5 C9,15.05 8.55,15.5 8,15.5 C7.45,15.5 7,15.05 7,14.5 Z"
                                Fill="{TemplateBinding Foreground}"
                                Stretch="Uniform"
                                Width="8" Height="14.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="DockMenuButtonTheme" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{StaticResource Brush.MenuHover}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                </Style>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Path
                                Data="M1,2.5 L11,2.5 M1,6 L11,6 M1,9.5 L11,9.5"
                                Stroke="{TemplateBinding Foreground}"
                                StrokeThickness="1.2"
                                Stretch="Uniform"
                                Width="10" Height="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <SimpleTheme />

        <!--  Dock layout system theme (matches the SimpleTheme chrome)  -->
        <ds:DockSimpleTheme DensityStyle="Normal" />

        <!--  Text styles  -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
        <Style Selector="TextBlock.header">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LetterSpacing" Value="0.2" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        </Style>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}" />
            <Setter Property="LetterSpacing" Value="0.8" />
        </Style>

        <!--  Inspector property name style  -->
        <Style Selector="TextBlock.inspector-name">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="Padding" Value="0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  Inspector property description (under the row when the property list has ShowDescriptions on)  -->
        <Style Selector="TextBlock.inspector-description">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}" />
            <Setter Property="Margin" Value="0,1,0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  Menu  -->
        <Style Selector="Menu">
            <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="1,0" />
        </Style>

        <Style Selector="MenuItem:pointerover /template/ Border#root">
            <Setter Property="Background" Value="{StaticResource Brush.MenuHover}" />
        </Style>
        <Style Selector="MenuItem:selected /template/ Border#root">
            <Setter Property="Background" Value="{StaticResource Brush.MenuHover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="MenuItem /template/ Path#rightArrow">
            <Setter Property="Fill" Value="{StaticResource Brush.TextMuted}" />
        </Style>
        <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style Selector="MenuItem /template/ Popup#PART_Popup > Border">
            <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BoxShadow" Value="0 12 28 -6 #99000000" />
        </Style>

        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style Selector="Separator">
            <Setter Property="Background" Value="{StaticResource Brush.Border}" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Height" Value="1" />
        </Style>

        <!--  TabControl  -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Padding" Value="{StaticResource Thickness.TabPadding}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="{StaticResource Brush.PanelAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>

        <!--  TreeView / ListBox  -->
        <Style Selector="TreeView, ListBox">
            <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TreeViewItem, ListBoxItem">
            <Setter Property="Padding" Value="{StaticResource Thickness.ControlPadding}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
        <Style Selector="TreeViewItem:pointerover, ListBoxItem:pointerover">
            <Setter Property="Background" Value="{StaticResource Brush.MenuHover}" />
        </Style>
        <Style Selector="TreeViewItem:selected, ListBoxItem:selected">
            <Setter Property="Background" Value="{StaticResource Brush.AccentSelection}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>

        <!--  GridSplitter  -->
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="{StaticResource Brush.Border}" />
        </Style>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="BringIntoViewOnFocusChange" Value="False" />
        </Style>

        <!--  ScrollBar  -->
        <Style Selector="ScrollBar">
            <Setter Property="Foreground" Value="{StaticResource Brush.BorderLight}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource Brush.BorderLight}" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        </Style>

        <!--  Headers (panel title bars)  -->
        <Style Selector="Border.panel-header">
            <Setter Property="Background" Value="{StaticResource Brush.PanelAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="{StaticResource Thickness.HeaderPadding}" />
        </Style>
        <Style Selector="Border.panel-header-small">
            <Setter Property="Background" Value="{StaticResource Brush.PanelAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="{StaticResource Thickness.HeaderPaddingSmall}" />
        </Style>

        <!--  Status Bar  -->
        <Style Selector="Border.status-bar">
            <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style Selector="Border.task-box">
            <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style Selector="TextBlock.task-title">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>

        <!--  Buttons  -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:over">
            <Setter Property="Background" Value="{StaticResource Brush.MenuHover}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.HoverBorder}" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{StaticResource Brush.AccentMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentMuted}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!--  Primary (accent-filled) button, used for confirm/create actions  -->
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.Primary:over">
            <Setter Property="Background" Value="{StaticResource Brush.PrimaryHover}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.PrimaryHover}" />
        </Style>
        <Style Selector="Button.Primary:pressed">
            <Setter Property="Background" Value="{StaticResource Brush.PrimaryMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.PrimaryMuted}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        
        <!--  Start simulation button - a vivid "GO" green so it reads as the primary action  -->
        <Style Selector="Button.Play">
            <Setter Property="Background" Value="{DynamicResource Brush.Play}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Play}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.Play:over">
            <Setter Property="Background" Value="{DynamicResource Brush.PlayHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.PlayHover}" />
        </Style>

        <Style Selector="Button.Play:pressed">
            <Setter Property="Background" Value="{DynamicResource Brush.PlayMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.PlayMuted}" />
        </Style>

        <Style Selector="Button.reset-icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Button.reset-icon:pointerover">
            <Setter Property="Background" Value="{StaticResource Brush.MenuHover}" />
        </Style>
        <Style Selector="Button.reset-icon:pressed">
            <Setter Property="Background" Value="{StaticResource Brush.AccentMuted}" />
        </Style>
        <Style Selector="Button.reset-icon Path">
            <Setter Property="Fill" Value="{StaticResource Brush.TextMuted}" />
        </Style>
        <Style Selector="Button.reset-icon:pointerover Path">
            <Setter Property="Fill" Value="{StaticResource Brush.Text}" />
        </Style>

        <!--  Textbox  -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource Brush.InputBackground}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="SelectionBrush" Value="{StaticResource Brush.AccentSubtle}" />
            <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderLight}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        </Style>

        <!--  Drop-downs (ComboBox / AutoCompleteBox)  -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource Brush.InputBackground}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="PlaceholderForeground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="ComboBox /template/ Border#border">
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{StaticResource Brush.MenuHover}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.HoverBorder}" />
        </Style>
        <!--  The built-in arrow toggle paints its own flat, square highlight on
              pointerover/pressed/checked - suppress it so the whole rounded box
              (styled above) is what visually reacts instead.  -->
        <Style Selector="ComboBox /template/ ToggleButton#toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox /template/ Popup#PART_Popup > Border">
            <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
            <Setter Property="BoxShadow" Value="0 12 28 -6 #99000000" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.MenuHover}" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.AccentSelection}" />
        </Style>

        <Style Selector="AutoCompleteBox">
            <Setter Property="Background" Value="{StaticResource Brush.InputBackground}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="AutoCompleteBox /template/ Popup#PART_Popup > Border">
            <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
            <Setter Property="BoxShadow" Value="0 12 28 -6 #99000000" />
        </Style>
        <Style Selector="AutoCompleteBox /template/ ListBox#PART_SelectingItemsControl">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="AutoCompleteBox /template/ ListBoxItem">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <!--  Joined text-box-plus-toggle drop-down (asset/subclass pickers)  -->
        <Style Selector="Border.picker-box">
            <Setter Property="Background" Value="{StaticResource Brush.InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
        </Style>
        <Style Selector="Border.picker-box AutoCompleteBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="Border.picker-box Border.picker-divider">
            <Setter Property="Background" Value="{StaticResource Brush.Border}" />
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style Selector="Button.picker-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0,4,4,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="9" />
        </Style>
        <Style Selector="Button.picker-toggle:pointerover">
            <Setter Property="Background" Value="{StaticResource Brush.MenuHover}" />
        </Style>

        <!--  Inspector section headers: flat full-width toggle; hover feedback via chevron color  -->
        <Style Selector="ToggleButton.section-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="Margin" Value="-4,-5,0,-5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.section-toggle:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Brush.AccentHover}" />
        </Style>

        <Style Selector="ToggleButton.panel-toggle">
            <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.panel-toggle:pointerover">
            <Setter Property="Background" Value="{StaticResource Brush.MenuHover}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.HoverBorder}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
        <Style Selector="ToggleButton.panel-toggle:checked">
            <Setter Property="Background" Value="{StaticResource Brush.AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.AccentHover}" />
        </Style>
        <Style Selector="ToggleButton.panel-toggle:checked:pointerover">
            <Setter Property="Background" Value="{StaticResource Brush.AccentMuted}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!--  CheckBox  -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
        </Style>
        <Style Selector="CheckBox /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{StaticResource Brush.InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.InputBorder}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        </Style>

        <!--  CheckBox as flyout menu row (e.g. layer visibility toggles)  -->
        <Style Selector="CheckBox.layers-toggle">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="142" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
        <Style Selector="CheckBox.layers-toggle:pointerover">
            <Setter Property="Background" Value="{StaticResource Brush.MenuHover}" />
        </Style>

        <!--  RadioButton  -->
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
        </Style>
        <Style Selector="RadioButton /template/ Ellipse#NormalEllipse">
            <Setter Property="Stroke" Value="{StaticResource Brush.InputBorder}" />
            <Setter Property="Fill" Value="{StaticResource Brush.InputBackground}" />
        </Style>
        <Style Selector="RadioButton:checked /template/ Ellipse#NormalEllipse">
            <Setter Property="Stroke" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
            <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="RadioButton:pointerover /template/ Ellipse#NormalEllipse">
            <Setter Property="Stroke" Value="{StaticResource Brush.Accent}" />
        </Style>

        <!--  Slider  -->
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>

        <!--  ProgressBar  -->
        <Style Selector="ProgressBar">
            <Setter Property="Background" Value="{StaticResource Brush.Border}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <!--  Expander  -->
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="{StaticResource Brush.MenuHover}" />
        </Style>

        <!--  ToolTip  -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <!--  Remove the maximize/restore button from dock pane chrome (floating panes).  -->
        <Style Selector="dac|ToolChromeControl">
            <Setter Property="MaximizeButtonTheme" Value="{StaticResource DockEmptyButtonTheme}" />
            <Setter Property="CloseButtonTheme" Value="{StaticResource DockCloseButtonTheme}" />
            <Setter Property="PinButtonTheme" Value="{StaticResource DockPinButtonTheme}" />
            <Setter Property="MenuButtonTheme" Value="{StaticResource DockMenuButtonTheme}" />
        </Style>

        <!--  Tooltips for the dock chrome buttons  -->
        <Style Selector="dac|ToolChromeControl /template/ Button#PART_CloseButton">
            <Setter Property="ToolTip.Tip" Value="Close Panel" />
        </Style>
        <Style Selector="dac|ToolChromeControl /template/ Button#PART_PinButton">
            <Setter Property="ToolTip.Tip" Value="Pin Panel" />
        </Style>
        <Style Selector="dac|ToolChromeControl /template/ Button#PART_MenuButton">
            <Setter Property="ToolTip.Tip" Value="Panel Options" />
        </Style>

        <!--  Dock tab strips use the editor font  -->
        <Style Selector="dac|ToolTabStripItem, dac|DocumentTabStripItem">
            <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="dac|ToolChromeControl">
            <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </Application.Styles>
</Application>
