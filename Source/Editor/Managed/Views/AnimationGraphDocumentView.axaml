<UserControl
    x:Class="Hyperion.Editor.Views.AnimationGraphDocumentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Hyperion.Editor.Controls;assembly=Hyperion.Editor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inspector="clr-namespace:Hyperion.Editor.Views.Inspector;assembly=Hyperion.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:DataType="vm:AnimationGraphDocumentViewModel"
    mc:Ignorable="d">
    <Grid ColumnDefinitions="210,*,260">
        <Border
            Grid.Column="0"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,1,0">
            <DockPanel Margin="8">
                <TextBlock
                    Margin="0,0,0,6"
                    Classes="section-label"
                    DockPanel.Dock="Top"
                    Text="Parameters" />
                <Grid
                    Margin="0,0,0,8"
                    ColumnDefinitions="*,80,Auto"
                    DockPanel.Dock="Top">
                    <TextBox
                        Grid.Column="0"
                        Text="{Binding NewParameterName}"
                        Watermark="Name" />
                    <ComboBox
                        Grid.Column="1"
                        Margin="4,0"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding ParameterTypes}"
                        SelectedIndex="{Binding NewParameterType}" />
                    <Button
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        Classes="gizmo"
                        Command="{Binding AddParameterCommand}"
                        ToolTip.Tip="Add parameter">
                        <controls:Codicon Kind="Add" Size="14" />
                    </Button>
                </Grid>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Parameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnimationGraphParameterViewModel">
                                <Grid Margin="0,2" ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                        <NumericUpDown
                                            Width="80"
                                            FormatString="0.###"
                                            Increment="0.1"
                                            IsVisible="{Binding IsFloat}"
                                            Value="{Binding X}" />
                                        <CheckBox IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBool}" />
                                        <Button
                                            Padding="8,2"
                                            Command="{Binding FireCommand}"
                                            Content="Fire"
                                            IsVisible="{Binding IsTrigger}" />
                                        <NumericUpDown
                                            Width="62"
                                            FormatString="0.##"
                                            Increment="0.1"
                                            IsVisible="{Binding IsVector2}"
                                            ShowButtonSpinner="False"
                                            Value="{Binding X}" />
                                        <NumericUpDown
                                            Width="62"
                                            FormatString="0.##"
                                            Increment="0.1"
                                            IsVisible="{Binding IsVector2}"
                                            ShowButtonSpinner="False"
                                            Value="{Binding Y}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        Width="22"
                                        Height="22"
                                        Margin="2,0,0,0"
                                        Classes="gizmo"
                                        Command="{Binding RemoveCommand}"
                                        ToolTip.Tip="Remove">
                                        <controls:Codicon Kind="Trash" Size="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,Auto">
            <controls:AnimationGraphCanvas Grid.Row="0" />
            <Border
                Grid.Row="1"
                Height="190"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsBlendSelected}">
                <controls:AnimationBlendSpaceControl />
            </Border>
        </Grid>

        <Border
            Grid.Column="2"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1,0,0,0">
            <ScrollViewer IsVisible="{Binding HasSelection}">
                <StackPanel Margin="8" Spacing="6">
                    <TextBlock Classes="section-label" Text="{Binding SelectedNodeProperties.Label}" />
                    <inspector:InspectorPropertyItemsControl ItemsSource="{Binding SelectedNodeProperties.Properties}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
