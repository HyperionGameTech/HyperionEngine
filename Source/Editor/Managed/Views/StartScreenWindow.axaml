<Window
    x:Class="Hyperion.Editor.Views.StartScreenWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Hyperion.Editor.Controls;assembly=Hyperion.Editor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:CompileBindings="False"
    x:DataType="vm:StartScreenViewModel"
    mc:Ignorable="d"
    Title="Hyperion Editor"
    Icon="/Assets/Branding/hyperion-icon.ico"
    Width="880"
    Height="560"
    MinWidth="720"
    MinHeight="440"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource Brush.Background}">

    <Window.Styles>
        <Style Selector="Button.start-action">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        </Style>

        <Style Selector="Button.start-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.HoverBorder}" />
        </Style>

        <Style Selector="ListBox.recent-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="ListBox.recent-list ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ListBox.recent-list ListBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
        </Style>

        <Style Selector="ListBox.recent-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
        </Style>

        <Style Selector="ListBox.recent-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentMuted}" />
        </Style>

        <Style Selector="Grid.recent-item.missing :is(Control).recent-info">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="Button.recent-remove">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
        </Style>

        <Style Selector="ListBoxItem:pointerover Button.recent-remove">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.recent-remove:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
        </Style>
    </Window.Styles>

    <Grid>
        <Grid ColumnDefinitions="280,*">
            <!--  Actions  -->
            <Border
                Grid.Column="0"
                Padding="20,22"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
                <DockPanel>
                    <Image
                        Height="54"
                        Margin="0,0,0,24"
                        HorizontalAlignment="Left"
                        DockPanel.Dock="Top"
                        RenderOptions.BitmapInterpolationMode="HighQuality"
                        Source="/Assets/Branding/hyperion_light.png"
                        Stretch="Uniform" />

                    <CheckBox
                        Margin="0,16,0,0"
                        DockPanel.Dock="Bottom"
                        IsChecked="{Binding AlwaysOpenLastProject, Mode=TwoWay}"
                        ToolTip.Tip="Skip this screen and always reopen the most recently opened project next time the editor starts.&#x0a;This can be disabled later from the Open sub-menu in the main toolbar">
                        <TextBlock FontSize="12" Text="Open last project on startup" />
                    </CheckBox>

                    <StackPanel Spacing="8">
                        <Button
                            Classes="start-action"
                            Command="{Binding NewProjectCommand}"
                            ToolTip.Tip="New project from blank template">
                            <Grid ColumnDefinitions="Auto,*">
                                <Panel
                                    Grid.Column="0"
                                    Width="18"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                    <controls:Codicon
                                        IsVisible="{Binding !IsCreatingProject}"
                                        Kind="Add"
                                        Size="18" />
                                    <Path
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        Classes="spinner"
                                        IsVisible="{Binding IsCreatingProject}"
                                        Stretch="Uniform" />
                                </Panel>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock FontWeight="SemiBold" Text="New Project" />
                                    <TextBlock
                                        Classes="muted"
                                        FontSize="11"
                                        Text="New project from blank template" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            Classes="start-action"
                            Command="{Binding BrowseCommand}"
                            ToolTip.Tip="Open an existing project">
                            <Grid ColumnDefinitions="Auto,*">
                                <Panel
                                    Grid.Column="0"
                                    Width="18"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                    <controls:Codicon
                                        IsVisible="{Binding !IsBrowsing}"
                                        Kind="FolderOpened"
                                        Size="18" />
                                    <Path
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        Classes="spinner"
                                        IsVisible="{Binding IsBrowsing}"
                                        Stretch="Uniform" />
                                </Panel>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock FontWeight="SemiBold" Text="Browse..." />
                                    <TextBlock
                                        Classes="muted"
                                        FontSize="11"
                                        Text="Open an existing project" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--  Recent projects  -->
            <DockPanel Grid.Column="1" Margin="20,22,20,16">
                <Grid
                    Margin="4,0,0,10"
                    ColumnDefinitions="*,Auto"
                    DockPanel.Dock="Top">
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Classes="section-label"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="Recent Projects" />
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        Width="200"
                        FontSize="12"
                        IsVisible="{Binding IsSearchVisible}"
                        KeyDown="OnSearchBoxKeyDown"
                        Text="{Binding FilterText, Mode=TwoWay}"
                        Watermark="Search" />
                </Grid>

                <Panel>
                    <StackPanel
                        Margin="4,8,0,0"
                        IsVisible="{Binding !HasRecentProjects}"
                        Spacing="4">
                        <TextBlock FontSize="13" Text="No recent projects yet." />
                        <TextBlock
                            Classes="muted"
                            FontSize="11.5"
                            Text="Projects you open or save will show up here."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ListBox
                        x:Name="RecentList"
                        Classes="recent-list"
                        IsVisible="{Binding HasRecentProjects}"
                        ItemsSource="{Binding RecentProjects}"
                        KeyDown="OnRecentListKeyDown"
                        Tapped="OnRecentListTapped"
                        SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentProjectItemViewModel">
                                <Grid
                                    Background="Transparent"
                                    Classes="recent-item"
                                    Classes.missing="{Binding !Exists}"
                                    ColumnDefinitions="Auto,*,Auto,Auto"
                                    ToolTip.Tip="{Binding FilePath}">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Click="OnOpenMenuClicked" Header="Open" />
                                            <MenuItem Click="OnShowInExplorerMenuClicked" Header="Show in Explorer" />
                                            <MenuItem Click="OnTogglePinMenuClicked" Header="{Binding PinMenuHeader}" />
                                            <Separator />
                                            <MenuItem Click="OnRemoveMenuClicked" Header="Remove from List" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <Border
                                        Grid.Column="0"
                                        Width="64"
                                        Height="36"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.PanelRaised}"
                                        BorderBrush="{DynamicResource Brush.BorderLight}"
                                        BorderThickness="1"
                                        Classes="recent-info"
                                        ClipToBounds="True"
                                        CornerRadius="{DynamicResource Radius.Small}">
                                        <Image
                                            RenderOptions.BitmapInterpolationMode="HighQuality"
                                            Source="{Binding Thumbnail}"
                                            Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Classes="recent-info"
                                        Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource Brush.TextFaint}"
                                            Text="{Binding DisplayDirectory}"
                                            TextTrimming="PrefixCharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <controls:Codicon
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Brush.TextMuted}"
                                            IsVisible="{Binding IsPinned}"
                                            Kind="Pinned"
                                            Size="12"
                                            ToolTip.Tip="Pinned" />
                                        <controls:Codicon
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Brush.Warning}"
                                            IsVisible="{Binding !Exists}"
                                            Kind="Warning"
                                            Size="13" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource Brush.TextMuted}"
                                            Text="{Binding LastOpenedText}" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="3"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="recent-remove"
                                        Command="{Binding $parent[ListBox].DataContext.RemoveRecentProjectCommand}"
                                        CommandParameter="{Binding}"
                                        Focusable="False"
                                        ToolTip.Tip="Remove from list (the project stays on disk)">
                                        <controls:Codicon Kind="Close" Size="13" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>
            </DockPanel>
        </Grid>

        <!--  Opening a project  -->
        <Border Background="#B0000000" IsVisible="{Binding IsBusy}">
            <Border
                Padding="24,18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Brush.PanelRaised}"
                BorderBrush="{DynamicResource Brush.BorderLight}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Medium}">
                <StackPanel Width="280" Spacing="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{Binding BusyText}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="{Binding LoadStatusText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
