<Window
    x:Class="Hyperion.Editor.Views.ForegroundTaskWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:DataType="vm:ForegroundTaskViewModel"
    mc:Ignorable="d"
    Title="Hyperion Editor Tasks"
    SystemDecorations="None"
    Background="Transparent"
    TransparencyLevelHint="Transparent"
    CanResize="False"
    ShowInTaskbar="False"
    ShowActivated="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual">

    <Border
        Margin="24"
        Width="360"
        Padding="16"
        Opacity="{Binding CurrentTask.Opacity}"
        Background="{DynamicResource Brush.PanelRaised}"
        BorderBrush="{DynamicResource Brush.BorderLight}"
        BorderThickness="1"
        CornerRadius="{DynamicResource Radius.Large}"
        BoxShadow="0 16 40 -8 #AA000000">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
            </Transitions>
        </Border.Transitions>
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{DynamicResource Brush.Text}"
                    Text="{Binding CurrentTask.Title}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="{Binding CurrentTask.Description}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <ProgressBar
                    Height="6"
                    Maximum="1.0"
                    Minimum="0"
                    Value="{Binding CurrentTask.Progress}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="{Binding CurrentTask.Progress, StringFormat=Progress: {0:P0}}" />
            </StackPanel>

            <Button
                HorizontalAlignment="Right"
                Command="{Binding CancelCommand}"
                Content="Cancel"
                Padding="12,6" />
        </StackPanel>
    </Border>
</Window>
