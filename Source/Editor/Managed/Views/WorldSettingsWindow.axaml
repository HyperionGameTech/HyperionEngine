<Window
    x:Class="Hyperion.Editor.Views.WorldSettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Hyperion.Editor.Controls;assembly=Hyperion.Editor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inspector="clr-namespace:Hyperion.Editor.Views.Inspector;assembly=Hyperion.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:CompileBindings="False"
    x:DataType="vm:WorldSettingsPanelViewModel"
    mc:Ignorable="d"
    Title="World Settings"
    Width="700"
    Height="720"
    MinWidth="560"
    MinHeight="420"
    Background="{DynamicResource Brush.Background}">

    <DockPanel>
        <!--  Footer  -->
        <Border
            DockPanel.Dock="Bottom"
            Padding="12,8"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="OnCloseClick"
                        ToolTip.Tip="Close (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Close" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Search bar  -->
        <Border
            DockPanel.Dock="Top"
            Padding="12,8"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1">
                <TextBox
                    Padding="8,6"
                    Watermark="Search world settings"
                    Text="{Binding SearchText, Mode=TwoWay}">
                    <TextBox.InnerLeftContent>
                        <controls:Codicon
                            Margin="6,0,7,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Kind="Search"
                            Size="14" />
                    </TextBox.InnerLeftContent>
                </TextBox>
        </Border>

        <!--  Settings content  -->
        <ScrollViewer Padding="0">
            <StackPanel Margin="16,14" Spacing="14">
                <StackPanel Spacing="4">
                    <TextBlock Classes="section-label" Text="World Grid Layers" />
                    <TextBlock
                        Classes="muted"
                        FontSize="11"
                        Text="Manage streaming layers for the World."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    Padding="12,10"
                    Background="{DynamicResource Brush.PanelRaised}"
                    BorderBrush="{DynamicResource Brush.BorderLight}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Medium}"
                    IsVisible="{Binding !HasWorldGrid}">
                    <TextBlock
                        Classes="muted"
                        FontSize="11.5"
                        Text="World Grid is disabled on this world."
                        TextWrapping="Wrap" />
                </Border>

                <!--  No layers matching the current search  -->
                <TextBlock
                    Classes="muted"
                    FontSize="11.5"
                    IsVisible="{Binding ShowNoLayersHint}"
                    Text="No layers match the current search." />

                <ItemsControl ItemsSource="{Binding FilteredLayers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorldGridLayerViewModel">
                            <Border
                                Margin="0,0,0,8"
                                Background="{DynamicResource Brush.PanelRaised}"
                                BorderBrush="{DynamicResource Brush.BorderLight}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Medium}">
                                <StackPanel>
                                    <!--  Layer header  -->
                                    <Grid Margin="10,6" ColumnDefinitions="Auto,Auto,*,Auto">
                                        <ToggleButton
                                            Grid.Column="0"
                                            Classes="section-toggle"
                                            IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                            ToolTip.Tip="Toggle layer settings">
                                            <Panel Margin="4,0">
                                                <controls:Codicon
                                                    IsVisible="{Binding IsExpanded}"
                                                    Kind="ChevronDown"
                                                    Size="11" />
                                                <controls:Codicon
                                                    IsVisible="{Binding !IsExpanded}"
                                                    Kind="ChevronRight"
                                                    Size="11" />
                                            </Panel>
                                        </ToggleButton>

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <controls:Codicon
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource Brush.TextMuted}"
                                                Kind="{Binding IconKind}"
                                                Size="15" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayName}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="muted"
                                                FontSize="10.5"
                                                Text="{Binding TypeName}" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="3"
                                            Classes="gizmo"
                                            Command="{Binding $parent[ItemsControl].DataContext.RemoveLayerCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Remove layer (undoable)">
                                            <controls:Codicon Kind="Trash" Size="14" />
                                        </Button>
                                    </Grid>

                                    <!--  Layer settings -->
                                    <StackPanel
                                        Margin="14,0,12,10"
                                        IsVisible="{Binding IsExpanded}"
                                        Spacing="2">
                                        <Separator Margin="0,2,0,6" />
                                        <inspector:InspectorPropertyItemsControl ItemsSource="{Binding Properties}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DropDownButton
                    Classes="gizmo"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding HasWorldGrid}"
                    Click="OnAddLayerDropDownClick"
                    ToolTip.Tip="Add a new layer to the world grid">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Add Layer" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                      <Flyout Placement="Bottom">
                            <ItemsControl ItemsSource="{Binding AvailableLayerTypes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorldGridLayerTypeViewModel">
                                        <MenuItem
                                            Command="{Binding $parent[ItemsControl].DataContext.AddLayerTypeCommand}"
                                            CommandParameter="{Binding ClassName}"
                                            Header="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
