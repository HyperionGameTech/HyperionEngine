<Window
    x:Class="Hyperion.Editor.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Hyperion.Editor.Controls;assembly=Hyperion.Editor"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hyp="clr-namespace:Hyperion;assembly=Hyperion.Runtime"
    xmlns:inspector="clr-namespace:Hyperion.Editor.Views.Inspector;assembly=Hyperion.Editor"
    xmlns:local="clr-namespace:Hyperion.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Hyperion.Editor.Views;assembly=Hyperion.Editor"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:Name="Root"
    Title="Hyperion Editor"
    Icon="/Assets/Branding/hyperion-icon.ico"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    x:CompileBindings="False"
    x:DataType="vm:MainWindowViewModel"
    mc:Ignorable="d">

    <Window.Styles>
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6,6,0,0">
                        <ContentPresenter
                            Margin="6,2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Header}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="TabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <!--  Selected tab: show a bottom border (highlight) and slightly different background  -->
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <!--  Make the tab strip minimal height so tabs don't look flat/tall  -->
        <Style Selector="TabStrip">
            <Setter Property="Margin" Value="6,0,6,0" />
        </Style>

        <Style Selector="RadioButton.gizmo">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Small}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.gizmo:checked">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
        </Style>

        <Style Selector="RadioButton.gizmo:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
        </Style>

        <Style Selector="ToggleButton.gizmo">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Small}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.gizmo:checked">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
        </Style>

        <Style Selector="ToggleButton.gizmo:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
        </Style>

        <Style Selector="Button.gizmo">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Small}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.gizmo:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
        </Style>

        <Style Selector="Button.gizmo:pressed">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
        </Style>

        <Style Selector="DropDownButton.gizmo">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Small}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="DropDownButton.gizmo:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
        </Style>

        <Style Selector="DropDownButton.gizmo:pressed">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
        </Style>


        <Style Selector="Button.gizmo-wide">
          <Setter Property="MinHeight" Value="30" />
          <Setter Property="MinWidth" Value="30" />
          <Setter Property="Padding" Value="8,10" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Transitions">
            <Transitions />
          </Setter>
        </Style>

        <Style Selector="DropDownButton.gizmo-wide">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Radius.Small}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="DropDownButton.gizmo-wide:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
        </Style>

        <Style Selector="DropDownButton.gizmo-wide:pressed">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
        </Style>

        <Style Selector="DropDownButton.gizmo-wide.Primary">
            <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="DropDownButton.gizmo-wide.Primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.PrimaryHover}" />
        </Style>

        <Style Selector="DropDownButton.gizmo-wide.Primary:pressed">
            <Setter Property="Background" Value="{DynamicResource Brush.PrimaryMuted}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Border.mode-strip">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
            <Setter Property="Padding" Value="7,4" />
        </Style>

        <Style Selector="Border.toolbar Button, Border.toolbar ToggleButton, Border.toolbar RadioButton">
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style Selector="TextBlock.mode-label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>

        <Style Selector="TextBlock.mode-target">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="2,0,4,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        </Style>

        <Style Selector="Border.mode-separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="2,3" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
        </Style>

        <Style Selector="TextBlock.ribbon-label">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="LetterSpacing" Value="0.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style Selector="TextBlock.status-hint">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel Background="{DynamicResource Brush.Background}">
            <!--  Fallback in-window menu for non-macOS platforms (hidden: actions live in the toolbar)  -->
            <Menu DockPanel.Dock="Top" IsVisible="False">
                <MenuItem Header="_File">
                    <MenuItem
                        Command="{Binding NewProject}"
                        Header="_New Project..."
                        IsEnabled="{Binding !IsSimulating}" />
                    <MenuItem
                        Command="{Binding OpenProject}"
                        Header="_Open Project..."
                        IsEnabled="{Binding !IsSimulating}" />
                    <Separator />
                    <MenuItem
                        Command="{Binding SaveProject}"
                        Header="_Save Project"
                        IsEnabled="{Binding !IsSimulating}" />
                    <MenuItem
                        Command="{Binding SaveProjectAs}"
                        Header="Save Project _As..."
                        IsEnabled="{Binding !IsSimulating}" />
                    <Separator />
                    <MenuItem
                        Command="{Binding CloseProject}"
                        Header="Close Project"
                        IsEnabled="{Binding !IsSimulating}" />
                    <Separator />
                    <MenuItem Command="{Binding Exit}" Header="_Exit" />
                </MenuItem>
                <MenuItem Header="_Edit" IsEnabled="{Binding !IsSimulating}">
                    <MenuItem
                        Command="{Binding Undo}"
                        Header="{Binding UndoHeader}"
                        IsEnabled="{Binding CanUndo}" />
                    <MenuItem
                        Command="{Binding Redo}"
                        Header="{Binding RedoHeader}"
                        IsEnabled="{Binding CanRedo}" />
                    <Separator />
                    <MenuItem
                        Command="{Binding Copy}"
                        Header="{Binding CopyHeader}"
                        IsEnabled="{Binding CanCopy}" />
                    <MenuItem
                        Command="{Binding Paste}"
                        Header="{Binding PasteHeader}"
                        IsEnabled="{Binding CanPaste}" />
                    <MenuItem Command="{Binding Delete}" Header="{Binding DeleteHeader}" />
                    <Separator />
                    <MenuItem Command="{Binding SelectAll}" Header="Select _All" />
                    <MenuItem Command="{Binding SelectAllInViewport}" Header="Select All in Viewport" />
                    <MenuItem Command="{Binding SelectNone}" Header="Select None" />
                </MenuItem>
                <MenuItem Header="_Layout">
                    <MenuItem
                        Click="OnResetLayoutClick"
                        Header="_Reset Layout"
                        ToolTip.Tip="Restore the default dock layout" />
                </MenuItem>
                <MenuItem Header="_Build" IsEnabled="{Binding !IsSimulating}">
                    <MenuItem Command="{Binding BuildReflectionProbes}" Header="Reflection Probes" />
                    <MenuItem Command="{Binding BuildIrradianceProbes}" Header="Irradiance Probes" />
                    <Separator />
                    <MenuItem Command="{Binding BuildLightmaps}" Header="Lightmaps" />
                    <Separator />
                    <MenuItem Command="{Binding BuildStaticShadows}" Header="Static Shadows" />
                    <Separator />

                    <!-- Same as elsewhere. We don't actually USE BN in the engine yet. Commenting out for now to prevent any confusion. -->
                    <!-- <MenuItem Command="{Binding BuildBentNormals}" Header="Bent Normals" />
                    <Separator /> -->
                    <MenuItem Command="{Binding RebuildMeshBVHs}" Header="Rebuild Mesh BVHs" />
                    <Separator />
                    <MenuItem Command="{Binding CookGameContent}" Header="Cook Game Content" />
                </MenuItem>
            </Menu>

            <Border
                Padding="8,4"
                Classes="panel-header toolbar"
                DockPanel.Dock="Top">
                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Spacing="2">
                            <!-- <TextBlock Classes="ribbon-label" Text="PROJECT" /> -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button
                                    Classes="gizmo"
                                    Command="{Binding NewProject}"
                                    IsEnabled="{Binding !IsSimulating}"
                                    ToolTip.Tip="New Project">
                                    <controls:Codicon Kind="File" Size="16" />
                                </Button>
                                <Button
                                    Classes="gizmo"
                                    Command="{Binding OpenProject}"
                                    IsEnabled="{Binding !IsSimulating}"
                                    ToolTip.Tip="Open">
                                    <controls:Codicon Kind="FolderOpened" Size="16" />
                                </Button>
                                <Button
                                    Classes="gizmo"
                                    Command="{Binding SaveProject}"
                                    IsEnabled="{Binding !IsSimulating}"
                                    ToolTip.Tip="Save">
                                    <controls:Codicon Kind="Save" Size="16" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Border Classes="mode-separator" />

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Spacing="2">
                            <!-- <TextBlock Classes="ribbon-label" Text="EDIT" /> -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button
                                    Classes="gizmo"
                                    Command="{Binding Undo}"
                                    IsEnabled="{Binding CanUndo}"
                                    ToolTip.Tip="{Binding UndoHeader}">
                                    <controls:Codicon Kind="Discard" Size="16" />
                                </Button>
                                <Button
                                    Classes="gizmo"
                                    Command="{Binding Redo}"
                                    IsEnabled="{Binding CanRedo}"
                                    ToolTip.Tip="{Binding RedoHeader}">
                                    <controls:Codicon Kind="Redo" Size="16" />
                                </Button>
                                <Button
                                    Classes="gizmo"
                                    Command="{Binding Copy}"
                                    IsEnabled="{Binding CanCopy}"
                                    ToolTip.Tip="{Binding CopyHeader}">
                                    <controls:Codicon Kind="Copy" Size="16" />
                                </Button>
                                <Button
                                    Classes="gizmo"
                                    Command="{Binding Paste}"
                                    IsEnabled="{Binding CanPaste}"
                                    ToolTip.Tip="{Binding PasteHeader}">
                                    <controls:Codicon Kind="Clippy" Size="16" />
                                </Button>
                                <DropDownButton
                                    VerticalAlignment="Center"
                                    Classes="gizmo-wide"
                                    ToolTip.Tip="Select">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <controls:Codicon
                                            VerticalAlignment="Center"
                                            Kind="Select"
                                            Size="16" />
                                        <controls:Codicon
                                            VerticalAlignment="Center"
                                            Kind="ChevronDown"
                                            Size="10" />
                                    </StackPanel>
                                    <DropDownButton.Flyout>
                                        <Flyout Placement="Bottom">
                                            <StackPanel MinWidth="150">
                                                <MenuItem Command="{Binding SelectAll}" Header="Select All" />
                                                <MenuItem Command="{Binding SelectAllInViewport}" Header="Select All in Viewport" />
                                                <MenuItem Command="{Binding SelectNone}" Header="Select None" />
                                            </StackPanel>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                        </StackPanel>

                        <Border Classes="mode-separator" />

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Spacing="8">
                            <!-- <TextBlock Classes="ribbon-label" Text="LAYERS" /> -->
                            <DropDownButton
                                x:Name="ActiveLayersDropDown"
                                Classes="gizmo-wide"
                                ToolTip.Tip="Select active Layers">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <controls:Codicon
                                      VerticalAlignment="Center"
                                      Kind="Layers"
                                      Size="16" />
                                  <TextBlock
                                      VerticalAlignment="Center"
                                      FontSize="11"
                                      Text="Layers" />
                                  <controls:Codicon
                                      VerticalAlignment="Center"
                                      Kind="ChevronDown"
                                      Size="10" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <Flyout Placement="Bottom">
                                        <StackPanel MinWidth="150">
                                            <ItemsControl ItemsSource="{Binding ActiveLayerToggles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:LayerToggleViewModel">
                                                        <CheckBox
                                                            Classes="layers-toggle"
                                                            Content="{Binding Name}"
                                                            IsChecked="{Binding IsActive, Mode=TwoWay}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Separator />

                                            <MenuItem
                                                Command="{Binding AddNewLayerCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                Header="Add New Layer..."
                                                IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>

                        <Border Classes="mode-separator" />

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Spacing="8">
                            <!-- <TextBlock Classes="ribbon-label" Text="SWATCH" /> -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <DropDownButton
                                    x:Name="SwatchDropDown"
                                    VerticalAlignment="Center"
                                    Classes="gizmo-wide"
                                    ToolTip.Tip="Active Swatch">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <controls:Codicon
                                            VerticalAlignment="Center"
                                            Kind="Roller"
                                            Size="16" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Text="{Binding ActiveSwatchName, FallbackValue='Default'}" />
                                        <controls:Codicon
                                            VerticalAlignment="Center"
                                            Kind="ChevronDown"
                                            Size="10" />
                                    </StackPanel>
                                    <DropDownButton.Flyout>
                                        <Flyout Placement="Bottom">
                                            <StackPanel MinWidth="150">
                                                <ItemsControl ItemsSource="{Binding Swatches}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <MenuItem
                                                                Command="{Binding SetActiveSwatchCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                CommandParameter="{Binding}"
                                                                Header="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Separator />
                                                <MenuItem
                                                    Command="{Binding AddNewSwatchCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                    Header="New Swatch..."
                                                    IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                            </StackPanel>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>

                                <ToggleButton
                                    x:Name="SwatchOverrideModeToggle"
                                    Height="30"
                                    Padding="8,4"
                                    VerticalAlignment="Center"
                                    Classes="panel-toggle"
                                    IsChecked="{Binding Inspector.SwatchOverrideMode, Mode=TwoWay}"
                                    IsVisible="{Binding Inspector.CanUseSwatchOverrides}"
                                    ToolTip.Tip="When this toggle button is active, edits will apply as OVERRIDES for the active swatch. Otherwise edits will apply on base + active.">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <controls:Codicon
                                            VerticalAlignment="Center"
                                            Kind="GitBranch"
                                            Size="12" />
                                        <Panel>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="9"
                                                IsVisible="{Binding Inspector.SwatchOverrideMode}"
                                                Text="Override Edits: ON" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="9"
                                                IsVisible="{Binding !Inspector.SwatchOverrideMode}"
                                                Text="Override Edits: OFF" />
                                        </Panel>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </StackPanel>

                        <Border Classes="mode-separator" />

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Spacing="8">
                            <!-- <TextBlock Classes="ribbon-label" Text="BAKE" /> -->
                            <DropDownButton
                                VerticalAlignment="Center"
                                Classes="gizmo-wide"
                                IsEnabled="{Binding !IsSimulating}"
                                ToolTip.Tip="Bake">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:Codicon
                                        VerticalAlignment="Center"
                                        Kind="Heat"
                                        Size="16" />
                                    <TextBlock 
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="Bake" />
                                    <controls:Codicon
                                        VerticalAlignment="Center"
                                        Kind="ChevronDown"
                                        Size="10" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <Flyout Placement="Bottom">
                                        <StackPanel MinWidth="150">
                                            <MenuItem Command="{Binding BuildReflectionProbes}" Header="Reflection Probes" />
                                            <MenuItem Command="{Binding BuildIrradianceProbes}" Header="Irradiance Probes" />
                                            <Separator />
                                            <MenuItem Command="{Binding BuildLightmaps}" Header="Lightmaps" />
                                          
                                            <!-- Commenting out for now, as actual usage of BN in the engine is not yet surfaced. -->
                                            <!-- <Separator />
                                            <MenuItem Command="{Binding BuildBentNormals}" Header="Bent Normals" /> -->
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>

                        <Border Classes="mode-separator" />


                        <StackPanel VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                          <DropDownButton
                              x:Name="AddDropDown"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding !IsSimulating}"
                              Classes="gizmo-wide Primary"
                              Click="OnDropDownClick"
                              ToolTip.Tip="Add to the active scene">

                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <controls:Codicon
                                  VerticalAlignment="Center"
                                  Kind="Add"
                                  Size="16" />
                              <TextBlock
                                  VerticalAlignment="Center"
                                  FontSize="11"
                                  Text="Add" />
                            </StackPanel>

                            <!--  Populated from MainWindow.BuildAddSceneMenuEntries so this list isn't duplicated between here and the scene hierarchy's "Add" submenu  -->
                            <DropDownButton.ContextMenu>
                              <ContextMenu x:Name="AddSceneContextMenu" Placement="Bottom" />
                            </DropDownButton.ContextMenu>
                          </DropDownButton>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Spacing="2">
                            <!-- <TextBlock Classes="ribbon-label" Text="TRANSFORM" /> -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ToggleButton
                                    x:Name="TransformModeTranslate"
                                    Classes="gizmo"
                                    Command="{Binding SelectTransformModeTranslate}"
                                    IsChecked="{Binding IsTransformModeTranslateActive, Mode=OneWay}"
                                    IsEnabled="{Binding CanSelectTransformModeTranslate}"
                                    ToolTip.Tip="Translate">
                                    <controls:Codicon Kind="Move" Size="16" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="TransformModeRotate"
                                    Classes="gizmo"
                                    Command="{Binding SelectTransformModeRotate}"
                                    IsChecked="{Binding IsTransformModeRotateActive, Mode=OneWay}"
                                    IsEnabled="{Binding CanSelectTransformModeRotate}"
                                    ToolTip.Tip="Rotate">
                                    <controls:Codicon Kind="Refresh" Size="16" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="TransformModeScale"
                                    Classes="gizmo"
                                    Command="{Binding SelectTransformModeScale}"
                                    IsChecked="{Binding IsTransformModeScaleActive, Mode=OneWay}"
                                    IsEnabled="{Binding CanSelectTransformModeScale}"
                                    ToolTip.Tip="Scale">
                                    <controls:Codicon Kind="ScreenFull" Size="16" />
                                </ToggleButton>
                            </StackPanel>
                        </StackPanel>

                        <Border Classes="mode-separator" />

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Spacing="2">
                            <!-- <TextBlock Classes="ribbon-label" Text="EDIT" /> -->
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <ToggleButton
                                    x:Name="SnapToGridToggle"
                                    Classes="gizmo"
                                    Command="{Binding ToggleSnapToGrid}"
                                    IsChecked="{Binding IsSnapToGridEnabled, Mode=OneWay}"
                                    ToolTip.Tip="Snap Movement To Grid (1 Unit)">
                                    <controls:Codicon Kind="Magnet" Size="16" />
                                </ToggleButton>

                                <Border Classes="mode-separator" />

                                <ToggleButton
                                    x:Name="MeshEditModeToggle"
                                    Classes="gizmo"
                                    Command="{Binding ToggleMeshEditMode}"
                                    IsChecked="{Binding IsMeshEditModeEnabled, Mode=OneWay}"
                                    IsEnabled="{Binding CanEnableMeshEditMode}"
                                    ToolTip.Tip="{Binding MeshEditModeTooltip}">
                                    <controls:Codicon Kind="MeshEditMode" Size="16" />
                                </ToggleButton>

                                <Border Classes="mode-strip" IsVisible="{Binding IsMeshEditModeEnabled}">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <TextBlock
                                            MaxWidth="160"
                                            VerticalAlignment="Center"
                                            Classes="mode-target"
                                            Text="{Binding MeshEditTargetName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding MeshEditTargetName}" />

                                        <Border Classes="mode-separator" />

                                        <ToggleButton
                                            x:Name="MeshEditFaceModeTriangle"
                                            Classes="gizmo"
                                            Command="{Binding SelectMeshEditFaceTriangle}"
                                            IsChecked="{Binding !IsMeshEditFaceModeQuad, Mode=OneWay}"
                                            ToolTip.Tip="Edit triangle faces">
                                            <controls:Codicon Kind="TriangleRight" Size="16" />
                                        </ToggleButton>
                                        <ToggleButton
                                            x:Name="MeshEditFaceModeQuad"
                                            Classes="gizmo"
                                            Command="{Binding SelectMeshEditFaceQuad}"
                                            IsChecked="{Binding IsMeshEditFaceModeQuad, Mode=OneWay}"
                                            ToolTip.Tip="Edit as quads">
                                            <controls:Codicon Kind="PrimitiveSquare" Size="16" />
                                        </ToggleButton>

                                        <Border Classes="mode-separator" />

                                        <ToggleButton
                                            x:Name="MeshEditAlignToNormal"
                                            Classes="gizmo"
                                            Command="{Binding ToggleMeshEditAlignToNormal}"
                                            IsChecked="{Binding IsMeshEditAlignToNormal, Mode=OneWay}"
                                            ToolTip.Tip="Align to normal">
                                            <controls:Codicon Kind="AlignToNormal" Size="16" />
                                        </ToggleButton>

                                        <Border Classes="mode-separator" IsVisible="{Binding MeshEditHasMultipleLods}" />

                                        <DropDownButton
                                            x:Name="MeshEditLodDropDown"
                                            Classes="gizmo"
                                            Click="OnDropDownClick"
                                            IsVisible="{Binding MeshEditHasMultipleLods}"
                                            ToolTip.Tip="LOD being edited">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding MeshEditLodText}" />
                                                <controls:Codicon Kind="ChevronDown" Size="10" />
                                            </StackPanel>
                                            <DropDownButton.ContextMenu>
                                                <ContextMenu Placement="Bottom">
                                                    <MenuItem
                                                        Command="{Binding SetMeshEditLod}"
                                                        CommandParameter="0"
                                                        Header="LOD 0" />
                                                    <MenuItem
                                                        Command="{Binding SetMeshEditLod}"
                                                        CommandParameter="1"
                                                        Header="LOD 1" />
                                                    <MenuItem
                                                        Command="{Binding SetMeshEditLod}"
                                                        CommandParameter="2"
                                                        Header="LOD 2" />
                                                    <MenuItem
                                                        Command="{Binding SetMeshEditLod}"
                                                        CommandParameter="3"
                                                        Header="LOD 3" />
                                                </ContextMenu>
                                            </DropDownButton.ContextMenu>
                                        </DropDownButton>

                                        <Button
                                            x:Name="RegenerateMeshEditLodsButton"
                                            Classes="gizmo"
                                            Command="{Binding RegenerateMeshEditLods}"
                                            IsVisible="{Binding MeshEditLodsOutOfDate}"
                                            ToolTip.Tip="LODs are out of date - regenerate them from LOD 0">
                                            <controls:Codicon Kind="Refresh" Size="16" />
                                        </Button>

                                        <Border Classes="mode-separator" />

                                        <Button
                                            x:Name="SaveMeshEditsButton"
                                            Classes="gizmo"
                                            Command="{Binding SaveMeshEdits}"
                                            ToolTip.Tip="Save Edits">
                                            <controls:Codicon Kind="Check" Size="16" />
                                        </Button>
                                        <Button
                                            x:Name="DiscardMeshEditsButton"
                                            Classes="gizmo"
                                            Command="{Binding DiscardMeshEdits}"
                                            IsEnabled="{Binding HasPendingMeshEdits}"
                                            ToolTip.Tip="Discard Edits">
                                            <controls:Codicon Kind="Close" Size="16" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Classes="mode-separator" />

                                <DropDownButton
                                    x:Name="TerrainToolsDropDown"
                                    Classes="gizmo"
                                    Click="OnDropDownClick"
                                    ToolTip.Tip="Terrain Tools">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <controls:Codicon Kind="Landscape" Size="16" />
                                        <controls:Codicon Kind="ChevronDown" Size="10" />
                                    </StackPanel>
                                    <DropDownButton.ContextMenu>
                                        <ContextMenu Placement="Bottom">
                                            <MenuItem
                                                Command="{Binding ToggleTerrainSculptMode}"
                                                Header="Terrain Sculptor"
                                                IsChecked="{Binding IsSculptModeActive, Mode=OneWay}"
                                                IsEnabled="{Binding CanToggleTerrainSculptMode}"
                                                ToggleType="CheckBox"
                                                ToolTip.Tip="Toggle terrain sculpt mode" />
                                            <MenuItem
                                                Command="{Binding ToggleTerrainPaintMode}"
                                                Header="Terrain Painter"
                                                IsChecked="{Binding IsPaintModeActive, Mode=OneWay}"
                                                IsEnabled="{Binding CanToggleTerrainSculptMode}"
                                                ToggleType="CheckBox"
                                                ToolTip.Tip="Toggle terrain paint mode" />
                                            <Separator />
                                            <MenuItem
                                                Command="{Binding AddTerrainLayer}"
                                                Header="Add Terrain Layer"
                                                IsEnabled="{Binding CanAddTerrainLayer}"
                                                ToolTip.Tip="Add a terrain layer to the selected entity" />
                                        </ContextMenu>
                                    </DropDownButton.ContextMenu>
                                </DropDownButton>

                            </StackPanel>
                        </StackPanel>
                    </StackPanel>


                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">

                        <DropDownButton
                            x:Name="ToolDropDown"
                            VerticalAlignment="Center"
                            Classes="gizmo"
                            Click="OnDropDownClick"
                            ToolTip.Tip="Tool">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <controls:Codicon Kind="SettingsGear" Size="16" />
                                <controls:Codicon Kind="ChevronDown" Size="10" />
                            </StackPanel>
                            <DropDownButton.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem Header="World Settings"
                                              Click="OnWorldSettingsClick"
                                              ToolTip.Tip="Manage settings for the game's world" />
                                  
                                    <Separator />
                                    <MenuItem Header="{Binding ViewportLodText}" ToolTip.Tip="Mesh LOD shown in the viewport">
                                        <MenuItem
                                            Command="{Binding SetViewportLod}"
                                            CommandParameter="-1"
                                            Header="Auto"
                                            IsChecked="{Binding IsViewportLodAutomatic, Mode=OneWay}"
                                            ToggleType="CheckBox"
                                            ToolTip.Tip="Pick each mesh's LOD from its screen size" />
                                        <Separator />
                                        <MenuItem
                                            Command="{Binding SetViewportLod}"
                                            CommandParameter="0"
                                            Header="Force LOD 0" />
                                        <MenuItem
                                            Command="{Binding SetViewportLod}"
                                            CommandParameter="1"
                                            Header="Force LOD 1" />
                                        <MenuItem
                                            Command="{Binding SetViewportLod}"
                                            CommandParameter="2"
                                            Header="Force LOD 2" />
                                        <MenuItem
                                            Command="{Binding SetViewportLod}"
                                            CommandParameter="3"
                                            Header="Force LOD 3" />
                                    </MenuItem>

                                    <Separator />
                                    <MenuItem
                                        Command="{Binding ToggleGhostMode}"
                                        Header="Ghost Mode"
                                        IsChecked="{Binding IsGhostModeEnabled, Mode=OneWay}"
                                        IsEnabled="{Binding IsSimulating}"
                                        ToggleType="CheckBox"
                                        ToolTip.Tip="Free-fly through the world with no collision (WASD + Space/Ctrl to fly up/down). Only available while playing." />

                                    <MenuItem
                                        Command="{Binding ToggleShowStats}"
                                        Header="Show Stats"
                                        IsChecked="{Binding IsShowStatsEnabled, Mode=OneWay}"
                                        ToggleType="CheckBox"
                                        ToolTip.Tip="Show the engine stats overlay, in both editor and simulation mode" />

                                    <Separator />
                                    <MenuItem Header="Layout">
                                        <MenuItem
                                            Click="OnResetLayoutClick"
                                            Header="Reset Layout"
                                            ToolTip.Tip="Restore the default dock layout" />
                                    </MenuItem>
                                </ContextMenu>
                            </DropDownButton.ContextMenu>
                        </DropDownButton>

                        <Border Classes="mode-separator" />

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Spacing="2">
                            <!-- <TextBlock Classes="ribbon-label" Text="{Binding GameStateText}" /> -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button
                                    Classes="Play"
                                    Command="{Binding SetGameModePlaying}"
                                    IsVisible="{Binding CanSetGameModePlaying}"
                                    ToolTip.Tip="{Binding PlayTooltip}">
                                    <controls:Codicon
                                        Foreground="White"
                                        Kind="Play"
                                        Size="16" />
                                </Button>
                                <Button
                                    Padding="2,0"
                                    IsVisible="{Binding !IsSimulating}"
                                    ToolTip.Tip="Play options">
                                    <controls:Codicon Kind="ChevronDown" Size="10" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuItem
                                                Command="{Binding SetPlayNetModeStandalone}"
                                                Header="Standalone"
                                                IsChecked="{Binding IsPlayNetModeStandalone, Mode=OneWay}"
                                                ToggleType="CheckBox"
                                                ToolTip.Tip="Play locally with no network connection" />
                                            <MenuItem
                                                Command="{Binding SetPlayNetModeClient}"
                                                Header="Play As Client"
                                                IsChecked="{Binding IsPlayNetModeClient, Mode=OneWay}"
                                                ToggleType="CheckBox"
                                                ToolTip.Tip="Connect to the server set in Network Settings once play starts" />
                                            <MenuItem
                                                Command="{Binding SetPlayNetModeDedicatedServer}"
                                                Header="Play As Dedicated Server"
                                                IsChecked="{Binding IsPlayNetModeDedicatedServer, Mode=OneWay}"
                                                ToggleType="CheckBox"
                                                ToolTip.Tip="Host the play session as a server on the port set in Network Settings" />
                                            <Separator />
                                            <MenuItem
                                                Command="{Binding OpenNetworkSettings}"
                                                Header="Network Settings..." />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button
                                    Command="{Binding SetGameModePaused}"
                                    IsVisible="{Binding CanSetGameModePaused}"
                                    ToolTip.Tip="Pause">
                                    <controls:Codicon Kind="DebugPause" Size="16" />
                                </Button>
                                <Button
                                    Command="{Binding SetGameModeStopped}"
                                    IsVisible="{Binding CanSetGameModeStopped}"
                                    ToolTip.Tip="Stop">
                                    <controls:Codicon Kind="DebugStop" Size="16" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid RowDefinitions="*, Auto">
                <!--  Dockable workspace  -->
                <DockControl
                    x:Name="DockControl"
                    Grid.Row="0"
                    InitializeFactory="True"
                    InitializeLayout="True">
                    <DockControl.Factory>
                        <Factory HideDocumentsOnClose="True" HideToolsOnClose="True" />
                    </DockControl.Factory>

                    <RootDock
                        x:Name="DockRoot"
                        DefaultDockable="{Binding #MainLayout}"
                        Id="Root"
                        IsCollapsable="False">

                        <ProportionalDock
                            x:Name="MainLayout"
                            Id="MainLayout"
                            Orientation="Horizontal">

                            <!--  Left column: Scene hierarchy + Inspector  -->
                            <ProportionalDock
                                x:Name="Left"
                                Id="Left"
                                Orientation="Vertical"
                                Proportion="0.25">

                                <ToolDock
                                    x:Name="HierarchyPane"
                                    ActiveDockable="SceneHierarchyTool"
                                    Alignment="Left"
                                    Id="HierarchyPane">
                                    <Tool
                                        x:Name="SceneHierarchyTool"
                                        Title="Scene"
                                        Id="SceneHierarchy">
                                        <ContentControl DataContext="{Binding Source={x:Static vm:MainWindowViewModel.Instance}}">
                                            <Grid RowDefinitions="Auto, *">
                                                <Border Grid.Row="0" Classes="panel-header">
                                                    <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                                        <DropDownButton
                                                            x:Name="SceneDropDown"
                                                            Grid.Column="0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="Transparent"
                                                            BorderThickness="0">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <controls:Codicon
                                                                    Foreground="{StaticResource Brush.TextMuted}"
                                                                    Kind="ListTree"
                                                                    Size="14" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Classes="header"
                                                                    Text="{Binding ActiveScene.Name, FallbackValue='No Active Scene'}" />
                                                            </StackPanel>
                                                            <DropDownButton.Flyout>
                                                                <Flyout Placement="Bottom">
                                                                    <StackPanel MinWidth="150">
                                                                        <ItemsControl ItemsSource="{Binding Scenes}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:SceneViewModel">
                                                                                    <MenuItem
                                                                                        Command="{Binding SetActiveSceneCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Header="{Binding Name}" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <Separator />
                                                                        <MenuItem
                                                                            Command="{Binding AddNewSceneCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            Header="Add New Scene..."
                                                                            IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </DropDownButton.Flyout>
                                                        </DropDownButton>
                                                    </Grid>
                                                </Border>

                                                <TreeView
                                                    x:Name="SceneHierarchyTreeView"
                                                    Grid.Row="1"
                                                    ItemsSource="{Binding SceneHierarchy.RootNodes}"
                                                    SelectedItem="{Binding SceneHierarchy.SelectedNode}"
                                                    SelectionMode="Multiple">
                                                    <TreeView.ItemContainerTheme>
                                                        <ControlTheme
                                                            x:DataType="vm:NodeViewModel"
                                                            BasedOn="{StaticResource {x:Type TreeViewItem}}"
                                                            TargetType="TreeViewItem">
                                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                        </ControlTheme>
                                                    </TreeView.ItemContainerTheme>
                                                    <TreeView.ItemTemplate>
                                                        <TreeDataTemplate x:DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
                                                            <Grid HorizontalAlignment="Stretch" Background="Transparent">
                                                                <!--  Drop-target highlight: sits behind the label, shown during drag-over  -->
                                                                <Border
                                                                    Background="{DynamicResource Brush.Accent}"
                                                                    CornerRadius="3"
                                                                    IsVisible="{Binding IsDropTarget}"
                                                                    Opacity="0.35" />
                                                                <StackPanel
                                                                    Margin="2,2"
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal"
                                                                    Spacing="6">
                                                                    <Ellipse
                                                                        Width="6"
                                                                        Height="6"
                                                                        VerticalAlignment="Center"
                                                                        Fill="{DynamicResource Brush.Accent}"
                                                                        IsVisible="{Binding IsDirty}" />
                                                                    <controls:Codicon
                                                                        VerticalAlignment="Center"
                                                                        Kind="{Binding IconKind}"
                                                                        Opacity="0.7"
                                                                        Size="14" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontStyle="{Binding NameFontStyle}"
                                                                        IsVisible="{Binding !IsEditingName}"
                                                                        Text="{Binding DisplayName}" />
                                                                    <TextBox
                                                                        Name="NodeRenameTextBox"
                                                                        MinWidth="80"
                                                                        Padding="2,0"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding IsEditingName}"
                                                                        Text="{Binding EditingName, Mode=TwoWay}" />
                                                                </StackPanel>
                                                                <Grid.ContextMenu>
                                                                    <ContextMenu Opened="OnNodeContextMenuOpened">
                                                                        <!--  Submenu populated from MainWindow.BuildAddSceneMenuEntries - the same list the toolbar's Add dropdown uses  -->
                                                                        <MenuItem
                                                                            Header="Add"
                                                                            IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            Tag="AddSceneMenu" />
                                                                        <Separator />
                                                                        <MenuItem
                                                                            Command="{Binding Copy, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            Header="{Binding CopyHeader, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            IsVisible="{Binding !IsOutsideSelection}" />
                                                                        <!--  Right-clicking a volume leaves the selection alone, so Copy/Delete act on just the volume  -->
                                                                        <MenuItem
                                                                            Command="{Binding Copy, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            CommandParameter="{Binding UUID}"
                                                                            Header="_Copy"
                                                                            IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            IsVisible="{Binding IsOutsideSelection}" />
                                                                        <MenuItem
                                                                            Command="{Binding Paste, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            Header="{Binding PasteHeader, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                        <Separator />
                                                                        <MenuItem
                                                                            Click="OnRenameNodeMenuItemClick"
                                                                            Header="Rename"
                                                                            IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                        <MenuItem
                                                                            Command="{Binding TeleportToNode, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            CommandParameter="{Binding UUID}"
                                                                            Header="Teleport to"
                                                                            IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                        <MenuItem
                                                                            Command="{Binding MoveToCameraNode, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            CommandParameter="{Binding UUID}"
                                                                            Header="Move to camera"
                                                                            IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                        <MenuItem
                                                                            Click="OnMoveToGrandparentMenuItemClick"
                                                                            Header="{Binding MoveToGrandparentHeader}"
                                                                            IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            IsVisible="{Binding CanMoveToGrandparent}" />
                                                                        <Separator />
                                                                        <MenuItem
                                                                            Header="Move to scene"
                                                                            IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            IsVisible="{Binding HasMoveToSceneTargets}"
                                                                            ItemsSource="{Binding MoveToSceneTargets}">
                                                                            <MenuItem.ItemContainerTheme>
                                                                                <ControlTheme
                                                                                    x:DataType="vm:MoveToSceneItemViewModel"
                                                                                    BasedOn="{StaticResource {x:Type MenuItem}}"
                                                                                    TargetType="MenuItem">
                                                                                    <Setter Property="Header" Value="{Binding SceneName}" />
                                                                                    <Setter Property="Command" Value="{Binding MoveToSceneCommand}" />
                                                                                </ControlTheme>
                                                                            </MenuItem.ItemContainerTheme>
                                                                        </MenuItem>
                                                                        <Separator />
                                                                        <MenuItem Header="Collision" IsEnabled="{Binding HasCollisionActions}">
                                                                            <MenuItem
                                                                                Command="{Binding GenerateConvexCollision, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                CommandParameter="{Binding UUID}"
                                                                                Header="Generate Convex Collision"
                                                                                IsEnabled="{Binding CanGenerateCollision}"
                                                                                ToolTip.Tip="Decompose this entity's mesh into convex hulls and use them as its collision shape" />
                                                                            <MenuItem
                                                                                Command="{Binding FitCollisionToMesh, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                CommandParameter="{Binding UUID}"
                                                                                Header="Fit Box To Mesh"
                                                                                IsEnabled="{Binding CanFitCollisionToMesh}"
                                                                                ToolTip.Tip="Resize this entity's box collision to match its mesh bounds" />
                                                                        </MenuItem>
                                                                        <MenuItem
                                                                            Command="{Binding FitVolumeToSelection, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            CommandParameter="{Binding UUID}"
                                                                            Header="{Binding FitVolumeToSelectionHeader}"
                                                                            IsEnabled="{Binding CanFitVolumeToSelection}"
                                                                            IsVisible="{Binding IsVolume}"
                                                                            ToolTip.Tip="Resize this volume to the world-space bounds of the selected nodes" />
                                                                        <Separator IsVisible="{Binding HasActions}" />
                                                                        <MenuItem
                                                                            Header="Actions"
                                                                            IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            IsVisible="{Binding HasActions}"
                                                                            ItemsSource="{Binding Actions}">
                                                                            <MenuItem.ItemContainerTheme>
                                                                                <ControlTheme
                                                                                    x:DataType="vm:InspectorActionViewModel"
                                                                                    BasedOn="{StaticResource {x:Type MenuItem}}"
                                                                                    TargetType="MenuItem">
                                                                                    <Setter Property="Header" Value="{Binding Label}" />
                                                                                    <Setter Property="Command" Value="{Binding ExecuteActionCommand}" />
                                                                                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                                                                </ControlTheme>
                                                                            </MenuItem.ItemContainerTheme>
                                                                        </MenuItem>
                                                                        <Separator />
                                                                        <MenuItem
                                                                            Command="{Binding DeleteNode, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            Header="{Binding DeleteHeader, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            IsVisible="{Binding !IsOutsideSelection}" />
                                                                        <MenuItem
                                                                            Command="{Binding DeleteNode, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            CommandParameter="{Binding UUID}"
                                                                            Header="_Delete"
                                                                            IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            IsVisible="{Binding IsOutsideSelection}" />
                                                                    </ContextMenu>
                                                                </Grid.ContextMenu>
                                                            </Grid>
                                                        </TreeDataTemplate>
                                                    </TreeView.ItemTemplate>
                                                </TreeView>
                                            </Grid>
                                        </ContentControl>
                                    </Tool>
                                </ToolDock>

                                <ProportionalDockSplitter x:Name="LeftSplitter" Id="LeftSplitter" />

                                <ToolDock
                                    x:Name="InspectorPane"
                                    ActiveDockable="InspectorTool"
                                    Alignment="Bottom"
                                    Id="InspectorPane">
                                    <Tool
                                        x:Name="InspectorTool"
                                        Title="Inspector"
                                        Id="Inspector">
                                        <ContentControl DataContext="{Binding Source={x:Static vm:MainWindowViewModel.Instance}}">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Spacing="8">
                                                    <Grid
                                                        Margin="0"
                                                        DataContext="{Binding Inspector}"
                                                        IsVisible="{Binding IsEntity}"
                                                        RowDefinitions="Auto, Auto, Auto">

                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <ToggleButton
                                                                    Grid.Column="0"
                                                                    Classes="section-toggle"
                                                                    IsChecked="{Binding ComponentsSection.IsExpanded, Mode=TwoWay}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <controls:Codicon
                                                                            Margin="2,2,0,0"
                                                                            Kind="{Binding ComponentsSection.ChevronKind}"
                                                                            Size="10" />
                                                                        <TextBlock
                                                                            VerticalAlignment="Center"
                                                                            Classes="header"
                                                                            Text="Components" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <Button
                                                                    Grid.Column="1"
                                                                    Margin="0,0,4,0"
                                                                    Padding="8,2"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Content="Add"
                                                                    IsEnabled="{Binding HasAddableComponents}">
                                                                    <Button.Flyout>
                                                                        <MenuFlyout ItemsSource="{Binding AddableComponents}">
                                                                            <MenuFlyout.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:AddComponentOptionViewModel">
                                                                                    <MenuItem
                                                                                        Command="{Binding Inspector.AddComponentCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Header="{Binding Label}"
                                                                                        IsEnabled="{Binding IsEnabled}" />
                                                                                </DataTemplate>
                                                                            </MenuFlyout.ItemTemplate>
                                                                        </MenuFlyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                        </Border>

                                                        <ItemsControl
                                                            Grid.Row="1"
                                                            Margin="12,6"
                                                            ItemsSource="{Binding Components}">
                                                            <ItemsControl.IsVisible>
                                                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                                    <Binding Path="HasComponents" />
                                                                    <Binding Path="ComponentsSection.IsExpanded" />
                                                                </MultiBinding>
                                                            </ItemsControl.IsVisible>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:InspectorComponentViewModelBase">
                                                                    <Border
                                                                        Margin="0,0,0,6"
                                                                        Padding="10"
                                                                        Background="{DynamicResource Brush.PanelRaised}"
                                                                        BorderBrush="{DynamicResource Brush.BorderLight}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{DynamicResource Radius.Medium}">
                                                                        <StackPanel Spacing="6">
                                                                            <Grid ColumnDefinitions="*,Auto">
                                                                                <TextBlock
                                                                                    Grid.Column="0"
                                                                                    VerticalAlignment="Center"
                                                                                    FontSize="12"
                                                                                    FontWeight="SemiBold"
                                                                                    Text="{Binding Label}" />
                                                                                <Button
                                                                                    Grid.Column="1"
                                                                                    Padding="4,2"
                                                                                    Command="{Binding Inspector.RemoveComponentCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    ToolTip.Tip="Remove component">
                                                                                    <controls:Codicon Kind="Trash" Size="14" />
                                                                                </Button>
                                                                            </Grid>

                                                                            <!--  Component-level scalar properties  -->
                                                                            <inspector:InspectorPropertyItemsControl IsVisible="{Binding HasProperties}" ItemsSource="{Binding Properties}" />

                                                                            <!--  Sub-object groups (Mesh, Material, etc.)  -->
                                                                            <ItemsControl IsVisible="{Binding HasSubObjects}" ItemsSource="{Binding SubObjects}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:ComponentSubObjectViewModel">
                                                                                        <StackPanel Margin="0,4,0,0" Spacing="2">
                                                                                            <TextBlock
                                                                                                Margin="0,2,0,2"
                                                                                                FontWeight="SemiBold"
                                                                                                Text="{Binding Label}" />
                                                                                            <inspector:InspectorPropertyItemsControl IsVisible="{Binding HasProperties}" ItemsSource="{Binding Properties}" />
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>

                                                    <Grid
                                                        Margin="0"
                                                        DataContext="{Binding Inspector}"
                                                        IsVisible="{Binding IsEntity}"
                                                        RowDefinitions="Auto, Auto, Auto">

                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <ToggleButton Classes="section-toggle" IsChecked="{Binding TagsSection.IsExpanded, Mode=TwoWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <controls:Codicon
                                                                        Margin="2,2,0,0"
                                                                        Kind="{Binding TagsSection.ChevronKind}"
                                                                        Size="10" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        Classes="header"
                                                                        Text="Tags" />
                                                                </StackPanel>
                                                            </ToggleButton>
                                                        </Border>

                                                        <Grid
                                                            Grid.Row="1"
                                                            Margin="12,6,12,6"
                                                            ColumnDefinitions="*,Auto"
                                                            IsVisible="{Binding TagsSection.IsExpanded}">
                                                            <ComboBox
                                                                Grid.Column="0"
                                                                Margin="0,0,6,0"
                                                                HorizontalAlignment="Stretch"
                                                                IsEnabled="{Binding EntityTags.HasAvailableTags}"
                                                                ItemsSource="{Binding EntityTags.AvailableTags}"
                                                                PlaceholderText="Add tag"
                                                                SelectedItem="{Binding EntityTags.SelectedAvailableTag, Mode=TwoWay}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:EntityTagOptionViewModel">
                                                                        <TextBlock Text="{Binding Name}" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <Button
                                                                Grid.Column="1"
                                                                Padding="8,2"
                                                                Command="{Binding EntityTags.AddTagCommand}"
                                                                CommandParameter="{Binding EntityTags.SelectedAvailableTag}"
                                                                Content="Add" />
                                                        </Grid>

                                                        <ItemsControl
                                                            Grid.Row="2"
                                                            Margin="12,6,12,6"
                                                            ItemsSource="{Binding EntityTags.Tags}">
                                                            <ItemsControl.IsVisible>
                                                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                                    <Binding Path="EntityTags.HasTags" />
                                                                    <Binding Path="TagsSection.IsExpanded" />
                                                                </MultiBinding>
                                                            </ItemsControl.IsVisible>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:EntityTagItemViewModel">
                                                                    <Border
                                                                        Margin="0,0,0,6"
                                                                        Padding="8,4"
                                                                        Background="{DynamicResource Brush.PanelRaised}"
                                                                        BorderBrush="{DynamicResource Brush.BorderLight}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{DynamicResource Radius.Medium}">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock
                                                                                Grid.Column="0"
                                                                                VerticalAlignment="Center"
                                                                                FontSize="12"
                                                                                Text="{Binding Name}" />
                                                                            <Button
                                                                                Grid.Column="1"
                                                                                Padding="4,2"
                                                                                Command="{Binding Inspector.EntityTags.RemoveTagCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip.Tip="Remove tag">
                                                                                <controls:Codicon Kind="Trash" Size="14" />
                                                                            </Button>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>

                                                    <Grid
                                                        Margin="0"
                                                        DataContext="{Binding Inspector}"
                                                        IsVisible="{Binding IsEntity}"
                                                        RowDefinitions="Auto, Auto, Auto">

                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <ToggleButton
                                                                    Grid.Column="0"
                                                                    Classes="section-toggle"
                                                                    IsChecked="{Binding LayersSection.IsExpanded, Mode=TwoWay}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <controls:Codicon
                                                                            Margin="2,2,0,0"
                                                                            Kind="{Binding LayersSection.ChevronKind}"
                                                                            Size="10" />
                                                                        <TextBlock
                                                                            VerticalAlignment="Center"
                                                                            Classes="header"
                                                                            Text="Layers" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <Button
                                                                    Grid.Column="1"
                                                                    Margin="0,0,4,0"
                                                                    Padding="8,2"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Content="Add">
                                                                    <Button.Flyout>
                                                                        <Flyout Placement="Bottom">
                                                                            <StackPanel MinWidth="150">
                                                                                <ItemsControl ItemsSource="{Binding EntityLayers.AvailableLayers}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="vm:EntityLayerOptionViewModel">
                                                                                            <MenuItem
                                                                                                Command="{Binding Inspector.EntityLayers.AddLayerCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Header="{Binding Name}" />
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>

                                                                                <Separator />
                                                                                <MenuItem Command="{Binding Inspector.EntityLayers.CreateNewLayerCommand, Source={x:Static vm:MainWindowViewModel.Instance}}" Header="New Layer..." />
                                                                            </StackPanel>
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                        </Border>

                                                        <ItemsControl
                                                            Grid.Row="1"
                                                            Margin="12,6,12,6"
                                                            ItemsSource="{Binding EntityLayers.Layers}">
                                                            <ItemsControl.IsVisible>
                                                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                                    <Binding Path="EntityLayers.HasLayers" />
                                                                    <Binding Path="LayersSection.IsExpanded" />
                                                                </MultiBinding>
                                                            </ItemsControl.IsVisible>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:EntityLayerItemViewModel">
                                                                    <Border
                                                                        Margin="0,0,0,6"
                                                                        Padding="8,4"
                                                                        Background="{DynamicResource Brush.PanelRaised}"
                                                                        BorderBrush="{DynamicResource Brush.BorderLight}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{DynamicResource Radius.Medium}">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock
                                                                                Grid.Column="0"
                                                                                VerticalAlignment="Center"
                                                                                FontSize="12"
                                                                                Text="{Binding Name}" />
                                                                            <Button
                                                                                Grid.Column="1"
                                                                                Padding="4,2"
                                                                                Command="{Binding Inspector.EntityLayers.RemoveLayerCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip.Tip="Remove from layer">
                                                                                <controls:Codicon Kind="Trash" Size="14" />
                                                                            </Button>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>

                                                    <Grid
                                                        Margin="0"
                                                        IsVisible="{Binding Inspector.HasAttachedScript}"
                                                        RowDefinitions="Auto, Auto">
                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <ToggleButton Classes="section-toggle" IsChecked="{Binding Inspector.ScriptSection.IsExpanded, Mode=TwoWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <controls:Codicon
                                                                        Margin="2,2,0,0"
                                                                        Kind="{Binding Inspector.ScriptSection.ChevronKind}"
                                                                        Size="10" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        Classes="header"
                                                                        Text="Script" />
                                                                </StackPanel>
                                                            </ToggleButton>
                                                        </Border>

                                                        <StackPanel Grid.Row="1" IsVisible="{Binding Inspector.ScriptSection.IsExpanded}">
                                                            <Grid
                                                                Margin="12,6,12,4"
                                                                ColumnDefinitions="72,*"
                                                                DataContext="{Binding Inspector.AttachedScript}">
                                                                <Border
                                                                    Width="64"
                                                                    Height="64"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Top"
                                                                    Background="{DynamicResource Brush.PanelRaised}"
                                                                    BorderBrush="{DynamicResource Brush.BorderLight}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{DynamicResource Radius.Medium}">
                                                                    <controls:Codicon
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource Brush.AccentHover}"
                                                                        Kind="FileCode"
                                                                        Opacity="0.85"
                                                                        Size="28" />
                                                                </Border>

                                                                <StackPanel Grid.Column="1" Spacing="4">
                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        FontWeight="SemiBold"
                                                                        Text="{Binding ScriptDisplay}" />

                                                                    <Border
                                                                        Padding="6,5"
                                                                        Background="{DynamicResource Brush.PanelRaised}"
                                                                        BorderBrush="{DynamicResource Brush.BorderLight}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{DynamicResource Radius.Small}">
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            Text="{Binding AssetPathDisplay}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </Border>

                                                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                                                                            <Button
                                                                                Classes="gizmo"
                                                                                Command="{Binding SelectCommand}"
                                                                                IsEnabled="{Binding CanSelectFromContentBrowser}"
                                                                                ToolTip.Tip="Swap with selected">
                                                                                <controls:Codicon Kind="Swap" Size="14" />
                                                                            </Button>
                                                                            <Button
                                                                                Classes="gizmo"
                                                                                Command="{Binding ClearCommand}"
                                                                                IsEnabled="{Binding HasScript}"
                                                                                ToolTip.Tip="Clear">
                                                                                <controls:Codicon Kind="Close" Size="14" />
                                                                            </Button>
                                                                            <Button
                                                                                Classes="gizmo"
                                                                                Command="{Binding NewCommand}"
                                                                                ToolTip.Tip="Create new script">
                                                                                <controls:Codicon Kind="Add" Size="14" />
                                                                            </Button>
                                                                            <Button
                                                                                Classes="gizmo"
                                                                                Command="{Binding EditCommand}"
                                                                                IsEnabled="{Binding HasScript}"
                                                                                ToolTip.Tip="Open in code editor">
                                                                                <controls:Codicon Kind="Edit" Size="14" />
                                                                            </Button>
                                                                        </StackPanel>

                                                                        <Border
                                                                            Grid.Column="1"
                                                                            Width="1"
                                                                            Margin="6,5"
                                                                            Background="{DynamicResource Brush.Border}" />

                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                                                            <Button
                                                                                Classes="gizmo"
                                                                                Command="{Binding CopyCommand}"
                                                                                IsEnabled="{Binding CanCopy}"
                                                                                ToolTip.Tip="Copy asset path to clipboard">
                                                                                <controls:Codicon Kind="Copy" Size="14" />
                                                                            </Button>
                                                                            <Button
                                                                                Classes="gizmo"
                                                                                Command="{Binding PasteCommand}"
                                                                                ToolTip.Tip="Paste asset path from clipboard">
                                                                                <controls:Codicon Kind="Clippy" Size="14" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid
                                                        Margin="0"
                                                        IsVisible="{Binding Inspector.HasActions}"
                                                        RowDefinitions="Auto, Auto">
                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <ToggleButton Classes="section-toggle" IsChecked="{Binding Inspector.ActionsSection.IsExpanded, Mode=TwoWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <controls:Codicon
                                                                        Margin="2,2,0,0"
                                                                        Kind="{Binding Inspector.ActionsSection.ChevronKind}"
                                                                        Size="10" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        Classes="header"
                                                                        Text="Actions" />
                                                                </StackPanel>
                                                            </ToggleButton>
                                                        </Border>

                                                        <ItemsControl
                                                            Grid.Row="1"
                                                            VerticalAlignment="Top"
                                                            ItemsSource="{Binding Inspector.Actions}">
                                                            <ItemsControl.IsVisible>
                                                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                                    <Binding Path="Inspector.HasActions" />
                                                                    <Binding Path="Inspector.ActionsSection.IsExpanded" />
                                                                </MultiBinding>
                                                            </ItemsControl.IsVisible>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:InspectorActionViewModel">
                                                                    <Button
                                                                        Margin="12,6,12,0"
                                                                        Padding="10,4"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Center"
                                                                        Command="{Binding ExecuteActionCommand}"
                                                                        Content="{Binding Label}"
                                                                        IsEnabled="{Binding IsEnabled}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>

                                                    <!--  Scene Properties (shown when root node is selected)  -->
                                                    <Grid
                                                        Margin="0"
                                                        IsVisible="{Binding Inspector.HasSceneProperties}"
                                                        RowDefinitions="Auto, Auto">
                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <ToggleButton Classes="section-toggle" IsChecked="{Binding Inspector.ScenePropertiesSection.IsExpanded, Mode=TwoWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <controls:Codicon
                                                                        Margin="2,2,0,0"
                                                                        Kind="{Binding Inspector.ScenePropertiesSection.ChevronKind}"
                                                                        Size="10" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        Classes="header"
                                                                        Text="Scene Properties" />
                                                                </StackPanel>
                                                            </ToggleButton>
                                                        </Border>
                                                        <inspector:InspectorPropertyItemsControl Grid.Row="1" ItemsSource="{Binding Inspector.SceneProperties}">
                                                            <inspector:InspectorPropertyItemsControl.IsVisible>
                                                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                                    <Binding Path="Inspector.HasSceneProperties" />
                                                                    <Binding Path="Inspector.ScenePropertiesSection.IsExpanded" />
                                                                </MultiBinding>
                                                            </inspector:InspectorPropertyItemsControl.IsVisible>
                                                        </inspector:InspectorPropertyItemsControl>
                                                    </Grid>

                                                    <!--  Swatch Overrides (per-entity edit routing + copy)  -->
                                                    <Grid
                                                        Margin="0"
                                                        DataContext="{Binding Inspector}"
                                                        IsVisible="{Binding IsEntity}"
                                                        RowDefinitions="Auto, Auto">
                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <ToggleButton
                                                                    Grid.Column="0"
                                                                    Classes="section-toggle"
                                                                    IsChecked="{Binding SwatchOverridesSection.IsExpanded, Mode=TwoWay}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <controls:Codicon
                                                                            Margin="2,2,0,0"
                                                                            Kind="{Binding SwatchOverridesSection.ChevronKind}"
                                                                            Size="10" />
                                                                        <TextBlock
                                                                            VerticalAlignment="Center"
                                                                            Classes="header"
                                                                            Text="Swatch Overrides" />
                                                                    </StackPanel>
                                                                </ToggleButton>
                                                                <Border
                                                                    Grid.Column="1"
                                                                    Margin="6,0,4,0"
                                                                    Padding="6,1"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource Brush.AccentSubtle}"
                                                                    BorderBrush="{DynamicResource Brush.Accent}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{DynamicResource Radius.Large}"
                                                                    IsVisible="{Binding HasOverriddenProperties}">
                                                                    <TextBlock
                                                                        FontSize="10"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource Brush.AccentHover}"
                                                                        Text="{Binding OverriddenPropertyCount}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel
                                                            Grid.Row="1"
                                                            Margin="12,8,12,10"
                                                            IsVisible="{Binding SwatchOverridesSection.IsExpanded}"
                                                            Spacing="10">
                                                            <StackPanel IsVisible="{Binding HasOverriddenProperties}" Spacing="4">
                                                                <TextBlock
                                                                    Classes="section-label"
                                                                    Text="{Binding OverriddenPropertiesHeader}"
                                                                    TextTrimming="CharacterEllipsis" />

                                                                <ItemsControl ItemsSource="{Binding OverriddenProperties}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:InspectorPropertyViewModelBase">
                                                                            <Grid Margin="0,1" ColumnDefinitions="Auto,*,Auto">
                                                                                <Border
                                                                                    Grid.Column="0"
                                                                                    Width="2"
                                                                                    Margin="0,1,7,1"
                                                                                    Background="{DynamicResource Brush.Accent}"
                                                                                    CornerRadius="1" />
                                                                                <TextBlock
                                                                                    Grid.Column="1"
                                                                                    VerticalAlignment="Center"
                                                                                    FontSize="11"
                                                                                    Text="{Binding Label}"
                                                                                    TextTrimming="CharacterEllipsis"
                                                                                    ToolTip.Tip="{Binding OverrideTooltip}" />
                                                                                <Button
                                                                                    Grid.Column="2"
                                                                                    Classes="reset-icon"
                                                                                    Command="{Binding RevertOverrideCommand}"
                                                                                    ToolTip.Tip="Revert to base value">
                                                                                    <Path
                                                                                        Width="11"
                                                                                        Height="11"
                                                                                        Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z"
                                                                                        Stretch="Uniform" />
                                                                                </Button>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <Button
                                                                        Grid.Column="0"
                                                                        Padding="8,2"
                                                                        VerticalAlignment="Center"
                                                                        Command="{Binding ResetSwatchOverridesCommand}"
                                                                        Content="Revert All"
                                                                        ToolTip.Tip="Revert swatch-specific property overrides back to base values." />
                                                                </Grid>

                                                            </StackPanel>

                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{DynamicResource Brush.TextFaint}"
                                                                IsVisible="{Binding ShowNoOverridesHint}"
                                                                Text="No properties overridden on this swatch."
                                                                TextWrapping="Wrap" />

                                                            <StackPanel Spacing="5">
                                                                <TextBlock Classes="section-label" Text="Copy properties from other swatch" />
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <ComboBox
                                                                        Grid.Column="0"
                                                                        Margin="0,0,6,0"
                                                                        HorizontalAlignment="Stretch"
                                                                        IsEnabled="{Binding HasCopySwatchSources}"
                                                                        ItemsSource="{Binding CopySwatchSources}"
                                                                        PlaceholderText="Select swatch"
                                                                        SelectedItem="{Binding SelectedCopySwatchSource, Mode=TwoWay}">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:SwatchCopySourceOptionViewModel">
                                                                                <TextBlock Text="{Binding Name}" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <Button
                                                                        Grid.Column="1"
                                                                        Padding="8,2"
                                                                        Command="{Binding ApplyCopyFromSwatchCommand}"
                                                                        Content="Apply"
                                                                        ToolTip.Tip="Copy the selected source's property values onto the current edit target" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!--  Properties  -->
                                                    <Grid Margin="0" RowDefinitions="Auto, Auto, Auto">
                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <ToggleButton Classes="section-toggle" IsChecked="{Binding Inspector.PropertiesSection.IsExpanded, Mode=TwoWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <controls:Codicon
                                                                        Margin="2,2,0,0"
                                                                        Kind="{Binding Inspector.PropertiesSection.ChevronKind}"
                                                                        Size="10" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        Classes="header"
                                                                        Text="Properties" />
                                                                </StackPanel>
                                                            </ToggleButton>
                                                        </Border>
                                                        <inspector:InspectorPropertyItemsControl
                                                            Grid.Row="1"
                                                            IsVisible="{Binding Inspector.PropertiesSection.IsExpanded}"
                                                            ItemsSource="{Binding Inspector.Properties}" />
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </ContentControl>
                                    </Tool>
                                </ToolDock>

                            </ProportionalDock>

                            <ProportionalDockSplitter x:Name="MainSplitter1" Id="MainSplitter1" />

                            <!--  Center column: Scene document + bottom panel (Assets/Console)  -->
                            <ProportionalDock
                                x:Name="Center"
                                Id="Center"
                                Orientation="Vertical">

                                <DocumentDock
                                    x:Name="Documents"
                                    ActiveDockable="SceneDoc"
                                    CanCreateDocument="True"
                                    Id="Documents">
                                    <Document
                                        x:Name="SceneDoc"
                                        Title="Viewport"
                                        CanClose="False"
                                        CanDrag="False"
                                        CanFloat="False"
                                        CanPin="False"
                                        Id="Scene">
                                        <Grid>
                                            <Border
                                                x:Name="ViewportDropTarget"
                                                Background="{DynamicResource Brush.Background}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="0">
                                                <local:EditorViewportControl
                                                    x:Name="EditorViewportControl"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch" />
                                            </Border>
                                        </Grid>
                                    </Document>
                                </DocumentDock>

                                <ProportionalDockSplitter x:Name="CenterSplitter" Id="CenterSplitter" />

                                <ProportionalDock
                                    x:Name="Bottom"
                                    Id="Bottom"
                                    Orientation="Horizontal"
                                    Proportion="0.3">

                                    <ToolDock
                                        x:Name="AssetsPane"
                                        ActiveDockable="AssetsTool"
                                        Alignment="Left"
                                        Id="AssetsPane">
                                        <Tool
                                            x:Name="AssetsTool"
                                            Title="Assets"
                                            Id="ContentBrowser">
                                            <ContentControl DataContext="{Binding Source={x:Static vm:MainWindowViewModel.Instance}}">
                                                <DockPanel>
                                                    <Border
                                                        Height="36"
                                                        Classes="panel-header"
                                                        DockPanel.Dock="Top">
                                                        <Grid VerticalAlignment="Center" ColumnDefinitions="*, Auto, Auto, Auto">
                                                            <TextBox
                                                                Grid.Column="0"
                                                                MaxWidth="260"
                                                                Margin="0,0,8,0"
                                                                Padding="4,2"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                Text="{Binding ContentBrowser.SearchText, Mode=TwoWay}"
                                                                ToolTip.Tip="Filter the assets in this bucket by name"
                                                                Watermark="Search assets...">
                                                                <TextBox.InnerLeftContent>
                                                                    <controls:Codicon
                                                                        Margin="6,0,4,0"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource Brush.TextMuted}"
                                                                        Kind="Search"
                                                                        Size="12" />
                                                                </TextBox.InnerLeftContent>
                                                                <TextBox.InnerRightContent>
                                                                    <Button
                                                                        Margin="2,0"
                                                                        Padding="3"
                                                                        VerticalAlignment="Center"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Command="{Binding ContentBrowser.ClearSearchCommand}"
                                                                        IsVisible="{Binding ContentBrowser.HasSearchText}"
                                                                        ToolTip.Tip="Clear search">
                                                                        <controls:Codicon
                                                                            Foreground="{DynamicResource Brush.TextMuted}"
                                                                            Kind="Close"
                                                                            Size="10" />
                                                                    </Button>
                                                                </TextBox.InnerRightContent>
                                                            </TextBox>
                                                            <ComboBox
                                                                Grid.Column="1"
                                                                Margin="0,0,4,0"
                                                                Padding="6,2"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                ItemsSource="{Binding ContentBrowser.SortModeLabels}"
                                                                SelectedIndex="{Binding ContentBrowser.SortModeIndex, Mode=TwoWay}"
                                                                ToolTip.Tip="Sort order" />
                                                            <Button
                                                                Grid.Column="2"
                                                                Padding="8,2"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding ContentBrowser.ImportCommand}"
                                                                Content="Import"
                                                                IsEnabled="{Binding !IsSimulating}"
                                                                ToolTip.Tip="Import external content into the asset registry." />
                                                            <Button
                                                                Grid.Column="3"
                                                                Padding="8,2"
                                                                VerticalAlignment="Center"
                                                                Content="New..."
                                                                IsEnabled="{Binding !IsSimulating}">
                                                                <Button.Flyout>
                                                                    <MenuFlyout>
                                                                        <MenuItem Command="{Binding ContentBrowser.NewPhysicsShapeCommand}" Header="Physics Shape" />
                                                                        <MenuItem Command="{Binding ContentBrowser.NewMaterialCommand}" Header="Material" />
                                                                        <MenuItem Command="{Binding ContentBrowser.NewWeaponCommand}" Header="Weapon" />
                                                                        <MenuItem Command="{Binding ContentBrowser.NewScriptCommand}" Header="Script" />
                                                                    </MenuFlyout>
                                                                </Button.Flyout>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <Grid ColumnDefinitions="220, *">
                                                        <ListBox
                                                            Grid.Column="0"
                                                            ItemsSource="{Binding ContentBrowser.Buckets}"
                                                            SelectedItem="{Binding ContentBrowser.CurrentBucket, Mode=TwoWay}">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:AssetBucketViewModel">
                                                                    <TextBlock Text="{Binding Name}" />
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <ListBox
                                                            x:Name="ContentBrowserAssetList"
                                                            Grid.Column="1"
                                                            ItemsSource="{Binding ContentBrowser.Assets}"
                                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                            SelectedItem="{Binding ContentBrowser.SelectedAsset, Mode=TwoWay}"
                                                            SelectionChanged="OnContentBrowserSelectionChanged">
                                                            <ListBox.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ListBox.ItemsPanel>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:AssetObjectViewModel">
                                                                    <Border
                                                                        Width="84"
                                                                        Height="84"
                                                                        Margin="3"
                                                                        Padding="4"
                                                                        Background="Transparent"
                                                                        CornerRadius="{DynamicResource Radius.Small}"
                                                                        ToolTip.Tip="{Binding DisplayName}">
                                                                        <!--  Fixed rows rather than a centred stack, so every tile puts its icon at the same height however long the name is.  -->
                                                                        <Grid RowDefinitions="*,Auto">
                                                                            <Panel Grid.Row="0">
                                                                                <controls:Codicon
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"
                                                                                    Foreground="{DynamicResource Brush.AccentHover}"
                                                                                    IsVisible="{Binding !HasThumbnail}"
                                                                                    Kind="{Binding IconKind}"
                                                                                    Opacity="0.85"
                                                                                    Size="34" />
                                                                                <Image
                                                                                    Width="56"
                                                                                    Height="56"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"
                                                                                    IsVisible="{Binding HasThumbnail}"
                                                                                    Source="{Binding Thumbnail}"
                                                                                    Stretch="Uniform" />
                                                                            </Panel>
                                                                            <TextBlock
                                                                                Grid.Row="1"
                                                                                MaxWidth="76"
                                                                                HorizontalAlignment="Center"
                                                                                FontSize="10"
                                                                                Text="{Binding DisplayName}"
                                                                                TextAlignment="Center"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                TextWrapping="NoWrap" />
                                                                        </Grid>
                                                                        <Border.ContextMenu>
                                                                            <ContextMenu Opened="OnAssetContextMenuOpened">
                                                                                <MenuItem
                                                                                    Command="{Binding ContentBrowser.AddToSceneCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Header="Add to Current Scene"
                                                                                    IsVisible="{Binding CanAddToScene, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                                <Separator IsVisible="{Binding CanAddToScene, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                                <MenuItem
                                                                                    Command="{Binding ContentBrowser.EditAssetCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Header="_Edit"
                                                                                    IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                                <Separator IsVisible="{Binding HasActions}" />
                                                                                <MenuItem
                                                                                    Header="Actions"
                                                                                    IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                    IsVisible="{Binding HasActions}"
                                                                                    ItemsSource="{Binding Actions}">
                                                                                    <!--  The generated containers are the menu items themselves; a MenuItem in an ItemTemplate would be nested inside the container's header and render disabled.  -->
                                                                                    <MenuItem.ItemContainerTheme>
                                                                                        <ControlTheme
                                                                                            x:DataType="vm:InspectorActionViewModel"
                                                                                            BasedOn="{StaticResource {x:Type MenuItem}}"
                                                                                            TargetType="MenuItem">
                                                                                            <Setter Property="Header" Value="{Binding Label}" />
                                                                                            <Setter Property="Command" Value="{Binding ExecuteActionCommand}" />
                                                                                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                                                                        </ControlTheme>
                                                                                    </MenuItem.ItemContainerTheme>
                                                                                </MenuItem>
                                                                                <Separator />
                                                                                <MenuItem
                                                                                    Command="{Binding ContentBrowser.DeleteAssetCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Header="_Delete"
                                                                                    IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                            </ContextMenu>
                                                                        </Border.ContextMenu>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="12"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Classes="muted"
                                                            IsHitTestVisible="False"
                                                            IsVisible="{Binding ContentBrowser.HasNoMatches}"
                                                            Text="No assets match the search." />
                                                    </Grid>
                                                </DockPanel>
                                            </ContentControl>
                                        </Tool>
                                    </ToolDock>

                                    <ProportionalDockSplitter x:Name="BottomSplitter" Id="BottomSplitter" />

                                    <ToolDock
                                        x:Name="ConsolePane"
                                        ActiveDockable="ConsoleTool"
                                        Alignment="Right"
                                        Id="ConsolePane">
                                        <Tool
                                            x:Name="ConsoleTool"
                                            Title="Console"
                                            Id="Console">
                                            <local:ConsoleView />
                                        </Tool>
                                    </ToolDock>

                                </ProportionalDock>

                            </ProportionalDock>

                            <ProportionalDockSplitter x:Name="DynamicPanelsSplitter" Id="DynamicPanelsSplitter" />

                            <!--  Right column: dynamic panels (object editors, etc.) - docked and tabbed, empty until opened  -->
                            <ToolDock
                                x:Name="DynamicPanelsPane"
                                Alignment="Right"
                                Id="DynamicPanelsPane"
                                Proportion="0.22" />

                        </ProportionalDock>

                    </RootDock>

                </DockControl>

                <!--  Status Bar  -->
                <Border Grid.Row="1" Classes="status-bar">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="status-hint"
                            Text="{Binding StatusText}"
                            TextTrimming="CharacterEllipsis" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                    <Border Classes="task-box">
                                        <StackPanel Spacing="3">
                                            <TextBlock Classes="task-title" Text="{Binding TaskName}" />
                                            <ProgressBar
                                                Width="80"
                                                Height="3"
                                                Maximum="1.0"
                                                Minimum="0"
                                                Value="{Binding Progress}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

        <!--  Foreground task overlay  -->
        <views:ForegroundTaskOverlay DataContext="{Binding ForegroundTask}" />
    </Grid>
</Window>
