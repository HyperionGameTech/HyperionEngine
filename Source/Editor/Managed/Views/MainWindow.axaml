<Window
    x:Class="Hyperion.Editor.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hyp="clr-namespace:Hyperion;assembly=Hyperion.Runtime"
    xmlns:inspector="clr-namespace:Hyperion.Editor.Views.Inspector;assembly=Hyperion.Editor"
    xmlns:local="clr-namespace:Hyperion.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Hyperion.Editor.Views;assembly=Hyperion.Editor"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:Name="Root"
    Title="Hyperion Editor"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    x:DataType="vm:MainWindowViewModel"
    mc:Ignorable="d">

    <Window.Styles>
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6,6,0,0">
                        <ContentPresenter
                            Margin="6,2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            Content="{TemplateBinding Header}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="TabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <!--  Selected tab: show a bottom border (highlight) and slightly different background  -->
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <!--  Make the tab strip minimal height so tabs don't look flat/tall  -->
        <Style Selector="TabStrip">
            <Setter Property="Margin" Value="6,0,6,0" />
        </Style>

        <Style Selector="RadioButton.gizmo">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource Radius.Small}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.gizmo:checked">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
        </Style>

        <Style Selector="RadioButton.gizmo:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.HoverBorder}" />
        </Style>

        <Style Selector="ToggleButton.gizmo">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource Radius.Small}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.gizmo:checked">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
        </Style>

        <Style Selector="ToggleButton.gizmo:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.HoverBorder}" />
        </Style>

        <Style Selector="Border.mode-strip">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <Style Selector="TextBlock.mode-label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>

        <Style Selector="TextBlock.mode-target">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="2,0,4,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        </Style>

        <Style Selector="Border.mode-separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="2,3" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
        </Style>

        <Style Selector="TextBlock.status-hint">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel Background="{DynamicResource Brush.Background}">
            <!--  Fallback in-window menu for non-macOS platforms  -->
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Command="{Binding NewProject}" Header="_New Project..." />
                    <MenuItem Command="{Binding OpenProject}" Header="_Open Project..." />
                    <Separator />
                    <MenuItem Command="{Binding SaveProject}" Header="_Save Project" />
                    <MenuItem Command="{Binding SaveProjectAs}" Header="Save Project _As..." />
                    <Separator />
                    <MenuItem Command="{Binding CloseProject}" Header="Close Project" />
                    <Separator />
                    <MenuItem Command="{Binding Exit}" Header="_Exit" />
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Command="{Binding Undo}" Header="{Binding UndoHeader}" IsEnabled="{Binding CanUndo}" />
                    <MenuItem Command="{Binding Redo}" Header="{Binding RedoHeader}" IsEnabled="{Binding CanRedo}" />
                    <Separator />
                    <MenuItem Command="{Binding Copy}" Header="{Binding CopyHeader}" IsEnabled="{Binding CanCopy}" />
                    <MenuItem Command="{Binding Paste}" Header="{Binding PasteHeader}" IsEnabled="{Binding CanPaste}" />
                    <MenuItem Command="{Binding Delete}" Header="{Binding DeleteHeader}" />
                    <Separator />
                    <MenuItem Command="{Binding SelectAll}" Header="Select _All" />
                    <MenuItem Header="Select All in Viewport" />
                    <MenuItem Header="Select None" />
                </MenuItem>
                <MenuItem Header="_Build">
                  <MenuItem Command="{Binding BuildReflectionProbes}" Header="Reflection Probes" />
                  <MenuItem Command="{Binding BuildIrradianceProbes}" Header="Irradiance Probes" />
                  <Separator />
                  <MenuItem Command="{Binding BuildLightmaps}" Header="Lightmaps" />
                  <Separator />
                  <MenuItem Command="{Binding BuildBentNormals}" Header="Bent Normals" />
                  <Separator />
                  <MenuItem Command="{Binding RebuildMeshBVHs}" Header="Rebuild Mesh BVHs" />
                  <Separator />
                  <MenuItem Command="{Binding CookGameContent}" Header="Cook Game Content" />
                </MenuItem>
            </Menu>

            <Border Classes="panel-header" DockPanel.Dock="Top" Padding="6,4">
                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button Command="{Binding OpenProject}" ToolTip.Tip="Open">
                            <LucideIcon Kind="FolderOpen" Size="16" />
                        </Button>
                        <Button Command="{Binding SaveProject}" ToolTip.Tip="Save">
                            <LucideIcon Kind="Save" Size="16" />
                        </Button>
                        <Button Command="{Binding Undo}" ToolTip.Tip="{Binding UndoHeader}" Margin="12,0,0,0" IsEnabled="{Binding CanUndo}">
                            <LucideIcon Kind="Undo2" Size="16" />
                        </Button>
                        <Button Command="{Binding Redo}" ToolTip.Tip="{Binding RedoHeader}" IsEnabled="{Binding CanRedo}">
                            <LucideIcon Kind="Redo2" Size="16" />
                        </Button>
                        <Button Command="{Binding Copy}" ToolTip.Tip="{Binding CopyHeader}" Margin="12,0,0,0" IsEnabled="{Binding CanCopy}">
                            <LucideIcon Kind="Copy" Size="16" />
                        </Button>
                        <Button Command="{Binding Paste}" ToolTip.Tip="{Binding PasteHeader}" IsEnabled="{Binding CanPaste}">
                            <LucideIcon Kind="ClipboardPaste" Size="16" />
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <ToggleButton
                            x:Name="TransformModeTranslate"
                            Classes="gizmo"
                            Command="{Binding SelectTransformModeTranslate}"
                            IsChecked="{Binding IsTransformModeTranslateActive, Mode=OneWay}"
                            IsEnabled="{Binding CanSelectTransformModeTranslate}"
                            ToolTip.Tip="Translate">
                            <LucideIcon Kind="Move" Size="16" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="TransformModeRotate"
                            Classes="gizmo"
                            Command="{Binding SelectTransformModeRotate}"
                            IsChecked="{Binding IsTransformModeRotateActive, Mode=OneWay}"
                            IsEnabled="{Binding CanSelectTransformModeRotate}"
                            ToolTip.Tip="Rotate">
                            <LucideIcon Kind="RotateCw" Size="16" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="TransformModeScale"
                            Classes="gizmo"
                            Command="{Binding SelectTransformModeScale}"
                            IsChecked="{Binding IsTransformModeScaleActive, Mode=OneWay}"
                            IsEnabled="{Binding CanSelectTransformModeScale}"
                            ToolTip.Tip="Scale">
                            <LucideIcon Kind="Maximize" Size="16" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="SnapToGridToggle"
                            Classes="gizmo"
                            Margin="12,0,0,0"
                            Command="{Binding ToggleSnapToGrid}"
                            IsChecked="{Binding IsSnapToGridEnabled, Mode=OneWay}"
                            ToolTip.Tip="Snap Movement To Grid (1 Unit)">
                            <LucideIcon Kind="Magnet" Size="16" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="MeshEditModeToggle"
                            Classes="gizmo"
                            Margin="12,0,0,0"
                            Command="{Binding ToggleMeshEditMode}"
                            IsChecked="{Binding IsMeshEditModeEnabled, Mode=OneWay}"
                            IsEnabled="{Binding CanEnableMeshEditMode}"
                            ToolTip.Tip="{Binding MeshEditModeTooltip}">
                            <LucideIcon Kind="Waypoints" Size="16" />
                        </ToggleButton>
                        <!-- <ToggleButton
                            x:Name="PhysicsDebugDrawToggle"
                            Classes="gizmo"
                            Command="{Binding TogglePhysicsDebugDraw}"
                            IsChecked="{Binding IsPhysicsDebugDrawEnabled, Mode=OneWay}"
                            ToolTip.Tip="Show Physics Collision Shapes">
                            <LucideIcon Kind="Box" Size="16" />
                        </ToggleButton> -->
                        <!-- <Button
                            x:Name="FitPhysicsShapeToMeshButton"
                            Classes="gizmo"
                            Command="{Binding FitPhysicsShapeToMesh}"
                            IsEnabled="{Binding CanFitPhysicsShapeToMesh}"
                            ToolTip.Tip="Fit Collision Shape To Mesh">
                        </Button> -->

                        <Border
                            Classes="mode-strip"
                            Margin="8,0,0,0"
                            IsVisible="{Binding IsMeshEditModeEnabled}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock
                                    Classes="mode-target"
                                    VerticalAlignment="Center"
                                    MaxWidth="160"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding MeshEditTargetName}"
                                    ToolTip.Tip="{Binding MeshEditTargetName}" />

                                <Border Classes="mode-separator" />

                                <ToggleButton
                                    x:Name="MeshEditFaceModeTriangle"
                                    Classes="gizmo"
                                    Command="{Binding SelectMeshEditFaceTriangle}"
                                    IsChecked="{Binding !IsMeshEditFaceModeQuad, Mode=OneWay}"
                                    ToolTip.Tip="Edit triangle faces">
                                    <LucideIcon Kind="TriangleRight" Size="16" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="MeshEditFaceModeQuad"
                                    Classes="gizmo"
                                    Command="{Binding SelectMeshEditFaceQuad}"
                                    IsChecked="{Binding IsMeshEditFaceModeQuad, Mode=OneWay}"
                                    ToolTip.Tip="Edit as quads">
                                    <LucideIcon Kind="Square" Size="16" />
                                </ToggleButton>

                                <Border Classes="mode-separator" />

                                <ToggleButton
                                    x:Name="MeshEditAlignToNormal"
                                    Classes="gizmo"
                                    Command="{Binding ToggleMeshEditAlignToNormal}"
                                    IsChecked="{Binding IsMeshEditAlignToNormal, Mode=OneWay}"
                                    ToolTip.Tip="Constrain movement to surface normal">
                                    <LucideIcon Kind="Axis3d" Size="16" />
                                </ToggleButton>

                                <Border Classes="mode-separator" />

                                <Button
                                    x:Name="SaveMeshEditsButton"
                                    Classes="gizmo"
                                    Command="{Binding SaveMeshEdits}"
                                    ToolTip.Tip="Save Edits">
                                    <LucideIcon Kind="Check" Size="16" />
                                </Button>
                                <Button
                                    x:Name="DiscardMeshEditsButton"
                                    Classes="gizmo"
                                    Command="{Binding DiscardMeshEdits}"
                                    IsEnabled="{Binding HasPendingMeshEdits}"
                                    ToolTip.Tip="Discard Edits">
                                    <LucideIcon Kind="X" Size="16" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            Command="{Binding SetGameModePlaying}"
                            IsVisible="{Binding CanSetGameModePlaying}"
                            ToolTip.Tip="Play">
                            <LucideIcon Kind="Play" Size="16" />
                        </Button>
                        <Button
                            Command="{Binding SetGameModePaused}"
                            IsVisible="{Binding CanSetGameModePaused}"
                            ToolTip.Tip="Pause">
                            <LucideIcon Kind="Pause" Size="16" />
                        </Button>
                        <Button
                            Command="{Binding SetGameModeStopped}"
                            IsVisible="{Binding CanSetGameModeStopped}"
                            ToolTip.Tip="Stop">
                            <LucideIcon Kind="Square" Size="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid RowDefinitions="Auto, Auto, *, Auto">
                <!--  Main Content Area  -->
                <Grid x:Name="MainContentGrid" Grid.Row="2" ColumnDefinitions="280, 2, *, 2, 320">

                    <!--  Left Panel: Scene Hierarchy + Actions (cond) + Inspector  -->
                    <Grid Grid.Column="0" RowDefinitions="*, Auto, *">
                        <!--  Scene Hierarchy  -->
                        <Grid Grid.Row="0" RowDefinitions="Auto, *">
                            <Border Grid.Row="0" Classes="panel-header">
                                <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                    <DropDownButton
                                        x:Name="SceneDropDown"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="header"
                                                Text="{Binding ActiveScene.Name, FallbackValue='No Active Scene'}" />
                                        </StackPanel>
                                        <DropDownButton.Flyout>
                                            <Flyout Placement="Bottom">
                                                <StackPanel MinWidth="150">
                                                    <ItemsControl ItemsSource="{Binding Scenes}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:SceneViewModel">
                                                                <MenuItem
                                                                    Command="{Binding DataContext.SetActiveSceneCommand, ElementName=Root}"
                                                                    CommandParameter="{Binding}"
                                                                    Header="{Binding Name}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Separator />
                                                    <MenuItem
                                                        Command="{Binding DataContext.AddNewSceneCommand, ElementName=Root}"
                                                        Header="Add New Scene..." />
                                                </StackPanel>
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                    <Button
                                        Grid.Column="1"
                                        Margin="0,0,4,0"
                                        Padding="8,2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Add new node to the active scene...">
                                        <LucideIcon Kind="Plus" Size="16" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem
                                                    Margin="0,2"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#808080"
                                                    Header="Node"
                                                    IsEnabled="False" />
                                                <MenuItem Command="{Binding AddEmptyNode}" Header="Base Node" />
                                                <Separator />
                                                <MenuItem Command="{Binding AddEntity}" Header="Entity" />
                                                <MenuItem Command="{Binding AddCamera}" Header="Camera" />
                                                <Separator />
                                                <MenuItem
                                                    Margin="0,2"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#808080"
                                                    Header="Rendering"
                                                    IsEnabled="False" />
                                                <MenuItem Command="{Binding AddInstance}" Header="Instanced Mesh" IsEnabled="{Binding CanAddInstance}" />
                                                <Separator />
                                                <MenuItem
                                                    Margin="0,2"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#808080"
                                                    Header="2D"
                                                    IsEnabled="False" />
                                                <MenuItem Command="{Binding AddSprite}" Header="Sprite" />
                                                <MenuItem Command="{Binding AddTextSprite}" Header="Text Sprite" />
                                                <Separator />
                                                <MenuItem
                                                    Margin="0,2"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#808080"
                                                    Header="Lighting"
                                                    IsEnabled="False" />
                                                <MenuItem Command="{Binding AddDirectionalLight}" Header="Directional Light" />
                                                <MenuItem Command="{Binding AddPointLight}" Header="Point Light" />
                                                <MenuItem Command="{Binding AddSpotLight}" Header="Spot Light" />
                                                <MenuItem Command="{Binding AddAreaRectLight}" Header="Rectangular Area Light" />
                                                <Separator />
                                                <MenuItem Command="{Binding AddReflectionProbe}" Header="Reflection Probe" /> <!-- Tooltip.Tip="Reflection probes capture static objects as a cubemap for reflections as well as spherical harmonics for indirect lighting." /> -->
                                                <MenuItem Command="{Binding AddIrradianceProbe}" Header="Irradiance Probe" />
                                                <MenuItem Command="{Binding AddLightmapVolume}" Header="Lightmap Volume" /> <!-- Tooltip.Tip="Lightmap Volumes bake lighting for static objects into an atlas texture. Dynamic objects do not receive light from lightmaps." /> -->
                                                <!--<MenuItem Command="{Binding AddProbeVolume}" Header="Probe Volume" />--> <!-- Tooltip.Tip="Irradiance Probe Volumes encase four irradiance probes which capture the scene lighting to be used as indirect lighting for static and dynamic objects." /> -->
                                                <Separator />
                                                <MenuItem
                                                    Margin="0,2"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#808080"
                                                    Header="FX"
                                                    IsEnabled="False" />
                                                <MenuItem Command="{Binding AddParticleVolume}" Header="Particle Volume" />
                                                <MenuItem Command="{Binding AddFogVolume}" Header="Fog Volume" />
                                                <!-- <Separator />
                                                <MenuItem
                                                    Margin="0,2"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#808080"
                                                    Header="Scripts"
                                                    IsEnabled="False" />
                                                <MenuItem Command="{Binding NewScript}" Header="Script" /> -->

                                                <Separator />
                                                <MenuItem
                                                    Margin="0,2"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#808080"
                                                    Header="Shapes"
                                                    IsEnabled="False" />

                                                <MenuItem Command="{Binding AddPlane}" Header="Plane" />
                                                <MenuItem Command="{Binding AddCube}" Header="Cube" />
                                                <MenuItem Command="{Binding AddNormalizedCubeSphereCommand}" Header="Normalized Cube Sphere" />
                                                <MenuItem Command="{Binding AddCylinder}" Header="Cylinder" />

                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </Border>
                            <TreeView
                                x:Name="SceneHierarchyTreeView"
                                Grid.Row="1"
                                ItemsSource="{Binding SceneHierarchy.RootNodes}"
                                SelectedItem="{Binding SceneHierarchy.SelectedNode}"
                                SelectionMode="Multiple">
                                <TreeView.ItemContainerTheme>
                                    <ControlTheme
                                        x:DataType="vm:NodeViewModel"
                                        BasedOn="{StaticResource {x:Type TreeViewItem}}"
                                        TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </ControlTheme>
                                </TreeView.ItemContainerTheme>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate x:DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
                                        <Grid Background="Transparent" HorizontalAlignment="Stretch">
                                            <!--  Drop-target highlight: sits behind the label, shown during drag-over  -->
                                            <Border
                                                Background="{DynamicResource Brush.Accent}"
                                                CornerRadius="3"
                                                IsVisible="{Binding IsDropTarget}"
                                                Opacity="0.35" />
                                            <StackPanel Margin="2,2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Accent}" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" />
                                                <LucideIcon Kind="{Binding IconKind}" Size="14" Opacity="0.7" VerticalAlignment="Center" />
                                                <TextBlock FontStyle="{Binding NameFontStyle}" IsVisible="{Binding !IsEditingName}" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                <!-- <TextBlock
                                                    FontSize="8"
                                                    Foreground="{DynamicResource Brush.TextMuted}"
                                                    IsVisible="{Binding !IsEditingName}"
                                                    Text="{Binding ClassName}"
                                                    VerticalAlignment="Center" /> -->
                                                <TextBox
                                                    Name="NodeRenameTextBox"
                                                    MinWidth="80"
                                                    Padding="2,0"
                                                    IsVisible="{Binding IsEditingName}"
                                                    Text="{Binding EditingName, Mode=TwoWay}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Grid.ContextMenu>
                                                <ContextMenu Opened="OnNodeContextMenuOpened">
                                                    <MenuItem Command="{Binding DataContext.Copy, ElementName=Root}" Header="{Binding DataContext.CopyHeader, ElementName=Root}" />
                                                    <MenuItem Command="{Binding DataContext.Paste, ElementName=Root}" Header="{Binding DataContext.PasteHeader, ElementName=Root}" />
                                                    <Separator />
                                                    <MenuItem Click="OnRenameNodeMenuItemClick" Header="Rename" />
                                                    <MenuItem Command="{Binding DataContext.TeleportToNode, ElementName=Root}" CommandParameter="{Binding Name}" Header="Teleport to" />
                                                    <Separator IsVisible="{Binding HasActions}" />
                                                    <MenuItem Header="Actions" IsVisible="{Binding HasActions}" ItemsSource="{Binding Actions}">
                                                        <MenuItem.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:InspectorActionViewModel">
                                                                <MenuItem Command="{Binding ExecuteActionCommand}" Header="{Binding Label}" IsEnabled="{Binding IsEnabled}" />
                                                            </DataTemplate>
                                                        </MenuItem.ItemTemplate>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Command="{Binding DataContext.DeleteNode, ElementName=Root}" Header="{Binding DataContext.DeleteHeader, ElementName=Root}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                        </Grid>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>

                        <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

                        <Grid Grid.Row="2" RowDefinitions="Auto, *">
                            <!--  Inspector  -->
                            <Grid Grid.Row="1" RowDefinitions="Auto, *">
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="8">
                                        <Grid
                                            Margin="0"
                                            DataContext="{Binding Inspector}"
                                            IsVisible="{Binding IsEntity}"
                                            RowDefinitions="Auto, Auto, Auto">

                                            <Border Grid.Row="0" Classes="panel-header">
                                                <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Classes="header"
                                                        Text="Components" />

                                                    <Button
                                                        Grid.Column="1"
                                                        Margin="0,0,4,0"
                                                        Padding="8,2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Content="Add"
                                                        IsEnabled="{Binding HasAddableComponents}">
                                                        <Button.Flyout>
                                                            <MenuFlyout ItemsSource="{Binding AddableComponents}">
                                                                <MenuFlyout.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:AddComponentOptionViewModel">
                                                                        <MenuItem
                                                                            Command="{Binding DataContext.Inspector.AddComponentCommand, ElementName=Root}"
                                                                            CommandParameter="{Binding}"
                                                                            Header="{Binding Label}"
                                                                            IsEnabled="{Binding IsEnabled}" />
                                                                    </DataTemplate>
                                                                </MenuFlyout.ItemTemplate>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <ItemsControl
                                                Grid.Row="1"
                                                Margin="12,6"
                                                IsVisible="{Binding HasComponents}"
                                                ItemsSource="{Binding Components}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:InspectorComponentViewModelBase">
                                                        <Border
                                                            Margin="0,0,0,6"
                                                            Padding="10"
                                                            Background="{DynamicResource Brush.PanelRaised}"
                                                            BorderBrush="{DynamicResource Brush.BorderLight}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource Radius.Medium}">
                                                            <StackPanel Spacing="6">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Text="{Binding Label}" />
                                                                    <Button
                                                                        Grid.Column="1"
                                                                        Padding="4,2"
                                                                        ToolTip.Tip="Remove component"
                                                                        Command="{Binding DataContext.Inspector.RemoveComponentCommand, ElementName=Root}"
                                                                        CommandParameter="{Binding}">
                                                                        <LucideIcon Kind="Trash2" Size="14" />
                                                                    </Button>
                                                                </Grid>

                                                                <!--  Component-level scalar properties  -->
                                                                <inspector:InspectorPropertyItemsControl
                                                                    IsVisible="{Binding HasProperties}"
                                                                    ItemsSource="{Binding Properties}" />

                                                                <!--  Sub-object groups (Mesh, Material, etc.)  -->
                                                                <ItemsControl
                                                                    IsVisible="{Binding HasSubObjects}"
                                                                    ItemsSource="{Binding SubObjects}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:ComponentSubObjectViewModel">
                                                                            <StackPanel Margin="0,4,0,0" Spacing="2">
                                                                                <TextBlock FontWeight="SemiBold" Margin="0,2,0,2" Text="{Binding Label}" />
                                                                                <inspector:InspectorPropertyItemsControl
                                                                                    IsVisible="{Binding HasProperties}"
                                                                                    ItemsSource="{Binding Properties}" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <Grid
                                            Margin="0"
                                            IsVisible="{Binding Inspector.HasAttachedScript}"
                                            RowDefinitions="Auto, Auto">
                                            <Border Grid.Row="0" Classes="panel-header">
                                                <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Classes="header"
                                                        Text="Script" />
                                                </Grid>
                                            </Border>

                                            <Grid
                                                Grid.Row="1"
                                                DataContext="{Binding Inspector.AttachedScript}"
                                                ColumnDefinitions="72,*"
                                                Margin="12,6,12,4">
                                                <Border
                                                    Width="64"
                                                    Height="64"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource Brush.PanelRaised}"
                                                    BorderBrush="{DynamicResource Brush.BorderLight}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource Radius.Medium}">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="22"
                                                        Opacity="0.3"
                                                        Text="☐" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding ScriptDisplay}" />

                                                    <Border
                                                        Background="{DynamicResource Brush.PanelRaised}"
                                                        BorderBrush="{DynamicResource Brush.BorderLight}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource Radius.Small}"
                                                        Padding="6,5">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Text="{Binding AssetPathDisplay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Border>

                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Button
                                                            Padding="8,2"
                                                            FontSize="11"
                                                            Command="{Binding SelectCommand}"
                                                            Content="Swap"
                                                            IsEnabled="{Binding CanSelectFromContentBrowser}"
                                                            ToolTip.Tip="Assign to the currently selected asset in the Assets drawer" />
                                                        <Button
                                                            Padding="8,2"
                                                            FontSize="11"
                                                            Command="{Binding ClearCommand}"
                                                            Content="Clear"
                                                            IsEnabled="{Binding HasScript}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <Grid
                                            Margin="0"
                                            IsVisible="{Binding Inspector.HasActions}"
                                            RowDefinitions="Auto, Auto">
                                            <Border Grid.Row="0" Classes="panel-header">
                                                <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Classes="header"
                                                        Text="Actions" />
                                                </Grid>
                                            </Border>

                                            <ItemsControl
                                                Grid.Row="1"
                                                VerticalAlignment="Top"
                                                ItemsSource="{Binding Inspector.Actions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:InspectorActionViewModel">
                                                        <Button
                                                            Padding="10,4"
                                                            Margin="12,6,12,0"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding ExecuteActionCommand}"
                                                            Content="{Binding Label}"
                                                            IsEnabled="{Binding IsEnabled}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <!--  Scene Properties (shown when root node is selected)  -->
                                        <Grid
                                            Margin="0"
                                            IsVisible="{Binding Inspector.HasSceneProperties}"
                                            RowDefinitions="Auto, Auto">
                                            <Border Grid.Row="0" Classes="panel-header">
                                                <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                                    <TextBlock Classes="header" Text="Scene Properties" />
                                                </Grid>
                                            </Border>
                                            <inspector:InspectorPropertyItemsControl
                                                Grid.Row="1"
                                                ItemsSource="{Binding Inspector.SceneProperties}" />
                                        </Grid>

                                        <!--  Properties  -->
                                        <Grid Margin="0" RowDefinitions="Auto, Auto, Auto">
                                            <Border Grid.Row="0" Classes="panel-header">
                                                <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                                    <TextBlock Classes="header" Text="Properties" />
                                                </Grid>
                                            </Border>
                                            <inspector:InspectorPropertyItemsControl
                                                Grid.Row="1"
                                                ItemsSource="{Binding Inspector.Properties}" />
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>

                    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                    <Grid Grid.Column="2" RowDefinitions="*, 2, 240">
                        <Border
                            x:Name="ViewportDropTarget"
                            Grid.Row="0"
                            Background="{DynamicResource Brush.Background}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0">
                            <Grid>
                                <local:EditorViewportControl
                                    Name="EditorViewportControl"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

                        <Grid x:Name="BottomPanelGrid" Grid.Row="2" ColumnDefinitions="*, 2, *">
                                <Grid Grid.Column="0">
                                    <DockPanel x:Name="ContentBrowserPanel">
                                        <Border Classes="panel-header" DockPanel.Dock="Top" Height="36">
                                            <Grid VerticalAlignment="Center" ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                                                <Button
                                                    x:Name="CollapseContentBrowser"
                                                    Grid.Column="0"
                                                    Width="26" Height="26" Padding="0"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="Collapse">
                                                    <LucideIcon Kind="ChevronsLeft" Size="14" />
                                                </Button>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="6,0"
                                                    VerticalAlignment="Center"
                                                    Classes="header"
                                                    FontSize="12"
                                                    Text="Assets" />
                                                <ComboBox
                                                    Grid.Column="2"
                                                    Margin="0,0,4,0"
                                                    Padding="6,2"
                                                    FontSize="11"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="Sort order"
                                                    ItemsSource="{Binding ContentBrowser.SortModeLabels}"
                                                    SelectedIndex="{Binding ContentBrowser.SortModeIndex, Mode=TwoWay}" />
                                                <Button
                                                    Grid.Column="3"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding ContentBrowser.ImportCommand}"
                                                    Content="Import"
                                                    ToolTip.Tip="Import external content into the asset registry." />
                                                <Button
                                                    Grid.Column="4"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    Content="New...">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuItem Command="{Binding ContentBrowser.NewPhysicsShapeCommand}" Header="Physics Shape..." />
                                                            <MenuItem Command="{Binding ContentBrowser.NewMaterialCommand}" Header="Material" />
                                                            <MenuItem Command="{Binding ContentBrowser.NewScriptCommand}" Header="Script..." />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <Grid ColumnDefinitions="220, *">
                                            <ListBox
                                                Grid.Column="0"
                                                ItemsSource="{Binding ContentBrowser.Buckets}"
                                                SelectedItem="{Binding ContentBrowser.CurrentBucket, Mode=TwoWay}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AssetBucketViewModel">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <ListBox
                                                x:Name="ContentBrowserAssetList"
                                                Grid.Column="1"
                                                ItemsSource="{Binding ContentBrowser.Assets}"
                                                SelectedItem="{Binding ContentBrowser.SelectedAsset, Mode=TwoWay}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AssetObjectViewModel">
                                                        <Border
                                                            Width="80"
                                                            Height="80"
                                                            Margin="4"
                                                            Padding="4"
                                                            Background="Transparent"
                                                            CornerRadius="{DynamicResource Radius.Small}">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                                                <LucideIcon Kind="{Binding IconKind}" Size="28" Opacity="0.85" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.AccentHover}" />
                                                                <TextBlock
                                                                    Text="{Binding DisplayName}"
                                                                    FontSize="10"
                                                                    HorizontalAlignment="Center"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="Wrap"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    MaxWidth="72" />
                                                            </StackPanel>
                                                            <Border.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem
                                                                        Command="{Binding DataContext.ContentBrowser.EditAssetCommand, ElementName=Root}"
                                                                        CommandParameter="{Binding}"
                                                                        Header="_Edit" />
                                                                    <Separator />
                                                                    <MenuItem
                                                                        Command="{Binding DataContext.ContentBrowser.DeleteAssetCommand, ElementName=Root}"
                                                                        CommandParameter="{Binding}"
                                                                        Header="_Delete" />
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </DockPanel>

                                    <Border
                                        x:Name="ContentBrowserCollapsedStrip"
                                        IsVisible="False"
                                        Background="{DynamicResource Brush.PanelAlt}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="0,0,1,0">
                                        <Button
                                            x:Name="ExpandContentBrowser"
                                            Width="26" Height="26" Padding="0"
                                            Margin="0,4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            ToolTip.Tip="Expand">
                                            <LucideIcon Kind="ChevronsRight" Size="14" />
                                        </Button>
                                    </Border>
                                </Grid>

                                <GridSplitter x:Name="BottomPanelSplitter" Grid.Column="1" ResizeDirection="Columns" />

                                <!--  Console slot  -->
                                <Grid Grid.Column="2">
                                    <DockPanel x:Name="ConsolePanel">
                                        <Border Classes="panel-header" DockPanel.Dock="Top" Height="36">
                                            <Grid VerticalAlignment="Center" ColumnDefinitions="*, Auto">
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Classes="header"
                                                    FontSize="12"
                                                    Text="Console" />
                                                <Button
                                                    x:Name="CollapseConsole"
                                                    Grid.Column="1"
                                                    Width="26" Height="26" Padding="0"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="Collapse">
                                                    <LucideIcon Kind="ChevronsRight" Size="14" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <local:ConsoleView />
                                    </DockPanel>

                                    <!--  Console collapsed strip  -->
                                    <Border
                                        x:Name="ConsoleCollapsedStrip"
                                        IsVisible="False"
                                        Background="{DynamicResource Brush.PanelAlt}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1,0,0,0">
                                        <Button
                                            x:Name="ExpandConsole"
                                            Width="26" Height="26" Padding="0"
                                            Margin="0,4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            ToolTip.Tip="Expand">
                                            <LucideIcon Kind="ChevronsLeft" Size="14" />
                                        </Button>
                                    </Border>
                                </Grid>
                            </Grid>
                    </Grid>

                    <!--  Right panel host (dynamic editor panels)  -->
                    <GridSplitter x:Name="RightPanelSplitter" Grid.Column="3" ResizeDirection="Columns" />

                    <Grid Grid.Column="4">
                        <DockPanel x:Name="RightPanelHost">
                            <Border Classes="panel-header" DockPanel.Dock="Top" Height="36">
                                <Grid VerticalAlignment="Center" ColumnDefinitions="*, Auto, Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="6,0"
                                        VerticalAlignment="Center"
                                        Classes="header"
                                        FontSize="12"
                                        Text="{Binding ActivePanel.Title}" />
                                    <Button
                                        Grid.Column="2"
                                        Width="26" Height="26" Padding="0"
                                        VerticalAlignment="Center"
                                        Command="{Binding ClosePanelCommand}"
                                        ToolTip.Tip="Close">
                                        <LucideIcon Kind="X" Size="14" />
                                    </Button>
                                </Grid>
                            </Border>
                            <ContentControl Content="{Binding ActivePanel}" />
                        </DockPanel>

                        <Border
                            x:Name="RightPanelCollapsedStrip"
                            IsVisible="False"
                            Background="{DynamicResource Brush.PanelAlt}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1,0,0,0">
                            <Button
                                x:Name="ExpandRightPanel"
                                Width="26" Height="26" Padding="0"
                                Margin="0,4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                ToolTip.Tip="Expand">
                                <LucideIcon Kind="ChevronsLeft" Size="14" />
                            </Button>
                        </Border>
                    </Grid>

                </Grid>

                <!--  Status Bar  -->
                <Border Grid.Row="3" Classes="status-bar">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock
                            Classes="status-hint"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Text="{Binding StatusText}" />
                        <ItemsControl
                            Grid.Column="1"
                            ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                    <Border Classes="task-box">
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                Classes="task-title"
                                                Text="{Binding TaskName}" />
                                            <ProgressBar
                                                Width="80"
                                                Height="3"
                                                Maximum="1.0"
                                                Minimum="0"
                                                Value="{Binding Progress}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

        <!--  Foreground task overlay  -->
        <views:ForegroundTaskOverlay DataContext="{Binding ForegroundTask}" />
    </Grid>
</Window>
