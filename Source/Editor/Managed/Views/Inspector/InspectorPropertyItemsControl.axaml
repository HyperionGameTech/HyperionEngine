<UserControl
    x:Class="Hyperion.Editor.Views.Inspector.InspectorPropertyItemsControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Hyperion.Editor.Views.Inspector;assembly=Hyperion.Editor"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:Name="Root">
    <UserControl.Resources>
        <!--  Inline description, shown only when the host opts in via ShowDescriptions (otherwise it's just the label tooltip)  -->
        <DataTemplate x:Key="PropertyDescriptionTemplate" x:DataType="vm:InspectorPropertyViewModelBase">
            <Panel IsVisible="{Binding $parent[local:InspectorPropertyItemsControl].ShowDescriptions}">
                <TextBlock
                    Classes="inspector-description"
                    IsVisible="{Binding HasDescription}"
                    Text="{Binding Description}" />
            </Panel>
        </DataTemplate>
    </UserControl.Resources>
    <ItemsControl
        HorizontalAlignment="Stretch"
        Grid.IsSharedSizeScope="True"
        ItemsSource="{Binding #Root.ItemsSource}">
        <ItemsControl.DataTemplates>
            <DataTemplate x:DataType="vm:TextPropertyViewModel">
                <local:StringNamePropertyEditor DataContext="{Binding}" />
            </DataTemplate>
            <DataTemplate x:DataType="vm:EnumPropertyViewModel">
                <local:EnumPropertyEditor DataContext="{Binding}" />
            </DataTemplate>
            <DataTemplate x:DataType="vm:FlagsPropertyViewModel">
                <local:EnumFlagsPropertyEditor DataContext="{Binding}" />
            </DataTemplate>
            <DataTemplate x:DataType="vm:MobilityPropertyViewModel">
                <local:MobilityPropertyEditor DataContext="{Binding}" />
            </DataTemplate>
            <DataTemplate x:DataType="vm:Vec2fViewModel">
                <Grid ColumnDefinitions="*,*">
                    <TextBox Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" HorizontalAlignment="Stretch" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:DataType="vm:Vec3fViewModel">
                <Grid ColumnDefinitions="*,*,*">
                    <TextBox Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" HorizontalAlignment="Stretch" Text="{Binding Z, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:DataType="vm:Vec4fViewModel">
                <Grid ColumnDefinitions="*,*,*,*">
                    <TextBox Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding Z, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="3" HorizontalAlignment="Stretch" Text="{Binding W, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:DataType="vm:Vec2iViewModel">
                <Grid ColumnDefinitions="*,*">
                    <TextBox Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" HorizontalAlignment="Stretch" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:DataType="vm:Vec3iViewModel">
                <Grid ColumnDefinitions="*,*,*">
                    <TextBox Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" HorizontalAlignment="Stretch" Text="{Binding Z, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:DataType="vm:Vec4iViewModel">
                <Grid ColumnDefinitions="*,*,*,*">
                    <TextBox Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding Z, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="3" HorizontalAlignment="Stretch" Text="{Binding W, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:DataType="vm:Vec2uViewModel">
                <Grid ColumnDefinitions="*,*">
                    <TextBox Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" HorizontalAlignment="Stretch" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:DataType="vm:Vec3uViewModel">
                <Grid ColumnDefinitions="*,*,*">
                    <TextBox Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" HorizontalAlignment="Stretch" Text="{Binding Z, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:DataType="vm:Vec4uViewModel">
                <Grid ColumnDefinitions="*,*,*,*">
                    <TextBox Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" Margin="0,0,4,0" HorizontalAlignment="Stretch" Text="{Binding Z, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="3" HorizontalAlignment="Stretch" Text="{Binding W, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
            </DataTemplate>
            <DataTemplate x:DataType="vm:TransformViewModel">
                <StackPanel Spacing="4">
                    <!--  The row's own marker and revert button come from the outer item template  -->
                    <StackPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="Translation" />
                        <ContentControl Content="{Binding Translation}" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="Rotation" />
                        <ContentControl Content="{Binding Rotation}" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="Scale" />
                        <ContentControl Content="{Binding Scale}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:BoolPropertyViewModel">
                <StackPanel Orientation="Horizontal" Margin="4,0" Spacing="6">
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock
                        Classes="inspector-name"
                        Text="{Binding Label}"
                        ToolTip.Tip="{Binding LabelTooltip}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:NumericPropertyViewModel">
                <TextBox MinWidth="60" HorizontalAlignment="Stretch" Text="{Binding EditableValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>
            <DataTemplate x:DataType="vm:ObjectPropertyViewModel">
                <StackPanel Spacing="0">
                    <local:AssetObjectPropertyEditor IsVisible="{Binding IsAssetObject}" />
                    <StackPanel IsVisible="{Binding !IsAssetObject}" Margin="0,2,0,0" Spacing="0">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" Margin="4,0,0,2" ToolTip.Tip="{Binding LabelTooltip}" />
                        <ContentControl Margin="4,0,0,2" Content="{Binding}" ContentTemplate="{StaticResource PropertyDescriptionTemplate}" />
                        <local:SubclassPropertyEditor IsVisible="{Binding ShowSubclassPicker}" />
                        <local:InspectorPropertyItemsControl IsVisible="{Binding HasSubObject}" ItemsSource="{Binding SubObject.Properties}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:BoundingBoxPropertyViewModel">
                <Expander Margin="0,1,0,1" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="inspector-name" Text="{Binding Label}" ToolTip.Tip="{Binding LabelTooltip}" />
                                    <TextBlock Opacity="0.55" Text="{Binding Value}" />
                                </StackPanel>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PropertyDescriptionTemplate}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Classes="reset-icon"
                                ToolTip.Tip="Reset to empty"
                                Command="{Binding ResetCommand}">
                                <Path
                                    Width="11"
                                    Height="11"
                                    Stretch="Uniform"
                                    Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" />
                            </Button>
                        </Grid>
                    </Expander.Header>
                    <local:InspectorPropertyItemsControl IsVisible="{Binding HasSubProperties}" ItemsSource="{Binding SubProperties}" />
                </Expander>
            </DataTemplate>
            <DataTemplate x:DataType="vm:MaterialTexturesPropertyViewModel">
                <Expander Margin="0,1,0,1" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="inspector-name" Text="{Binding Label}" ToolTip.Tip="{Binding LabelTooltip}" />
                                <TextBlock Opacity="0.55" Text="{Binding Value}" />
                            </StackPanel>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PropertyDescriptionTemplate}" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl IsVisible="{Binding HasSlots}" ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MaterialTextureSlotViewModel">
                                <StackPanel Margin="0,1,0,1" Orientation="Vertical" Spacing="0">
                                    <local:InspectorPropertyItemsControl ItemsSource="{Binding TextureEditorItems}" />
                                    <local:InspectorPropertyItemsControl
                                        Margin="16,0,0,0"
                                        IsVisible="{Binding HasInlineControl}"
                                        ItemsSource="{Binding InlineControlItems}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </DataTemplate>
            <DataTemplate x:DataType="vm:ShaderPropertySetViewModel">
                <Expander Margin="0,1,0,1" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="inspector-name" Text="{Binding Label}" ToolTip.Tip="{Binding LabelTooltip}" />
                                <TextBlock Opacity="0.55" Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PropertyDescriptionTemplate}" />
                        </StackPanel>
                    </Expander.Header>
                    <local:ShaderPropertySetEditor DataContext="{Binding}" />
                </Expander>
            </DataTemplate>
            <DataTemplate x:DataType="vm:BlendFunctionPropertyViewModel">
                <Expander Margin="0,1,0,1" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="inspector-name" Text="{Binding Label}" ToolTip.Tip="{Binding LabelTooltip}" />
                                <TextBlock Opacity="0.55" Text="{Binding Value}" />
                            </StackPanel>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PropertyDescriptionTemplate}" />
                        </StackPanel>
                    </Expander.Header>
                    <local:BlendFunctionPropertyEditor DataContext="{Binding}" />
                </Expander>
            </DataTemplate>
            <DataTemplate x:DataType="vm:StructPropertyViewModel">
                <Expander Margin="0,1,0,1" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="inspector-name" Text="{Binding Label}" ToolTip.Tip="{Binding LabelTooltip}" />
                                <TextBlock Opacity="0.55" Text="{Binding Value}" />
                            </StackPanel>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PropertyDescriptionTemplate}" />
                        </StackPanel>
                    </Expander.Header>
                    <local:InspectorPropertyItemsControl IsVisible="{Binding HasSubProperties}" ItemsSource="{Binding SubProperties}" />
                </Expander>
            </DataTemplate>
            <DataTemplate x:DataType="vm:ArrayPropertyViewModel">
                <Expander Margin="0,1,0,1" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="inspector-name" Text="{Binding Label}" ToolTip.Tip="{Binding LabelTooltip}" />
                                <TextBlock Opacity="0.55" Text="{Binding Value}" />
                            </StackPanel>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PropertyDescriptionTemplate}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="2">
                        <ItemsControl ItemsSource="{Binding Elements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True" Margin="0,1,0,1">
                                        <Button
                                            DockPanel.Dock="Right"
                                            Padding="4,1"
                                            FontSize="10"
                                            Content="✕"
                                            IsVisible="{ReflectionBinding DataContext.CanRemoveElement, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Command="{ReflectionBinding DataContext.RemoveElementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{ReflectionBinding}" />
                                        <ContentControl Content="{Binding}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button
                            HorizontalAlignment="Left"
                            Margin="4,2,0,0"
                            Padding="8,2"
                            FontSize="11"
                            Content="Add"
                            IsVisible="{Binding CanAddElement}"
                            Command="{Binding AddElementCommand}" />
                    </StackPanel>
                </Expander>
            </DataTemplate>
            <DataTemplate x:DataType="vm:ReadOnlyPropertyViewModel">
                <TextBlock VerticalAlignment="Center" Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
        </ItemsControl.DataTemplates>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InspectorPropertyViewModelBase">
                <Grid Margin="6,2" RowDefinitions="Auto,Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PropertyLabel" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Override marker: accent for the active layer, muted when only other layers override  -->
                    <Panel
                        Grid.Column="0"
                        Grid.RowSpan="2"
                        Width="6"
                        Background="Transparent"
                        ToolTip.Tip="{Binding OverrideTooltip}">
                        <Border
                            Width="2"
                            Margin="0,1"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Accent}"
                            CornerRadius="1"
                            IsVisible="{Binding IsOverriddenByCurrentSwatch}" />
                        <Border
                            Width="2"
                            Margin="0,1"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.TextFaint}"
                            CornerRadius="1"
                            IsVisible="{Binding IsOverriddenByOtherSwatchOnly}" />
                    </Panel>

                    <TextBlock
                        Grid.Column="1"
                        MaxWidth="110"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Classes="inspector-name"
                        IsVisible="{Binding ShowInlineLabel}"
                        Text="{Binding Label}"
                        ToolTip.Tip="{Binding LabelTooltip}" />

                    <ContentControl
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        IsVisible="{Binding !ShowInlineLabel}"
                        VerticalAlignment="Center"
                        Content="{Binding}" />
                    <DockPanel
                        Grid.Column="2"
                        IsVisible="{Binding ShowInlineLabel}"
                        VerticalAlignment="Center"
                        LastChildFill="True">
                        <Button
                            DockPanel.Dock="Right"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Classes="reset-icon"
                            IsVisible="{Binding IsOverriddenByCurrentSwatch}"
                            ToolTip.Tip="Revert to base value (drops the override for the current swatch)"
                            Command="{Binding RevertOverrideCommand}">
                            <Path
                                Width="11"
                                Height="11"
                                Stretch="Uniform"
                                Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" />
                        </Button>
                        <ContentControl Content="{Binding}" />
                    </DockPanel>

                    <ContentControl
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        IsVisible="{Binding ShowDescriptionBelowRow}"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource PropertyDescriptionTemplate}" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
