<UserControl
    x:Class="Hyperion.Editor.Views.Inspector.AnimationPreviewEditor"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:DataType="vm:AnimationPreviewViewModel"
    mc:Ignorable="d">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
        <Button
            Grid.Column="0"
            MinWidth="56"
            Margin="0,0,6,0"
            Command="{Binding TogglePlayCommand}"
            Content="{Binding PlayButtonText}" />
        <Slider
            Grid.Column="1"
            VerticalAlignment="Center"
            Maximum="{Binding Length}"
            Minimum="0"
            Value="{Binding Time, Mode=TwoWay}" />
        <TextBlock
            Grid.Column="2"
            Margin="6,0,0,0"
            VerticalAlignment="Center"
            Text="{Binding TimeText}" />
        <Button
            Grid.Column="3"
            Margin="6,0,0,0"
            Command="{Binding EditCommand}"
            Content="Edit" />
    </Grid>
</UserControl>
