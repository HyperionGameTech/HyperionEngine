<UserControl
    x:Class="Hyperion.Editor.Views.Inspector.AssetObjectPropertyEditor"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:DataType="vm:ObjectPropertyViewModel"
    mc:Ignorable="d">
    <Grid ColumnDefinitions="72,*" Margin="2,2,2,4">
        <Border
            Width="64"
            Height="64"
            Margin="0,0,8,0"
            VerticalAlignment="Top"
            Background="{DynamicResource Brush.PanelRaised}"
            BorderBrush="{DynamicResource Brush.BorderLight}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Medium}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Opacity="0.3"
                Text="" /> <!-- TODO preview or icon fallback. -->
        </Border>

        <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Text="{Binding Label}" />

            <Border Classes="picker-box">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <AutoCompleteBox
                        x:Name="PART_PickerBox"
                        MinWidth="120"
                        MinimumPrefixLength="0"
                        MinimumPopulateDelay="0:0:0.15"
                        Watermark="(None)"
                        FontSize="11"
                        Text="{Binding PickerFilter, Mode=TwoWay}"
                        ToolTip.Tip="Filter assets by name">
                        <AutoCompleteBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AssetPickerItemViewModel">
                                <StackPanel Margin="2,1" Spacing="0">
                                    <TextBlock FontSize="11" Text="{Binding DisplayName}" />
                                    <TextBlock
                                        FontSize="9"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        Text="{Binding TypeName}" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>

                    <Border Grid.Column="1" Classes="picker-divider" />

                    <Button
                        x:Name="PART_PickerToggle"
                        Grid.Column="2"
                        Classes="picker-toggle"
                        ToolTip.Tip="Browse..."
                        Content="&#x25BC;" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    Padding="8,2"
                    FontSize="11"
                    Command="{Binding SelectCommand}"
                    Content="Swap"
                    IsEnabled="{Binding CanSelectFromContentBrowser}"
                    ToolTip.Tip="Assign to the currently selected asset in the Assets drawer" />
                <Button
                    Padding="8,2"
                    FontSize="11"
                    Command="{Binding ClearCommand}"
                    Content="Clear" />
                <Button
                    x:Name="PART_EditButton"
                    Padding="8,2"
                    FontSize="11"
                    Content="Edit"
                    IsEnabled="{Binding HasSubObject}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
