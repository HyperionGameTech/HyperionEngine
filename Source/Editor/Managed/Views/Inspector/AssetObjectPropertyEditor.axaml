<UserControl
    x:Class="Hyperion.Editor.Views.Inspector.AssetObjectPropertyEditor"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Hyperion.Editor.Controls;assembly=Hyperion.Editor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:DataType="vm:ObjectPropertyViewModel"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Button.asset-tile">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="True"
                        CornerRadius="{DynamicResource Radius.Medium}">
                        <ContentPresenter
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.asset-tile:not(:disabled)">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.asset-tile:not(:disabled):pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
        </Style>

        <Style Selector="Button.asset-tile:not(:disabled):pressed">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="56,*" Margin="2,2,2,4">
        <Button
            x:Name="PART_IconTile"
            Margin="0,0,8,0"
            VerticalAlignment="Top"
            Classes="asset-tile"
            IsEnabled="{Binding HasSubObject}"
            ToolTip.Tip="Edit this object...">
            <Panel>
                <controls:Codicon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.AccentHover}"
                    IsVisible="{Binding !HasThumbnail}"
                    Kind="{Binding IconKind}"
                    Opacity="0.85"
                    Size="18" />
                <Image
                    IsVisible="{Binding HasThumbnail}"
                    Source="{Binding Thumbnail}"
                    Stretch="UniformToFill" />
            </Panel>
        </Button>

        <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Text="{Binding Label}" />

            <Border Classes="picker-box">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <AutoCompleteBox
                        x:Name="PART_PickerBox"
                        MinWidth="120"
                        MinimumPrefixLength="0"
                        MinimumPopulateDelay="0:0:0.15"
                        PlaceholderText="(None)"
                        FontSize="11"
                        Text="{Binding PickerFilter, Mode=TwoWay}"
                        ToolTip.Tip="Filter assets by name">
                        <AutoCompleteBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AssetPickerItemViewModel">
                                <StackPanel Margin="2,1" Spacing="0">
                                    <TextBlock FontSize="11" Text="{Binding DisplayName}" />
                                    <TextBlock
                                        FontSize="9"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        Text="{Binding TypeName}" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>

                    <Border Grid.Column="1" Classes="picker-divider" />

                    <Button
                        x:Name="PART_PickerToggle"
                        Grid.Column="2"
                        Classes="picker-toggle"
                        ToolTip.Tip="Browse..."
                        Content="&#x25BC;" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                    <Button
                        Classes="gizmo"
                        Command="{Binding SelectCommand}"
                        IsEnabled="{Binding CanSelectFromContentBrowser}"
                        ToolTip.Tip="Swap with selected">
                        <controls:Codicon Kind="Swap" Size="14" />
                    </Button>
                    <Button
                        Classes="gizmo"
                        Command="{Binding ClearCommand}"
                        IsEnabled="{Binding !IsReadOnly}"
                        ToolTip.Tip="Clear">
                        <controls:Codicon Kind="Close" Size="14" />
                    </Button>
                    <Button
                        Classes="gizmo"
                        Command="{Binding ImportCommand}"
                        IsEnabled="{Binding CanImport}"
                        ToolTip.Tip="Import from file...">
                        <controls:Codicon Kind="Import" Size="14" />
                    </Button>
                    <ToggleButton
                        Classes="gizmo"
                        IsChecked="{Binding IsEditorExpanded, Mode=TwoWay}"
                        IsVisible="{Binding HasSubObject}"
                        ToolTip.Tip="Edit this object...">
                        <controls:Codicon Kind="Edit" Size="14" />
                    </ToggleButton>
                </StackPanel>

                <Button
                    x:Name="PART_MoreButton"
                    Grid.Column="1"
                    Classes="gizmo"
                    ToolTip.Tip="More actions">
                    <controls:Codicon Kind="KebabVertical" Size="14" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem
                                Command="{Binding NewCommand}"
                                Header="Create New..."
                                IsEnabled="{Binding CanCreateNew}">
                                <MenuItem.Icon>
                                    <controls:Codicon Kind="Add" Size="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding CloneCommand}"
                                Header="Clone and Assign"
                                IsEnabled="{Binding CanClone}"
                                IsVisible="{Binding HasSubObject}">
                                <MenuItem.Icon>
                                    <controls:Codicon Kind="Copy" Size="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="PART_CopyMenuItem" Header="Copy Asset Path">
                                <MenuItem.Icon>
                                    <controls:Codicon Kind="Copy" Size="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="PART_PasteMenuItem" Header="Paste Asset Path">
                                <MenuItem.Icon>
                                    <controls:Codicon Kind="Clippy" Size="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
