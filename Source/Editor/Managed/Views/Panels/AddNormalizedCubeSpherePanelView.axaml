<UserControl
    x:Class="Hyperion.Editor.Views.Panels.AddNormalizedCubeSpherePanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:DataType="vm:AddNormalizedCubeSpherePanelViewModel"
    mc:Ignorable="d">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.PanelAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Padding="20,6" Classes="Primary" Command="{Binding ConfirmCommand}" Content="Create" />
                <Button Padding="20,6" Command="{Binding CancelCommand}" Content="Cancel" />
            </StackPanel>
        </Border>

        <ScrollViewer Padding="4,0" Offset="{Binding ScrollOffset, Mode=TwoWay}">
            <StackPanel Margin="12,12,12,8" Spacing="12">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="Divisions" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider
                            Grid.Column="0"
                            Minimum="{Binding MinDivisionsValue}"
                            Maximum="{Binding MaxDivisionsValue}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding NumDivisions, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            MinWidth="24"
                            VerticalAlignment="Center"
                            Text="{Binding NumDivisions}" />
                    </Grid>
                    <TextBlock
                        FontSize="10"
                        Opacity="0.6"
                        TextWrapping="Wrap"
                        Text="Number of subdivisions per cube face - use higher values for a smoother sphere at the cost of a higher vertex count." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
