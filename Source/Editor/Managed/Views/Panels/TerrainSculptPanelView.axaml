<UserControl
    x:Class="Hyperion.Editor.Views.Panels.TerrainSculptPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:DataType="vm:TerrainSculptPanelViewModel"
    mc:Ignorable="d">
    <ScrollViewer Padding="4,0" Offset="{Binding ScrollOffset, Mode=TwoWay}">
        <StackPanel Margin="12,12,12,8" Spacing="12">

            <StackPanel Spacing="6">
                <TextBlock Classes="section-label" Text="Tool" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ToggleButton
                        IsChecked="{Binding IsRaiseMode, Mode=OneWay}"
                        Command="{Binding SetRaiseModeCommand}"
                        ToolTip.Tip="Raise terrain (hold Shift to lower)">
                        <TextBlock Text="Raise" Margin="8,0" />
                    </ToggleButton>
                    <ToggleButton
                        IsChecked="{Binding IsLowerMode, Mode=OneWay}"
                        Command="{Binding SetLowerModeCommand}"
                        ToolTip.Tip="Lower terrain (hold Shift to raise)">
                        <TextBlock Text="Lower" Margin="8,0" />
                    </ToggleButton>
                    <ToggleButton
                        IsChecked="{Binding IsProceduralMode, Mode=OneWay}"
                        Command="{Binding SetProceduralModeCommand}"
                        ToolTip.Tip="Mark cells for procedural terrain on a flat or heightmap terrain (hold Shift to unmark)">
                        <TextBlock Text="Procedural" Margin="8,0" />
                    </ToggleButton>
                </StackPanel>
                <TextBlock
                    Classes="hint-text"
                    Text="Invert direction: Hold Shift" />
            </StackPanel>

            <Separator />

            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="section-label" Text="Radius" />
                    <TextBlock Grid.Column="1" Classes="hint-text" Text="{Binding RadiusText}" />
                </Grid>
                <Slider
                    Maximum="25"
                    Minimum="0.5"
                    Value="{Binding Radius}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="section-label" Text="Strength" />
                    <TextBlock Grid.Column="1" Classes="hint-text" Text="{Binding StrengthText}" />
                </Grid>
                <Slider
                    Maximum="10"
                    Minimum="0.05"
                    Value="{Binding Strength}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
