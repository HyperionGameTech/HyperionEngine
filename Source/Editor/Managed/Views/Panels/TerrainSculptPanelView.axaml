<UserControl
    x:Class="Hyperion.Editor.Views.Panels.TerrainSculptPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:DataType="vm:TerrainSculptPanelViewModel"
    mc:Ignorable="d">
    <ScrollViewer Padding="4,0" Offset="{Binding ScrollOffset, Mode=TwoWay}">
        <StackPanel Margin="12,12,12,8" Spacing="14">

            <StackPanel Spacing="6">
                <TextBlock Classes="section-label" Text="Mode" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <RadioButton Classes="tool-mode" Content="Raise" IsChecked="{Binding IsRaiseMode, Mode=TwoWay}" />
                    <RadioButton Grid.Column="1" Classes="tool-mode" Content="Lower" IsChecked="{Binding IsLowerMode, Mode=TwoWay}" />
                    <RadioButton Grid.Column="2" Classes="tool-mode" Content="Flatten" IsChecked="{Binding IsFlattenMode, Mode=TwoWay}" />
                    <RadioButton Grid.Row="1" Classes="tool-mode" Content="Smooth" IsChecked="{Binding IsSmoothMode, Mode=TwoWay}" />
                    <RadioButton
                        Grid.Row="1"
                        Grid.Column="1"
                        Classes="tool-mode"
                        Content="Ramp"
                        IsChecked="{Binding IsRampMode, Mode=TwoWay}"
                        ToolTip.Tip="Drag a ramp between two points" />
                    <RadioButton
                        Grid.Row="1"
                        Grid.Column="2"
                        Classes="tool-mode"
                        Content="Procedural"
                        IsChecked="{Binding IsProceduralMode, Mode=TwoWay}"
                        ToolTip.Tip="Mark cells for procedural terrain generation" />
                </Grid>
            </StackPanel>

            <Separator />

            <StackPanel Spacing="6">
                <TextBlock Classes="section-label" Text="Brush" />

                <Grid Classes="setting-row" ColumnDefinitions="96,*,64">
                    <TextBlock Text="Radius" />
                    <Slider Grid.Column="1" Maximum="100" Minimum="0.5" Value="{Binding Radius}" />
                    <NumericUpDown Grid.Column="2" Classes="setting-box" Increment="0.5" Minimum="0.5" Value="{Binding Radius}" />
                </Grid>

                <Grid Classes="setting-row" ColumnDefinitions="96,*,64">
                    <TextBlock Text="Strength" />
                    <Slider Grid.Column="1" Maximum="10" Minimum="0.05" Value="{Binding Strength}" />
                    <NumericUpDown Grid.Column="2" Classes="setting-box" Increment="0.1" Minimum="0.05" Value="{Binding Strength}" />
                </Grid>

                <Grid Classes="setting-row" ColumnDefinitions="96,*,64" IsVisible="{Binding HasFalloff}" ToolTip.Tip="Fraction of the radius that blends into the surrounding terrain">
                    <TextBlock Text="Falloff" />
                    <Slider Grid.Column="1" Maximum="1" Minimum="0" Value="{Binding Falloff}" />
                    <NumericUpDown Grid.Column="2" Classes="setting-box" Increment="0.05" Maximum="1" Minimum="0" Value="{Binding Falloff}" />
                </Grid>
            </StackPanel>

            <TextBlock Classes="hint-text" Text="Apply: Drag LMB&#x0a;Invert: Shift+Drag LMB" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
