<UserControl
    x:Class="Hyperion.Editor.Views.Panels.TerrainSculptPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:DataType="vm:TerrainSculptPanelViewModel"
    mc:Ignorable="d">
    <ScrollViewer Padding="4,0" Offset="{Binding ScrollOffset, Mode=TwoWay}">
        <StackPanel Margin="12,12,12,8" Spacing="12">

            <StackPanel Spacing="6">
                <TextBlock Classes="section-label" Text="Tool" />
                <WrapPanel>
                    <ToggleButton
                        Margin="0,0,6,6"
                        IsChecked="{Binding IsRaiseMode, Mode=OneWay}"
                        Command="{Binding SetRaiseModeCommand}">
                        <TextBlock Text="Raise" Margin="8,0" />
                    </ToggleButton>
                    <ToggleButton
                        Margin="0,0,6,6"
                        IsChecked="{Binding IsLowerMode, Mode=OneWay}"
                        Command="{Binding SetLowerModeCommand}">
                        <TextBlock Text="Lower" Margin="8,0" />
                    </ToggleButton>
                    <ToggleButton
                        Margin="0,0,6,6"
                        IsChecked="{Binding IsFlattenMode, Mode=OneWay}"
                        Command="{Binding SetFlattenModeCommand}">
                        <TextBlock Text="Flatten" Margin="8,0" />
                    </ToggleButton>
                    <ToggleButton
                        Margin="0,0,6,6"
                        IsChecked="{Binding IsSmoothMode, Mode=OneWay}"
                        Command="{Binding SetSmoothModeCommand}">
                        <TextBlock Text="Smooth" Margin="8,0" />
                    </ToggleButton>
                    <ToggleButton
                        Margin="0,0,6,6"
                        IsChecked="{Binding IsRampMode, Mode=OneWay}"
                        Command="{Binding SetRampModeCommand}"
                        ToolTip.Tip="Drag ramp between points">
                        <TextBlock Text="Ramp" Margin="8,0" />
                    </ToggleButton>
                    <ToggleButton
                        Margin="0,0,6,6"
                        IsChecked="{Binding IsProceduralMode, Mode=OneWay}"
                        Command="{Binding SetProceduralModeCommand}"
                        ToolTip.Tip="Mark cells for procedural terrain generation. (hold Shift to unmark)">
                        <TextBlock Text="Procedural" Margin="8,0" />
                    </ToggleButton>
                </WrapPanel>
            </StackPanel>

            <Separator />

            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="section-label" Text="Radius" />
                    <TextBlock Grid.Column="1" Classes="hint-text" Text="{Binding RadiusText}" />
                </Grid>
                <Slider
                    Maximum="100"
                    Minimum="0.5"
                    Value="{Binding Radius}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="section-label" Text="Strength" />
                    <TextBlock Grid.Column="1" Classes="hint-text" Text="{Binding StrengthText}" />
                </Grid>
                <Slider
                    Maximum="10"
                    Minimum="0.05"
                    Value="{Binding Strength}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasFalloff}" Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="section-label" Text="Falloff" />
                    <TextBlock Grid.Column="1" Classes="hint-text" Text="{Binding FalloffText}" />
                </Grid>
                <Slider
                    Maximum="1"
                    Minimum="0"
                    Value="{Binding Falloff}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
