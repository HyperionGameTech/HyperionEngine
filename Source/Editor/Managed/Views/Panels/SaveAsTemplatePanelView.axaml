<UserControl
    x:Class="Hyperion.Editor.Views.Panels.SaveAsTemplatePanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:DataType="vm:SaveAsTemplatePanelViewModel"
    mc:Ignorable="d">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.PanelAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Padding="20,6" Classes="Primary" Command="{Binding ConfirmCommand}" Content="Save" IsEnabled="{Binding IsNameValid}" />
                <Button Padding="20,6" Command="{Binding CancelCommand}" Content="Cancel" />
            </StackPanel>
        </Border>

        <ScrollViewer Padding="4,0" Offset="{Binding ScrollOffset, Mode=TwoWay}">
            <StackPanel Margin="12,12,12,8" Spacing="12">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="Name" />
                    <TextBox Text="{Binding TemplateName, Mode=TwoWay}" PlaceholderText="Template name" />
                    <TextBlock
                        Classes="muted"
                        FontSize="11"
                        IsVisible="{Binding !IsNameValid}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Classes="muted"
                        FontSize="11"
                        IsVisible="{Binding ReplacesExistingTemplate}"
                        Text="A template with this name already exists - ensure you want to overwrite it before saving"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
