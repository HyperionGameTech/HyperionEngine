<UserControl
    x:Class="Hyperion.Editor.Views.Panels.AddNewScenePanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:DataType="vm:AddNewScenePanelViewModel"
    mc:Ignorable="d">
    <DockPanel>
        <Border
            DockPanel.Dock="Bottom"
            Background="{DynamicResource Brush.PanelAlt}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0"
            Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button
                    Padding="20,6"
                    Classes="Primary"
                    Command="{Binding ConfirmCommand}"
                    Content="Create" />

                <Button
                    Padding="20,6"
                    Command="{Binding CancelCommand}"
                    Content="Cancel" />
            </StackPanel>
        </Border>

        <ScrollViewer Padding="4,0">
            <StackPanel Margin="12,12,12,8" Spacing="12">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="Scene Name" />
                    <TextBox
                        Text="{Binding SceneName, Mode=TwoWay}"
                        Watermark="Enter scene name..." />
                </StackPanel>

                <Separator />

                <TextBlock Classes="section-label" Text="Scene Flags" />

                <ItemsControl ItemsSource="{Binding FlagEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FlagsPropertyViewModel+EnumFlagEntry">
                            <CheckBox
                                Margin="0,2,0,2"
                                Content="{Binding Title}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
