<Window
    x:Class="Hyperion.Editor.Views.SplashWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hyperion Editor"
    Icon="/Assets/Branding/hyperion-icon.ico"
    Width="560"
    Height="320"
    CanResize="False"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource Brush.Background}">

    <Border BorderBrush="{DynamicResource Brush.BorderLight}" BorderThickness="1">
        <Grid RowDefinitions="*,Auto">
            <Image
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderOptions.BitmapInterpolationMode="HighQuality"
                Source="/Assets/Branding/hyperion_light.png"
                Stretch="Uniform" />

            <TextBlock
                x:Name="StatusText"
                Grid.Row="1"
                Margin="16,0,16,14"
                FontSize="11"
                Foreground="{DynamicResource Brush.TextMuted}" />
        </Grid>
    </Border>
</Window>
